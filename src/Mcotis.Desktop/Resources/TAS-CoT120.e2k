  LOADPATTERN "DEAD"  TYPE  "Dead"  SELFWEIGHT  1
  LOADPATTERN "DEAD_above"  TYPE  "Superimposed Dead"  SELFWEIGHT  0
  LOADPATTERN "LL_above"  TYPE  "Live"  SELFWEIGHT  0
  LOADPATTERN "LL_left"  TYPE  "Live"  SELFWEIGHT  0
  LOADPATTERN "LL_right"  TYPE  "Live"  SELFWEIGHT  0
