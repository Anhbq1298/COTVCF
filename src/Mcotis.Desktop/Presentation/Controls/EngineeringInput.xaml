<UserControl x:Class="Mcotis.Desktop.Presentation.Controls.EngineeringInput" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="220" HorizontalAlignment="Left">
 <StackPanel Margin="0,0,0,6">
  <TextBlock Text="{Binding Label, ElementName=Root}" Margin="0,0,0,2">
   <TextBlock.Style>
    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
     <Style.Triggers>
      <DataTrigger Binding="{Binding Label, ElementName=Root}" Value="">
       <Setter Property="Visibility" Value="Collapsed"/><Setter Property="Margin" Value="0"/>
      </DataTrigger>
     </Style.Triggers>
    </Style>
   </TextBlock.Style>
  </TextBlock>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto" MinWidth="14"/></Grid.ColumnDefinitions>
   <TextBox x:Name="Editor" Height="24" MinHeight="24" Padding="6,1" FontFamily="{StaticResource MonoFont}" FontSize="12" TextAlignment="Right" AutomationProperties.Name="{Binding Label, ElementName=Root}"/>
   <TextBlock Grid.Column="1" Text="{Binding Unit, ElementName=Root}" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
  </Grid>
  <TextBlock Style="{StaticResource Caption}" Foreground="{StaticResource Error}" TextWrapping="Wrap" Text="{Binding ElementName=Editor, Path=(Validation.Errors)[0].ErrorContent}"/>
 </StackPanel>
</UserControl>
