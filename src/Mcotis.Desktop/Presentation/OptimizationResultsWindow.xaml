<Window x:Class="Mcotis.Desktop.Presentation.OptimizationResultsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Mcotis.Desktop.Presentation"
        Title="{Binding OptimizationTitle, StringFormat={}{0} Results, FallbackValue=Optimization Results}" Icon="{x:Static p:AppIcon.Window}" Width="1320" Height="760" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Optimization VCF / TAS → Run Optimization. Run: every analysed case with the values of the varying inputs, its deflection
      check and cost (sort by any column). Chart: the parametric study of the run — numbered figures of how each response follows
      each parameter, the sensitivity ranking, the cost / utilisation trade-off — and a summary of the findings. -->
 <DockPanel Margin="10">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <Button x:Name="CancelRunButton" DockPanel.Dock="Right" Content="Cancel Run" MinWidth="96" Margin="8,0,0,0" Click="CancelRun_Click"
           IsEnabled="{Binding IsVcfOptimizationRunning}"/>
   <ProgressBar DockPanel.Dock="Right" Width="180" Height="10" Value="{Binding VcfOptimizationPercent, Mode=OneWay}" Margin="8,0,0,0" VerticalAlignment="Center"/>
   <TextBlock Text="{Binding VcfOptimizationProgress}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <TabControl x:Name="ResultTabs" Background="{StaticResource Surface}" AutomationProperties.Name="Optimization result sheets">
   <TabControl.Resources>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Height" Value="26"/><Setter Property="Width" Value="NaN"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="14,0"/></Style>
   </TabControl.Resources>
   <TabItem Header="Run">
    <DockPanel Margin="0,6,0,0">
     <TextBlock DockPanel.Dock="Bottom" Text="{Binding VcfOptimizationBest}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
     <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{Binding OptimizationResultsNote}"/>
     <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding VcfOptimizationRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
               HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Optimization results"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="Member Utilization">
    <DockPanel Margin="0,6,0,0">
     <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <ComboBox x:Name="MemberRoleBox" DockPanel.Dock="Right" Width="170" SelectionChanged="MemberRole_Changed" AutomationProperties.Name="Member role filter"
                ToolTip="Show only the members of one role (mega column, bottom chord …)"/>
      <TextBlock Text="Role" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,6,0"/>
      <ComboBox x:Name="MemberStatusBox" DockPanel.Dock="Right" Width="120" SelectedIndex="0" SelectionChanged="MemberRole_Changed" AutomationProperties.Name="Member pass or fail filter"
                ToolTip="Show all members, only those that pass, only those that fail (utilization above 1, a failed detailing rule or an error), or only those not checked">
       <ComboBoxItem Content="All members"/><ComboBoxItem Content="Pass"/><ComboBoxItem Content="Fail"/><ComboBoxItem Content="Not checked"/>
      </ComboBox>
      <TextBlock Text="Status" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,6,0"/>
      <TextBlock Text="Case" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <ComboBox x:Name="MemberCaseBox" Width="90" DisplayMemberPath="Case" SelectionChanged="MemberCase_Changed" AutomationProperties.Name="Case of the member utilization"/>
      <TextBlock x:Name="MemberSummary" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                Text="Cables: largest tension of the solved results / design capacity (area × cable strength × φ, Run → Cable settings); Suggested cable is the number and type of stay units Design → Tension Cable Design chooses for that tension at the cable's length (its system, screening level and rates; indicative cost, not a supplier price). Columns (RC, CFT, steel encased, mega composite): the Design engine with the Design window's code, method and factors on the ULS results (all solved results when none is named ULS); the effective length l0 of the Sections tab of the study (10 m unless changed). Other frames have no design engine and are listed as not designed."/>
     <DataGrid x:Name="MemberGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
               AutomationProperties.Name="Member utilization"/>
    </DockPanel>
   </TabItem>
   <TabItem Header="Chart">
    <ScrollViewer x:Name="ChartScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{StaticResource Raised}">
     <StackPanel x:Name="ChartPage" Margin="18,14,18,18" AutomationProperties.Name="Optimization charts"/>
    </ScrollViewer>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
