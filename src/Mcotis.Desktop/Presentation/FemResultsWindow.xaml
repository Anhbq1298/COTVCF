<Window x:Class="Mcotis.Desktop.Presentation.FemResultsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" xmlns:c="clr-namespace:Mcotis.Desktop.Presentation.Controls" Title="Results Table" Icon="{x:Static p:AppIcon.Window}" Width="1100" Height="650" MinWidth="650" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Background}">
 <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                         <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="LOAD CASE / COMBO" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FemResultNames}" SelectedItem="{Binding SelectedFemResultName}"
                                          IsEnabled="{Binding IsIdle}" AutomationProperties.Name="FEM load case or combination"
                                          ToolTip="Load case or linear-additive combination shown in the table, the viewer and the Cable Target Fit Result column."/>
                                <Button Grid.Column="2" Content="Export…" MinWidth="84" Margin="8,0,0,0" Click="Export_Click" AutomationProperties.Name="Export results"
                                        ToolTip="Export the figures and tables of the results — this summary, the member and cable forces, quantities and design utilization — to Word or PDF"/>
                         </Grid>
  <Grid Grid.Row="1" Margin="0,2,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Peak absolute forces over every member and station of each group in the load case / combo shown; the columns may govern at different places. Vertical Chord includes the middle chords; end frames are not listed. Main Cable (External) is Cable1a/1b, Internal Cable every other cable. — = not applicable."
                Style="{StaticResource Caption}" Margin="0,0,0,6" TextWrapping="Wrap"/>
     <DataGrid Grid.Row="1" ItemsSource="{Binding FemMemberSummaryRows}" IsReadOnly="True"
               AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Summary of member forces"
               FontFamily="Arial Narrow, Arial" FontSize="13" RowHeight="NaN" MinRowHeight="76">
      <DataGrid.Resources>
       <Style x:Key="SummaryNumber" TargetType="TextBlock" BasedOn="{StaticResource NumericCell}">
        <Setter Property="FontFamily" Value="Arial Narrow, Arial"/>
        <Setter Property="FontSize" Value="13"/>
       </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Member" Binding="{Binding Member}" Width="1.2*" MinWidth="120">
        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,0"/></Style></DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Bending (kN·m)" Binding="{Binding BendingKNmText}" Width="*" MinWidth="96" ElementStyle="{StaticResource SummaryNumber}"/>
       <DataGridTextColumn Header="Shear (kN)" Binding="{Binding ShearKNText}" Width="*" MinWidth="86" ElementStyle="{StaticResource SummaryNumber}"/>
       <DataGridTextColumn Header="Axial (kN)" Binding="{Binding AxialKNText}" Width="*" MinWidth="86" ElementStyle="{StaticResource SummaryNumber}"/>
       <DataGridTextColumn Header="Member size" Binding="{Binding MemberSize}" Width="2.2*" MinWidth="200">
        <DataGridTextColumn.ElementStyle>
         <Style TargetType="TextBlock">
          <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="4,2"/>
          <Setter Property="ToolTip" Value="{Binding SectionNames}"/>
         </Style>
        </DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
       <DataGridTemplateColumn Header="Section" Width="Auto" MinWidth="120">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <ItemsControl ItemsSource="{Binding Sections}" Margin="2" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <c:SectionFigureView Figure="{Binding Figure}" Width="104" Height="68" Margin="4" ToolTip="{Binding Name}"/>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
 </Grid>
</Window>
