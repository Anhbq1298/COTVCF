<Window x:Class="Mcotis.Desktop.Presentation.CableSectionOptimizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Mcotis.Desktop.Presentation"
        Title="Cable / Tendon Section Optimisation" Icon="{x:Static p:AppIcon.Window}"
        Width="1060" Height="720" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <Window.Resources>
  <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
   <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
   <Setter Property="TextAlignment" Value="Right"/>
   <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  </Style>
  <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="MinWidth" Value="92"/>
   <Setter Property="Margin" Value="6,0,0,0"/>
  </Style>
  <Style x:Key="NumericCell" TargetType="TextBlock">
   <Setter Property="TextAlignment" Value="Right"/>
   <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Margin" Value="2,0"/>
  </Style>
 </Window.Resources>

 <Grid Margin="12">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <Border Grid.Row="0" Padding="10,8" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,8">
   <StackPanel>
    <TextBlock Text="OPTIMISATION SETTINGS" Style="{StaticResource Subheading}" Margin="0,0,0,8"/>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="Target UR" Style="{StaticResource SettingLabel}"/>
      <TextBox x:Name="TargetUrBox" Text="0.90" TextChanged="OptimizationSetting_Changed" Style="{StaticResource NumberBox}" AutomationProperties.Name="Target UR"
               ToolTip="Maximum suggested utilisation ratio for each tendon group."/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Breaking Stress (MPa)" Style="{StaticResource SettingLabel}"/>
      <TextBox x:Name="BreakingStressBox" Text="2160" TextChanged="OptimizationSetting_Changed" Style="{StaticResource NumberBox}" AutomationProperties.Name="Breaking Stress MPa"
               ToolTip="Breaking stress used to calculate the nominal capacity of one 15.7 mm strand."/>
     </StackPanel>
     <StackPanel Grid.Column="4">
      <TextBlock Text="Preliminary Coefficient" Style="{StaticResource SettingLabel}"/>
      <TextBox x:Name="PreliminaryCoefficientBox" Text="0.50" TextChanged="OptimizationSetting_Changed" Style="{StaticResource NumberBox}" AutomationProperties.Name="Preliminary Coefficient"
               ToolTip="Multiplier applied to one strand's breaking capacity before calculating utilisation."/>
     </StackPanel>
    </Grid>
    <Grid Margin="0,8,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="12"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Grid.Column="0">
      <TextBlock Text="Maximum Iterations" Style="{StaticResource SettingLabel}"/>
      <TextBox x:Name="MaximumIterationsBox" Text="30" TextChanged="OptimizationSetting_Changed" Style="{StaticResource NumberBox}" AutomationProperties.Name="Maximum Iterations"
               ToolTip="Analysis passes, from 1 to 50. At least two passes are needed to evaluate convergence."/>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Convergence Tolerance (%)" Style="{StaticResource SettingLabel}"/>
      <TextBox x:Name="ConvergenceToleranceBox" Text="1.00" TextChanged="OptimizationSetting_Changed" Style="{StaticResource NumberBox}" AutomationProperties.Name="Convergence Tolerance Percent"
               ToolTip="The maximum permitted relative change in cable force and pretension-stage joint deflection."/>
     </StackPanel>
     <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
      <Button x:Name="CancelIterationButton" Content="Cancel Iteration" Style="{StaticResource FooterButton}" Visibility="Collapsed"
              Click="CancelIteration_Click" AutomationProperties.Name="Cancel Iteration"/>
      <Button x:Name="IterateButton" Content="Iterate" Style="{StaticResource FooterButton}" MinWidth="100" IsDefault="True"
              Click="Iterate_Click" AutomationProperties.Name="Iterate" ToolTip="Analyse successive strand-count candidates until both convergence checks pass or the iteration limit is reached."/>
     </StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Error}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
   </StackPanel>
  </Border>

  <Grid Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Grid.Row="0" Text="TENDON OPTIMISATION RESULTS" Style="{StaticResource Subheading}" Margin="0,1,0,6"/>
   <DataGrid x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{Binding Rows}" IsReadOnly="True" SelectionMode="Single"
             SelectionChanged="ResultsGrid_SelectionChanged" AutomationProperties.Name="Tendon Optimisation Results">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Tendon Name" Binding="{Binding TendonName}" Width="1.2*" MinWidth="110"/>
     <DataGridTextColumn Header="Current Strands" Binding="{Binding CurrentStrands, StringFormat={}{0} × 15.7 mm}" Width="1.25*" MinWidth="132"/>
     <DataGridTextColumn Header="Suggested Strands" Binding="{Binding SuggestedStrands, StringFormat={}{0} × 15.7 mm}" Width="1.35*" MinWidth="145"/>
     <DataGridTextColumn Header="Current UR" Binding="{Binding CurrentUr, StringFormat=F2}" Width=".8*" MinWidth="76" ElementStyle="{StaticResource NumericCell}"/>
     <DataGridTextColumn Header="Suggested UR" Binding="{Binding SuggestedUr, StringFormat=F2}" Width=".9*" MinWidth="90" ElementStyle="{StaticResource NumericCell}"/>
     <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*" MinWidth="105"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border Grid.Row="2" Margin="0,6,0,0" Padding="7,5" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1">
    <TextBlock x:Name="SelectedDetailsText" Text="Target Force and Calculated Force are available here when a tendon row is selected."
               FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
   </Border>
  </Grid>

  <Grid Grid.Row="2" Margin="0,8,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
   <Expander x:Name="HistoryExpander" Grid.Column="0" Header="Iteration History" IsExpanded="False" VerticalAlignment="Bottom">
    <DataGrid x:Name="HistoryGrid" MaxHeight="170" IsReadOnly="True" SelectionMode="Single" AutoGenerateColumns="False"
              AutomationProperties.Name="Cable Section Optimisation Iteration History">
     <DataGrid.Columns>
      <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="40"/>
      <DataGridTextColumn Header="Force Change (%)" Binding="{Binding MaximumForceChangePercent, StringFormat=F2}" Width="105" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Governing Force" Binding="{Binding GoverningForce}" Width="1*"/>
      <DataGridTextColumn Header="Deflection Change (%)" Binding="{Binding MaximumDeflectionChangePercent, StringFormat=F2}" Width="120" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Governing Joint" Binding="{Binding GoverningDeflection}" Width="1*"/>
      <DataGridTextColumn Header="Adjustment" Binding="{Binding Adjustment}" Width="170"/>
     </DataGrid.Columns>
    </DataGrid>
   </Expander>
   <StackPanel Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
    <TextBlock x:Name="SummaryText" Text="Iteration: 0 / 30  ·  Maximum Force Change: —  ·  Pretension Deflection Change: —  ·  Not run"
               FontFamily="{StaticResource MonoFont}" FontSize="10" TextWrapping="Wrap" TextAlignment="Right" Margin="0,0,0,7" AutomationProperties.Name="Iteration Summary"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Close" Style="{StaticResource FooterButton}" IsCancel="True" Click="Close_Click"/>
     <Button x:Name="ApplyButton" Content="Apply Suggested Tendon" Style="{StaticResource FooterButton}" MinWidth="185"
             Click="Apply_Click" AutomationProperties.Name="Apply Suggested Tendon"
             ToolTipService.ShowOnDisabled="True"
             ToolTip="Apply the suggested section counts as one undoable edit. Unconverged results require confirmation."/>
    </StackPanel>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
