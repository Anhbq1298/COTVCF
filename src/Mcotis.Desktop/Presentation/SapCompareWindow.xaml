<Window x:Class="Mcotis.Desktop.Presentation.SapCompareWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" Title="Compare with SAP2000" Icon="{x:Static p:AppIcon.Window}"
 Width="1080" Height="560" MinWidth="760" MinHeight="360" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Optimization → Compare with SAP2000: the member force table of Export Results, every force column split into Mcotis and
      SAP2000. SAP2000 is only read: the model open there, analysed, whose members are named as Export to SAP2000 named them. -->
 <DockPanel Margin="10">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <Button x:Name="WordButton" DockPanel.Dock="Right" Content="Export to Word" MinWidth="104" Margin="8,0,0,0" IsEnabled="False" Click="Word_Click"/>
   <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" MinWidth="80" Margin="8,0,0,0" IsEnabled="False" Click="Copy_Click"/>
   <Button x:Name="CompareButton" DockPanel.Dock="Right" Content="Compare" MinWidth="96" Margin="8,0,0,0" IsDefault="True" Click="Compare_Click"/>
   <TextBlock Text="Load case / combination" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox x:Name="CaseBox" MinWidth="220" HorizontalAlignment="Left" AutomationProperties.Name="Load case"/>
  </DockPanel>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" Style="{StaticResource Hint}"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
   <Grid x:Name="TableGrid" HorizontalAlignment="Left" AutomationProperties.Name="Member force comparison"/>
  </ScrollViewer>
 </DockPanel>
</Window>
