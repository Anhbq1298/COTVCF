<Window x:Class="Mcotis.Desktop.Presentation.DefineMaterialsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Mcotis.Desktop.Presentation"
        Title="Define Materials" Icon="{x:Static p:AppIcon.Window}" Width="600" Height="440" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Define → Materials (as SAP2000's Define Materials). Changes are staged until OK; Cancel discards. -->
 <Window.Resources>
  <Style TargetType="GroupBox">
   <Setter Property="Padding" Value="8,6,8,8"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="Background" Value="{StaticResource Raised}"/>
  </Style>
  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Width" Value="220"/></Style>
 </Window.Resources>
 <Grid Margin="10">
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <GroupBox Header="Materials" Grid.RowSpan="2">
   <ListBox x:Name="MaterialList" DisplayMemberPath="Name" AutomationProperties.Name="Materials" BorderThickness="1" BorderBrush="{StaticResource Border}"
            SelectionChanged="MaterialList_SelectionChanged" MouseDoubleClick="Modify_Click"/>
  </GroupBox>
  <StackPanel Grid.Column="2">
   <GroupBox Header="Click to:">
    <StackPanel>
     <Button x:Name="GetFromSapButton" Content="Get From SAP2000" Style="{StaticResource ActionButton}" Click="GetFromSap_Click"
             ToolTip="Read every material of the model open in the running SAP2000 (read-only; works without Connect SAP)"/>
     <Button x:Name="AddNewButton" Content="Add New Material..." Style="{StaticResource ActionButton}" Click="AddNew_Click"/>
     <Button x:Name="AddCopyButton" Content="Add Copy of Material..." Style="{StaticResource ActionButton}" Click="AddCopy_Click"/>
     <Button x:Name="ModifyButton" Content="Modify/Show Material..." Style="{StaticResource ActionButton}" Click="Modify_Click"/>
     <Button x:Name="DeleteButton" Content="Delete Material" Style="{StaticResource ActionButton}" Margin="0" Click="Delete_Click" ToolTipService.ShowOnDisabled="True"/>
    </StackPanel>
   </GroupBox>
   <CheckBox x:Name="ShowAdvanced" Content="Show Advanced Properties" Margin="4,10,0,0"/>
   <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Width="230" Margin="4,10,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
   <Button x:Name="OkButton" Content="OK" MinWidth="90" Margin="0,0,10,0" IsDefault="True" Click="Ok_Click"/>
   <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" IsCancel="True" Click="Cancel_Click"/>
  </StackPanel>
 </Grid>
</Window>
