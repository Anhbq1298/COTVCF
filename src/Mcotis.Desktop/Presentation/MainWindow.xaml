<Window x:Class="Mcotis.Desktop.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" xmlns:c="clr-namespace:Mcotis.Desktop.Presentation.Controls" Title="{Binding WindowTitle, FallbackValue='Mcotis — Meinhardt Cities of Tomorrow Integrated Structures'}" Icon="{x:Static p:AppIcon.Window}" Width="1440" Height="810" MinWidth="1100" MinHeight="660" WindowStartupLocation="Manual">
 <Window.InputBindings>
  <!-- File shortcuts: Ctrl+O opens a model, Ctrl+S saves it to its .mcotis file, Ctrl+Shift+S asks for another file (File → Open… / Save / Save As…) -->
  <KeyBinding Gesture="Ctrl+O" Command="{Binding LoadFemModel}"/>
  <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFemModel}"/>
  <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveFemModelAs}"/>
  <!-- Edit → Undo / Redo: the model's history (a text box keeps its own Ctrl+Z while it has the focus) -->
  <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoModelCommand}"/>
  <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoModelCommand}"/>
 </Window.InputBindings>
 <DockPanel>

  <!-- ============================ MENU BAR ============================
       Desktop-style menus (ETABS-like). The FEM page is split into panes opened from Define, Assign, Run, Result and
       Display. The legacy MB workspace is archived outside the application. Menu items reuse the active commands. -->
  <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
        Padding="6,2" FontSize="12" AutomationProperties.Name="Main menu">
   <MenuItem Header="_File">
    <MenuItem Header="_New Model" Command="{Binding NewConfig}"
              ToolTip="Start a blank Mcotis model. Define materials and frame/cable sections, then create the VCF system under Edit."/>
    <MenuItem Header="_Open…" Command="{Binding LoadFemModel}" InputGestureText="Ctrl+O"
              ToolTip="Open a Mcotis model (.mcotis): the complete analysis model, its setup and, for a locked model, its results. An older MCOTiS configuration (.cotfem.db, .cotfem.json) opens as an import: Save then writes a .mcotis file, and the older file is never written."/>
    <MenuItem Header="_Save" Command="{Binding SaveFemModel}" InputGestureText="Ctrl+S"
              ToolTip="Save the model — geometry, objects, assignments, materials, sections, loads, load cases, analysis and output settings, and the lock state — in its .mcotis file. A model without a .mcotis file yet asks for its file name."/>
    <MenuItem Header="Save _As…" Command="{Binding SaveFemModelAs}" InputGestureText="Ctrl+Shift+S"
              ToolTip="Save the model under another file name. That file becomes the model's file: Save then overwrites it, and the file it came from is left as it was."/>
    <Separator/>
    <MenuItem Header="Load _VCF…" Command="{Binding LoadDefaultModel}" AutomationProperties.Name="Load VCF"
              ToolTip="Set the current model aside and open the built-in default model (COT Framing_V1.2_100m) on 07 FEM, ready to run without SAP2000"/>
    <MenuItem Header="Load _TAS…" Click="LoadTas_Click" AutomationProperties.Name="Load TAS"
              ToolTip="Open the built-in TAS model — the CoT 120 m composite arch deck — exactly as Import From ETABS brings it in: joints, frames, materials and sections, end releases, supports, load patterns and loads, load cases and combinations, ready to run without ETABS"/>
    <Separator/>
    <MenuItem Header="_Import From SAP2000" Click="ImportFromSap_Click" AutomationProperties.Name="Import From SAP2000"
              ToolTip="Import the model open in SAP2000 — geometry, member properties, materials and sections, load patterns and loads, load cases and combinations, chord groups and cable target forces — ready to run. Read-only; SAP2000 is never written."/>
    <MenuItem Header="Import From _ETABS" Click="ImportFromEtabs_Click" AutomationProperties.Name="Import From ETABS"
              ToolTip="Import the model open in ETABS — joints, frames, materials and sections (CFT, steel encased and Section Designer included), end releases, load patterns and loads, load cases and combinations — as a Mcotis model ready to run. Read-only; ETABS is never written. Without ETABS running, an .e2k file can be imported instead."/>
    <MenuItem Header="_Export to SAP2000…" Click="ExportToSap_Click" AutomationProperties.Name="Export to SAP2000"
              ToolTip="Write the Mcotis model into the model open in SAP2000 — geometry, sections, materials, assignments, supports, assigned loads, cable target forces, load cases and combinations — ready to run there. Shows the changes first; the SAP2000 model is not saved."/>
    <MenuItem Header="Export to E_TABS…" Click="ExportToEtabs_Click" AutomationProperties.Name="Export to ETABS"
              ToolTip="Write the Mcotis model into the model open in ETABS — frames matched by their ends, sections, materials, releases, supports, load patterns with every joint and frame load, load cases and combinations — ready to run there. Shows the changes first; the ETABS model is not saved."/>
    <MenuItem Header="_Read FEM Properties from SAP" Command="{Binding ReadFemProperties}"
              ToolTip="Read sections, materials (unit weight / mass), modifiers, end releases, load patterns with their assigned loads, static load cases and combinations from the connected SAP2000 model. Read-only; resets the Loads tables to SAP."/>
   </MenuItem>
   <MenuItem Header="_Define" IsEnabled="{Binding CanDefineFemModel}">
    <MenuItem Header="_Materials…" Click="DefineMaterials_Click" AutomationProperties.Name="Define Materials"
              ToolTip="Material library: Get From SAP2000, add, copy, modify or delete materials; changes apply to the FEM members that use them"/>
    <MenuItem Header="Section _Properties" AutomationProperties.Name="Section Properties">
     <MenuItem Header="_Frame Sections…" Tag="Frame" Click="SectionList_Click" AutomationProperties.Name="Frame Sections"/>
     <MenuItem Header="_Tendon Sections…" Tag="Tendon" Click="SectionList_Click" AutomationProperties.Name="Tendon Sections"/>
     <MenuItem Header="_Cable Sections…" Tag="Cable" Click="SectionList_Click" AutomationProperties.Name="Cable Sections"/>
     <Separator/>
     <MenuItem Header="_Member Sections Table…" Click="DefineSections_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="The section, material and properties of every member the FEM uses"/>
    </MenuItem>
    <MenuItem Header="Load _Patterns" Tag="1" Click="FemPaneMenu_Click" IsEnabled="{Binding HasUsableModelGeometry}"
              ToolTip="The load patterns of the model. Their loads are part of the VCF system: Edit → VCF System → Storey Force and Cable Force"/>
    <MenuItem Header="Load _Cases / Load Combinations" Tag="2" Click="FemPaneMenu_Click" IsEnabled="{Binding HasUsableModelGeometry}"
              ToolTip="Define the load cases: the default staged setup (Pretension → SLS / ULS), the cases saved from SAP2000, or your own"/>
    <Separator/>
    <MenuItem Header="_Grid Systems…" Click="GridSystems_Click" AutomationProperties.Name="Grid Systems"
              ToolTip="Named Cartesian grid systems: X lines 1, 2, 3 … and Y lines A, B, C … at their coordinates, an origin and a rotation; Quick Grid from bays and spacings. References to draw and navigate on — a grid is no joint and no analysis input."/>
    <MenuItem Header="_Levels…" Click="Levels_Click" AutomationProperties.Name="Levels"
              ToolTip="The levels (storeys) of the model: name and elevation Z; Generate Levels from a base and storey heights. The XY plan navigator steps through them; changing a level moves no joint."/>
   </MenuItem>
   <MenuItem Header="_Edit">
    <MenuItem Header="_Undo" Command="{Binding UndoModelCommand}" InputGestureText="Ctrl+Z" AutomationProperties.Name="Undo"
              ToolTip="Take back the last change of the model — the whole model as it was before it (FEM results are cleared)"/>
    <MenuItem Header="_Redo" Command="{Binding RedoModelCommand}" InputGestureText="Ctrl+Y" AutomationProperties.Name="Redo"
              ToolTip="Make again the change Undo took back"/>
    <Separator/>
    <MenuItem Header="_TemplateBuilding…" Click="TemplateBuilding_Click" AutomationProperties.Name="TemplateBuilding"
              ToolTip="Generate a building frame — X / Y bays, storey heights, beam line loads, sections, supports — as the model of this window, in 3D (the open model is offered to be saved first)"/>
    <MenuItem Header="_VCF System…" Click="VcfGeometry_Click" AutomationProperties.Name="VCF System" IsEnabled="{Binding CanEditVcfGeometry}"
              ToolTip="{Binding VcfGeometryToolTip}" ToolTipService.ShowOnDisabled="True"/>
    <MenuItem Header="Tied _Arch System…" Click="TiedArch_Click" AutomationProperties.Name="Tied Arch System"
              ToolTip="Build the tied arch system (TAS) from H1 (support → arch crown), H2 (support → top chord), the number of bays and their spacing, and the storeys above (SW, SDL, LL, floors) — with the SLS / ULS point load on each top chord joint and a live preview"/>
    <Separator/>
    <MenuItem Header="_Move…" Click="MoveSelection_Click" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Move"
              ToolTip="Move the points, frames and cables selected on the model view by DX, DY, DZ: each point once, so the members on them follow. One Undo step."/>
    <MenuItem Header="Move by _Two Points" Click="MoveTool_Click" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Move by Two Points"
              ToolTip="Move the selection on the model view: click a base point, then its destination (with snapping). Esc cancels."/>
    <MenuItem Header="_Delete" Click="DeleteSelection_Click" InputGestureText="Del" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Delete"
              ToolTip="Delete the joints, frames and cables selected on the model view (a deleted joint takes its connected members; a deleted member leaves its end points). One Undo step; SAP2000 is unchanged"/>
    <Separator/>
    <MenuItem Header="Re-apply _Generator…" Click="ReapplyGenerator_Click" AutomationProperties.Name="Re-apply Generator"
              IsEnabled="{Binding CanReapplyGenerator}" ToolTipService.ShowOnDisabled="True"
              ToolTip="{Binding GeneratorSummary, StringFormat='Rebuild the VCF or tied arch system from the parameters its generator made it with; shows what it overwrites first. {0}'}"/>
    <MenuItem Header="Detac_h from Generator" Click="DetachGenerator_Click" AutomationProperties.Name="Detach from Generator"
              IsEnabled="{Binding CanDetachGenerator}" ToolTipService.ShowOnDisabled="True"
              ToolTip="{Binding GeneratorSummary, StringFormat='Make the model an ordinary model: it keeps everything but can no longer be optimized (Undo gives the flag back). {0}'}"/>
   </MenuItem>
   <!-- Draw (geometry editing plan): tools on the model view and forms by coordinates; every edit is one Undo step -->
   <MenuItem Header="Dra_w" IsEnabled="{Binding CanDefineFemModel}">
    <MenuItem Header="_Point" Click="DrawTool_Click" Tag="Point" IsEnabled="{Binding CanDrawGeometry}" AutomationProperties.Name="Draw Point"
              ToolTip="Click on the model view to place points: on a grid crossing, on a member or anywhere in the plane shown (in 3D: on the work plane). Right-click ends."/>
    <MenuItem Header="Point by _Coordinates…" Click="PointCoordinates_Click" IsEnabled="{Binding CanDrawGeometry}" AutomationProperties.Name="Point by Coordinates"
              ToolTip="Add points by X, Y, Z — absolute, relative to a point, or on the plane shown — one at a time or pasted as a table"/>
    <Separator/>
    <MenuItem Header="_Frame" Click="DrawTool_Click" Tag="Frame" IsEnabled="{Binding CanDrawGeometry}" AutomationProperties.Name="Draw Frame"
              ToolTip="Click the start and end of each frame on the model view; an end on a point uses it, an end in empty space makes a point. Draw Continuous chains them; right-click or Esc ends the chain."/>
    <MenuItem Header="C_able" Click="DrawTool_Click" Tag="Cable" IsEnabled="{Binding CanDrawGeometry}" AutomationProperties.Name="Draw Cable"
              ToolTip="As Draw Frame, for tension-only cables with the drawing cable section"/>
    <MenuItem Header="Frame / Cable by Coo_rdinates…" Click="MemberCoordinates_Click" IsEnabled="{Binding CanDrawGeometry}" AutomationProperties.Name="Frame by Coordinates"
              ToolTip="Add a frame or a cable from the coordinates of its ends I and J (or the points selected on the model view)"/>
    <MenuItem Header="Draw C_ontinuous" IsCheckable="True" IsChecked="{Binding ChainDrawing}" AutomationProperties.Name="Draw Continuous"
              ToolTip="On: the next member starts where the last one ended, until a right-click or Esc. Off: every member is two clicks."/>
    <Separator/>
    <MenuItem Header="_Generate Points at Grid Intersections…" Click="GenerateGridPoints_Click" IsEnabled="{Binding CanDrawGeometry}" AutomationProperties.Name="Generate Points at Grid Intersections"
              ToolTip="A point at every crossing of the visible grid lines, at the levels chosen — never at a position that has a point already. One Undo step."/>
    <Separator/>
    <MenuItem Header="_Snap To" AutomationProperties.Name="Snap To">
     <MenuItem Header="_Points and member ends" IsCheckable="True" IsChecked="{Binding SnapToPoints}"/>
     <MenuItem Header="_Midpoints" IsCheckable="True" IsChecked="{Binding SnapToMidpoints}"/>
     <MenuItem Header="_Intersections of members" IsCheckable="True" IsChecked="{Binding SnapToIntersections}"
               ToolTip="Where two members cross in the plane. A joint drawn there connects to both: the analysis divides frames at the joints on them."/>
     <MenuItem Header="_Grid intersections" IsCheckable="True" IsChecked="{Binding SnapToGrid}"/>
     <MenuItem Header="Along grid _lines and levels" IsCheckable="True" IsChecked="{Binding SnapToGridLines}"/>
     <MenuItem Header="P_erpendicular" IsCheckable="True" IsChecked="{Binding SnapPerpendicular}"/>
     <MenuItem Header="_Nearest on a member" IsCheckable="True" IsChecked="{Binding SnapNearest}"/>
     <MenuItem Header="_Ortho (also: hold Shift)" IsCheckable="True" IsChecked="{Binding SnapOrtho}"/>
    </MenuItem>
   </MenuItem>
   <MenuItem Header="_Assign" IsEnabled="{Binding CanEditFemModel}">
    <MenuItem Header="_Joint">
     <MenuItem Header="_Restraints…" Click="AssignRestraints_Click" AutomationProperties.Name="Assign Joint Restraints"
               ToolTip="Hold UX, UY, UZ, RX, RY, RZ at the joints selected on the model view (Fixed, Pinned, Roller, Free); the model is analysed, drawn and exported on them as they are"/>
     <MenuItem Header="Restraints _Summary" Tag="3" Click="FemPaneMenu_Click" ToolTip="The joint restraints the model holds"/>
     <MenuItem Header="_Masses…" Click="AssignJointMass_Click" AutomationProperties.Name="Assign Joint Masses"
               ToolTip="Additional mass at the joints selected on the model view: translational mass along UX, UY, UZ [t] and rotational inertia about RX, RY, RZ [t·m²]. A modal case counts it through a mass source that includes additional mass (MS1 does)."/>
    </MenuItem>
    <MenuItem Header="_Frame">
     <MenuItem Header="Frame _Sections…" Tag="Frame" Click="AssignSections_Click" AutomationProperties.Name="Assign Frame Sections"
               ToolTip="Assign a frame section to the frames selected on the model view (select them first, as in SAP2000)"/>
     <MenuItem Header="_Local Axes…" Click="AssignFrameAxes_Click" AutomationProperties.Name="Assign Frame Local Axes"
               ToolTip="Rotate the local 2/3 axes of the selected frames and update their in-plane FEM stiffness"/>
     <MenuItem Header="Frame _Load…" Click="AssignFrameLoad_Click" AutomationProperties.Name="Assign Frame Distributed Loads"
               ToolTip="Assign distributed forces or moments to selected frames in a load pattern: trapezoid or uniform, global or local, projected or not; add, replace or delete"/>
    </MenuItem>
    <MenuItem Header="_Cable">
     <MenuItem Header="Cable _Sections…" Tag="Cable" Click="AssignSections_Click" AutomationProperties.Name="Assign Cable Sections"
               ToolTip="Assign a cable section to the cables selected on the model view (select them first, as in SAP2000)"/>
    </MenuItem>
   </MenuItem>
   <MenuItem Header="_Run" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Run _FEM Analysis" Command="{Binding RunFemAnalysis}"
              ToolTip="Solve the model as it is defined — one run of Mcotis's own solver, with the degrees of freedom of Analysis Options. SAP2000 is not read or written. Many cases belong to the parametric study (Optimization VCF)."/>
    <MenuItem Header="_Unlock FEM Model" Command="{Binding UnlockFemModel}"
              ToolTip="Delete this revision's FEM output databases, clear Post-Processing and enable editing"/>
    <MenuItem Header="Cancel FEM Analysis" Command="{Binding CancelFemAnalysis}"/>
    <MenuItem Header="Analysis _Monitor" Click="OpenFemMonitorClick"
              ToolTip="Open the run monitor: every load case with its convergence, numerical stability and log, and the cable convergence."/>
    <Separator/>
    <MenuItem Header="Analysis _Options…" Click="AnalysisOptions_Click" AutomationProperties.Name="Analysis Options"/>
   </MenuItem>
   <MenuItem x:Name="ResultMenu" Header="Res_ult" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Show _Deformed Shape…" InputGestureText="F5" Click="ShowDeformedShape_Click" IsEnabled="{Binding HasFemResults}" ToolTip="Choose the load case for the deformed shape"/>
    <MenuItem Header="Show Member _Forces…" InputGestureText="F6" Click="ShowMemberForces_Click" IsEnabled="{Binding HasFemResults}" ToolTip="Choose the load case and N, V or M diagram"/>
    <MenuItem Header="Show _Joint Reactions…" InputGestureText="F7" Click="ShowJointReactions_Click" IsEnabled="{Binding HasFemResults}" ToolTip="Choose the load case for joint reactions"/>
    <Separator/>
    <MenuItem Header="_Axial forces / cables" Tag="AxialForce" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Bending moments" Tag="BendingMoment" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Shear forces" Tag="Shear" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="Support _reactions" Tag="Reactions" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Deflection" Tag="DeflectedShape" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Cable target fit" Tag="CableFit" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"
              Visibility="{Binding HasCableMembers, Converter={StaticResource BoolVisibility}}"/>
    <Separator/>
    <MenuItem Header="Show _Results…" Click="ShowResults_Click" ToolTip="Choose the load case / combo and the output to draw on the model"/>
    <MenuItem Header="Show _Quantities…" Click="ShowQuantities_Click" ToolTip="Show assigned sections, section outlines and member quantities from the Mcotis model"/>
    <MenuItem Header="Results _Table…" Click="OpenFemResultsClick" IsEnabled="{Binding HasFemResults}"
              ToolTip="Open the results table for the selected load case and output"/>
    <MenuItem x:Name="ModalResultsMenu" Header="_Modal Results…" Click="ModalResults_Click" IsEnabled="{Binding HasFemModalResults}" ToolTipService.ShowOnDisabled="True"
              ToolTip="The modes of the modal cases of the run: frequencies, participation, mode shapes and the mass — and a mode drawn on the model"/>
   </MenuItem>
   <MenuItem Header="Di_splay" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Show _Undeformed Shape" InputGestureText="F4" Click="ShowUndeformed_Click" AutomationProperties.Name="Show Undeformed Shape menu"
              ToolTip="Clear the result display (forces, deformed shape, reactions) and show the model; Show Results draws a result again"/>
    <Separator/>
    <MenuItem Header="Frame _mesh" IsCheckable="True" IsChecked="{Binding ShowFemFrameMesh}"
              ToolTip="Draw each frame broken into its FEM mesh segments (Analysis → Frame mesh). Cables are not meshed."/>
    <MenuItem Header="Member _size" IsCheckable="True" IsChecked="{Binding ShowFemMemberSizes}"
              ToolTip="Label each frame and cable with its assigned SAP section."/>
    <MenuItem Header="Frame local _axes" IsCheckable="True" IsChecked="{Binding ShowFrameLocalAxes}"
              ToolTip="Show local 1/2/3 axes of frames; select frames to isolate their axes."/>
    <MenuItem Header="_Extruded 3D members" IsCheckable="True" IsChecked="{Binding ShowExtruded3D}"
              ToolTip="In 3D, show member section outlines when checked; show thin member centre-lines when unchecked."/>
    <MenuItem Header="_Dimensions" IsCheckable="True" IsChecked="{Binding ShowDimensions}"
              ToolTip="Dimension the model: bay spans and overall span below it; level heights, overall height and node elevations beside it"/>
    <MenuItem Header="_Loading" IsCheckable="True" IsChecked="{Binding ShowFemLoads}"
              ToolTip="Show the assigned model-load arrows; with a completed case selected, each arrow is labelled with its Fz."/>
    <Separator/>
    <MenuItem Header="_View Options…" Click="ViewOptions_Click" InputGestureText="Ctrl+W"
              ToolTip="Display Options (Ctrl+W): labels, what is shown — points, frames, cables, grid lines, levels — dimensions, loads, the view type and the result display. A view only: nothing of the model or its analysis changes."/>
   </MenuItem>
   <MenuItem Header="Desi_gn" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="_RC Column Design…" Tag="ReinforcedConcrete" Click="DesignMenu_Click" AutomationProperties.Name="RC Column Design"
              ToolTip="Reinforced concrete column design to SS EN 1992-1-1 (EC2) + Singapore NA"/>
    <MenuItem Header="_CFT (Concrete Filled Tube) Design…" Tag="ConcreteFilledTube" Click="DesignMenu_Click" AutomationProperties.Name="CFT Design"
              ToolTip="Concrete filled steel tube column design to SS EN 1994-1-1 + Singapore NA and BCA BC4:2025 (high-strength materials)"/>
    <MenuItem Header="_Steel Encased Composite Column Design…" Tag="SteelEncased" Click="DesignMenu_Click" AutomationProperties.Name="Steel Encased Composite Column Design"
              ToolTip="Concrete-encased steel section column design to SS EN 1994-1-1 + Singapore NA and BCA BC4:2025 (high-strength materials)"/>
    <MenuItem Header="_Mega Composite Column Design…" Tag="MegaComposite" Click="DesignMenu_Click" AutomationProperties.Name="Mega Composite Column Design"
              ToolTip="Several concrete-encased steel profiles: CTBUH / ArcelorMittal (2016) simplified method on SS EN 1994-1-1 6.7.3, high-strength materials per BCA BC4:2025"/>
    <MenuItem Header="Steel _Beam / Column Design…" Tag="Steel" Click="DesignMenu_Click" AutomationProperties.Name="Steel Beam Column Design"
              ToolTip="Bare steel beam and column design (I, RHS, CHS) to SS EN 1993-1-1 (EC3) + Singapore NA: classification, cross-section, flexural and lateral-torsional buckling, Annex B interaction"/>
    <MenuItem Header="Tension C_able Design…" Click="TensionCableDesign_Click" AutomationProperties.Name="Tension Cable Design"
              ToolTip="Check each cable's assigned section with editable breaking stress and reduction factor, then optimize strand counts with iteration history and Apply. The stay-system sizing tools are also available here."/>
    <Separator/>
    <MenuItem Header="_Override Design Procedure…" Click="OverrideDesignProcedure_Click" AutomationProperties.Name="Override Design Procedure"
              ToolTip="Select members and assign each the design procedure of any Design engine; the member's size comes from its section and its forces from the FEM analysis"/>
   </MenuItem>
   <MenuItem Header="_Post-Processing" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="_Output Settings" Tag="8" Click="FemPaneMenu_Click"
              ToolTip="Choose result cases, monitored objects and limits for FEM output"/>
    <MenuItem Header="FEM Live Results (_HTML)…" Click="OpenFemHtml_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Open the interactive FEM report: switch load cases and result families, inspect values, zoom and pan without regenerating HTML">
     <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14"/></MenuItem.Icon>
    </MenuItem>
   </MenuItem>
   <MenuItem Header="_Help">
    <MenuItem Header="_User Guide" Click="ShowUserGuide" InputGestureText="F1" AutomationProperties.Name="User Guide"
              ToolTip="The encyclopedia of Mcotis: an article for every function — where to find it, what it does and how to use it (docs/USER_GUIDE.md)"/>
    <Separator/>
    <MenuItem Header="_Workflow Help" Click="ShowWorkflowHelp"/>
    <MenuItem Header="_FEM Procedure" Click="ShowFemHelp"/>
    <Separator/>
    <MenuItem Header="_Development Plans" Click="ShowDevelopmentPlans" AutomationProperties.Name="Development Plans"
              ToolTip="What has been built in Mcotis, by whom, where to find it and how it is checked — and what is planned (docs/DEVELOPMENT_LOG.md)"/>
   </MenuItem>
   <!-- Optimization has a tab of its own, set apart by a separator and highlighted (the header template; the Header
        stays a string, which the window and the checks read). It is the final menu on the bar. -->
   <Separator x:Name="OptimizationMenuSeparator" Style="{StaticResource MenuBarSeparator}"/>
   <MenuItem x:Name="OptimizationMenu" Header="_Optimization" HeaderTemplate="{StaticResource HighlightedMenuHeader}" IsEnabled="{Binding HasUsableModelGeometry}"
             SubmenuOpened="OptimizationMenu_Opened">
    <!-- Each optimization varies the system of a generator: the open model's generator flag and the generator's
         validation of the model enable it (never the model's name); the tooltip says why one is greyed. -->
    <MenuItem Header="_Optimization VCF…" Click="OptimizationVcf_Click" AutomationProperties.Name="Optimization VCF"
              IsEnabled="{Binding CanOptimizeVcf}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding OptimizationVcfToolTip}"/>
    <MenuItem Header="Optimization _TAS…" Click="OptimizationTas_Click" AutomationProperties.Name="Optimization TAS"
              IsEnabled="{Binding CanOptimizeTas}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding OptimizationTasToolTip}"/>
    <MenuItem Header="Optimization _Results…" Click="OptimizationResults_Click" AutomationProperties.Name="Optimization Results"
              ToolTip="Every case of the last Optimization VCF or Optimization TAS run with its max deflection (sortable)"/>
    <MenuItem Header="Compare with _SAP2000…" Click="CompareWithSap_Click" AutomationProperties.Name="Compare with SAP2000"
              IsEnabled="{Binding HasFemResults}" ToolTipService.ShowOnDisabled="True"
              ToolTip="The member force table of Export Results with a SAP2000 column beside every Mcotis column: the forces of the model exported to SAP2000 and analysed there, member by member (SAP2000 is only read)"/>
    <MenuItem Header="_Cancel Optimization" Click="CancelOptimization_Click" IsEnabled="{Binding IsVcfOptimizationRunning}"/>
   </MenuItem>
  </Menu>

  <!-- ============================ TOP BAR ============================ -->
  <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
   <DockPanel>
    <Grid VerticalAlignment="Center">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MaxWidth="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto" MaxWidth="260"/><ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <!-- Tool icons (ETABS-like): file · run · select and draw · zoom · plane · view · results. Same commands as the menus.
          The one place for the view: the model view itself carries no controls (ShowViewChrome off). It wraps when narrow. -->
     <WrapPanel x:Name="TopToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="Toolbar">
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8A5;" Command="{Binding NewConfig}" ToolTip="New Config (File → New Config)" AutomationProperties.Name="New Config"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8E5;" Command="{Binding LoadFemModel}" ToolTip="Open — Load MCOTiS Config (File → Load Config)" AutomationProperties.Name="Load Config"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE74E;" Command="{Binding SaveFemModel}" ToolTip="Save MCOTiS Config (File → Save Config · Ctrl+S)" AutomationProperties.Name="Save Config"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE792;" Command="{Binding SaveFemModelAs}" ToolTip="Save MCOTiS Config As… — under another file name (File → Save Config As · Ctrl+Shift+S)" AutomationProperties.Name="Save Config As"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarButton}" Content="{Binding FemLockGlyph}" Command="{Binding ToggleFemModelLock}"
              ToolTip="{Binding FemLockActionText}" AutomationProperties.Name="Lock or unlock FEM model"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE768;" Command="{Binding RunFemAnalysis}" ToolTip="Run FEM Analysis (Run → Run FEM Analysis)" AutomationProperties.Name="Run FEM Analysis"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE713;" Click="AnalysisOptions_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="Analysis Options (Run → Analysis Options)" AutomationProperties.Name="Analysis Options"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE9D9;" Click="OpenFemMonitorClick" ToolTip="Analysis Monitor (Run → Analysis Monitor)" AutomationProperties.Name="Analysis Monitor"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <!-- SAP2000-style tools: Select (default — a click selects joints / members, a drag draws a window) and Pan -->
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" IsEnabled="{Binding ShowSharedViewer}"
                    ToolTip="Select (V, default) — left-click a point, frame or cable to select it (again to deselect), right-click it for its information; drag a window: left to right selects what is inside, right to left also what it crosses. Works in the 3D view too. Esc clears the selection."
                    Click="SelectTool_Click" AutomationProperties.Name="Select">
       <ToggleButton.IsChecked>
        <MultiBinding Converter="{x:Static p:SelectToolConverter.Instance}" Mode="OneWay">
         <Binding Path="PanMode" ElementName="SharedViewer"/>
         <Binding Path="DrawingTool"/>
        </MultiBinding>
       </ToggleButton.IsChecked>
       <Path Data="M3,1 L3,14 L6.4,10.8 L8.8,15.5 L10.9,14.5 L8.5,9.9 L13,9.9 Z" Fill="{StaticResource Accent}" Stroke="{StaticResource Accent}" StrokeThickness="0.6" StrokeLineJoin="Round"/>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" IsEnabled="{Binding ShowSharedViewer}" IsChecked="{Binding PanMode, ElementName=SharedViewer}"
                    ToolTip="Pan — drag to move the model (the middle mouse button always pans). V or Select returns to selecting."
                    AutomationProperties.Name="Pan">
       <!-- four-way move arrows -->
       <Path Data="M8,0.5 L10.6,3.4 L8.9,3.4 L8.9,7.1 L12.6,7.1 L12.6,5.4 L15.5,8 L12.6,10.6 L12.6,8.9 L8.9,8.9 L8.9,12.6 L10.6,12.6 L8,15.5 L5.4,12.6 L7.1,12.6 L7.1,8.9 L3.4,8.9 L3.4,10.6 L0.5,8 L3.4,5.4 L3.4,7.1 L7.1,7.1 L7.1,3.4 L5.4,3.4 Z"
             Fill="{StaticResource Accent}"/>
      </ToggleButton>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE894;" Click="ClearSelection_Click" IsEnabled="{Binding ShowSharedViewer}" FontSize="12"
              ToolTip="Clear Selection (Esc)" AutomationProperties.Name="Clear Selection"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <!-- drawing tools (Draw menu): each edit is one Undo step; right-click or Esc ends a chain -->
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="Point" IsEnabled="{Binding CanDrawGeometry}" Click="DrawTool_Click"
                    IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Point}}"
                    ToolTip="Draw Point — click to place points on the plane shown (Draw → Point)" AutomationProperties.Name="Point tool">
       <Canvas Width="16" Height="16"><Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6" Fill="{StaticResource Accent}"/>
        <Path Data="M8,0.5 L8,3.5 M8,12.5 L8,15.5 M0.5,8 L3.5,8 M12.5,8 L15.5,8" Stroke="{StaticResource Accent}" StrokeThickness="1.2"/></Canvas>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="Frame" IsEnabled="{Binding CanDrawGeometry}" Click="DrawTool_Click"
                    IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Frame}}"
                    ToolTip="Draw Frame — click its start and end; Draw Continuous chains them (Draw → Frame)" AutomationProperties.Name="Frame tool">
       <Canvas Width="16" Height="16"><Path Data="M3,13 L13,3" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse Canvas.Left="1" Canvas.Top="11" Width="4" Height="4" Fill="White" Stroke="{StaticResource Accent}"/><Ellipse Canvas.Left="11" Canvas.Top="1" Width="4" Height="4" Fill="White" Stroke="{StaticResource Accent}"/></Canvas>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="Cable" IsEnabled="{Binding CanDrawGeometry}" Click="DrawTool_Click"
                    IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Cable}}"
                    ToolTip="Draw Cable — as Draw Frame, a tension-only cable (Draw → Cable)" AutomationProperties.Name="Cable tool">
       <Canvas Width="16" Height="16"><Path Data="M3,13 L13,3" Stroke="{StaticResource AccentBright}" StrokeThickness="1.8" StrokeDashArray="2,1.5"/>
        <Ellipse Canvas.Left="1" Canvas.Top="11" Width="4" Height="4" Fill="White" Stroke="{StaticResource AccentBright}"/><Ellipse Canvas.Left="11" Canvas.Top="1" Width="4" Height="4" Fill="White" Stroke="{StaticResource AccentBright}"/></Canvas>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="Move" IsEnabled="{Binding CanEditFemModel}" Click="DrawTool_Click"
                    IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Move}}"
                    ToolTip="Move by two points — select first, then click a base point and its destination (Edit → Move… by DX, DY, DZ)" AutomationProperties.Name="Move tool">
       <Canvas Width="16" Height="16"><Rectangle Canvas.Left="1" Canvas.Top="8" Width="7" Height="7" Stroke="{StaticResource Accent}" StrokeDashArray="1.5,1"/>
        <Path Data="M5,11 L14,2 M9,2 L14,2 L14,7" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas>
      </ToggleButton>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE74D;" FontSize="13" Click="DeleteSelection_Click" IsEnabled="{Binding CanEditFemModel}"
              ToolTip="Delete the selection (Del) — shows what goes with it first; one Undo step" AutomationProperties.Name="Delete selection"/>
      <!-- the section a drawn member takes, shown while its tool is on -->
      <ComboBox Width="150" Margin="4,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding FrameSections}" DisplayMemberPath="Name" SelectedValuePath="Name"
                SelectedValue="{Binding DrawFrameSection, Mode=TwoWay}" Visibility="{Binding IsDrawingFrame, Converter={StaticResource BoolVisibility}}"
                AutomationProperties.Name="Drawing frame section" ToolTip="The section a drawn frame takes (Assign → Frame → Frame Sections changes it afterwards)"/>
      <ComboBox Width="130" Margin="4,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding CableSections}" DisplayMemberPath="Name" SelectedValuePath="Name"
                SelectedValue="{Binding DrawCableSection, Mode=TwoWay}" Visibility="{Binding IsDrawingCable, Converter={StaticResource BoolVisibility}}"
                AutomationProperties.Name="Drawing cable section" ToolTip="The section a drawn cable takes"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE9A6;" Click="ToolbarFit_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Zoom extents / fit (Home)" AutomationProperties.Name="Zoom extents"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8A3;" Tag="1.25" Click="ToolbarZoom_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Zoom in (+)" AutomationProperties.Name="Zoom in"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE71F;" Tag="0.8" Click="ToolbarZoom_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Zoom out (−)" AutomationProperties.Name="Zoom out"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="3-d" Tag="3D" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="3D view — isometric, members to their SAP section size" AutomationProperties.Name="3D view"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="xy" Tag="XY" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Plan view (XY)" AutomationProperties.Name="XY view"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="xz" Tag="XZ" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Elevation view (XZ)" AutomationProperties.Name="XZ view"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="yz" Tag="YZ" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Elevation view (YZ)" AutomationProperties.Name="YZ view"/>
      <!-- the plane picker of xy / xz / yz: the levels (xy) or the grid lines (xz, yz) defined, the coordinates of the
           points, All (projection), or a typed coordinate; hidden in 3D (geometry editing: one view context) -->
      <StackPanel x:Name="ToolbarPlaneNavigator" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"
                  Visibility="{Binding ViewPlaneIsPlane, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="{Binding ViewPlaneAxisLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,2,0"/>
       <Button Style="{StaticResource ToolbarButton}" Content="&#xE76B;" FontSize="11" Width="20" Click="PreviousPlane_Click"
               ToolTip="Previous level or grid line (Ctrl+Page Down)" AutomationProperties.Name="Previous plane"/>
       <ComboBox x:Name="ToolbarPlaneChoiceBox" Width="200" IsEditable="True" VerticalAlignment="Center" ItemsSource="{Binding ViewPlaneChoices}"
                 SelectedItem="{Binding SelectedViewPlaneChoice, Mode=TwoWay}" KeyDown="PlaneChoice_KeyDown" LostKeyboardFocus="PlaneChoice_LostFocus"
                 AutomationProperties.Name="View plane"
                 ToolTip="The plane shown: a level (xy), a grid line (xz, yz), a coordinate the model's points sit at, or All — the whole model projected. Type a coordinate in metres for any other plane. A member is shown only when it lies in the plane. In 3D the last plane is the work plane a drawing tool uses."/>
       <Button Style="{StaticResource ToolbarButton}" Content="&#xE76C;" FontSize="11" Width="20" Click="NextPlane_Click"
               ToolTip="Next level or grid line (Ctrl+Page Up)" AutomationProperties.Name="Next plane"/>
      </StackPanel>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowUndeformed_Click" IsEnabled="{Binding HasUsableModelGeometry}"
              ToolTip="Show Undeformed Shape — clear the result display and show the model (Display → Show Undeformed Shape, F4)" AutomationProperties.Name="Show Undeformed Shape">
       <!-- SAP2000's icon: a portal frame in a box -->
       <Canvas Width="16" Height="16">
        <Rectangle Width="16" Height="16" Stroke="{StaticResource Accent}" StrokeThickness="1"/>
        <Path Data="M4,13.5 L4,4 L12,4 L12,13.5" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Miter"/>
       </Canvas>
      </Button>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE890;" Click="ViewOptions_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="View Options (Display → View Options)" AutomationProperties.Name="View Options"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE9D2;" Click="ShowResults_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="Show Results — choose the load case / combo and the output to draw on the model" AutomationProperties.Name="Show Results"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowDeformedShape_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Show Deformed Shape (F5) — choose load case" AutomationProperties.Name="Show Deformed Shape F5">
       <Canvas Width="16" Height="16">
        <Path Data="M2,13 L2,3 L14,3 L14,13" Stroke="{StaticResource ViewportEdge}" StrokeThickness="1" StrokeDashArray="2,2"/>
        <Path Data="M2,13 C3,7 4,5 8,4 C12,4 13,8 14,13" Stroke="{StaticResource AccentBright}" StrokeThickness="1.8" Fill="Transparent"/>
       </Canvas>
      </Button>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowMemberForces_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Show Member Forces (F6) — choose load case and N, V or M" AutomationProperties.Name="Show Member Forces F6">
       <Canvas Width="18" Height="18">
        <!-- Filled bending-moment regions of a two-storey planar frame. -->
        <Path Data="M2,2 C5,2 5,6 9,6 C13,6 13,2 16,2 Z M2,9 C5,9 6,12.5 9,12.5 C12,12.5 13,9 16,9 Z M2,2 C4,4 4,7 2,9 Z M2,9 C4,11 4,14 2,16 Z M16,2 C14,4 14,7 16,9 Z M16,9 C14,11 14,14 16,16 Z"
              Fill="{StaticResource Warning}" Opacity="0.32"/>
        <Path Data="M2,2 C5,2 5,6 9,6 C13,6 13,2 16,2 M2,9 C5,9 6,12.5 9,12.5 C12,12.5 13,9 16,9 M2,2 C4,4 4,7 2,9 M2,9 C4,11 4,14 2,16 M16,2 C14,4 14,7 16,9 M16,9 C14,11 14,14 16,16"
              Stroke="{StaticResource Warning}" StrokeThickness="1.1" Fill="Transparent"/>
        <Path Data="M2,16 L2,2 L16,2 L16,16 M2,9 L16,9" Stroke="{StaticResource Accent}" StrokeThickness="1.4" Fill="Transparent"/>
       </Canvas>
      </Button>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowJointReactions_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Show Joint Reactions (F7) — choose load case" AutomationProperties.Name="Show Joint Reactions F7">
       <Canvas Width="16" Height="16">
        <Path Data="M2,13 L8,7 L14,13 Z M1,14 L15,14" Stroke="{StaticResource Accent}" StrokeThickness="1.3" Fill="Transparent"/>
        <Path Data="M8,7 L8,1 M8,1 L5.5,4 M8,1 L10.5,4" Stroke="{StaticResource AccentBright}" StrokeThickness="1.6" Fill="Transparent"/>
       </Canvas>
      </Button>
      <!-- N / V / M of the case or combination chosen, in any view: the shear and moment of the plane shown -->
      <ComboBox Width="150" Margin="6,0,2,0" VerticalAlignment="Center" ItemsSource="{Binding FemResultNames}" SelectedItem="{Binding SelectedFemResultName, Mode=TwoWay}"
                IsEnabled="{Binding HasFemResults}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Result case"
                ToolTip="The load case or combination the N, V and M buttons draw (Run FEM Analysis first)"/>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="AxialForce" Click="ForceButton_Click" IsEnabled="{Binding HasFemResults}"
                    IsChecked="{Binding ShowingAxial, Mode=OneWay}" AutomationProperties.Name="Axial force"
                    ToolTip="Axial force N of the case chosen (frames and cables), tension positive">
       <TextBlock Text="N" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}"/>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="Shear" Click="ForceButton_Click" IsEnabled="{Binding HasFemResults}"
                    IsChecked="{Binding ShowingShear, Mode=OneWay}" AutomationProperties.Name="Shear force"
                    ToolTip="Shear force V of the case chosen, in the plane shown">
       <TextBlock Text="V" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}"/>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" Tag="BendingMoment" Click="ForceButton_Click" IsEnabled="{Binding HasFemResults}"
                    IsChecked="{Binding ShowingMoment, Mode=OneWay}" AutomationProperties.Name="Bending moment"
                    ToolTip="Bending moment M of the case chosen, about the normal of the plane shown">
       <TextBlock Text="M" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}"/>
      </ToggleButton>
     </WrapPanel>
    </Grid>
   </DockPanel>
  </Border>

  <!-- ========================== STATUS BAR ========================== -->
  <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
   <StackPanel>
    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,4"/>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding State.Units}" Style="{StaticResource MonoSmall}" Margin="16,0,0,0"/>
     <!-- plane · cursor X Y Z · snap · mode, as the model view reads them (geometry editing) -->
     <TextBlock x:Name="CursorStatus" DockPanel.Dock="Right" Style="{StaticResource MonoSmall}" Margin="16,0,0,0" MaxWidth="560" TextTrimming="CharacterEllipsis"
                ToolTip="The plane shown, where the cursor is in the model (snapped while a drawing tool is on), the snap and the tool" AutomationProperties.Name="Cursor coordinates"/>
     <!-- what is selected on the model view (2D or 3D), by kind of object -->
     <TextBlock x:Name="SelectionStatus" DockPanel.Dock="Right" Style="{StaticResource MonoSmall}" Margin="16,0,0,0" Text="Selected: 0 Frames · 0 Cables · 0 Points · 0 Shells"
                ToolTip="The frames, cables, points and shells selected on the model view" AutomationProperties.Name="Selection" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
   </StackPanel>
  </Border>

  <!-- ============ WORKFLOW TABS (params) + SHARED MODEL PREVIEW ============ -->
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="ParamsColumn" Width="2*" MinWidth="150"/>
    <ColumnDefinition x:Name="ViewerSplitterColumn" Width="Auto"/>
    <ColumnDefinition x:Name="ViewerColumn" Width="3*"/>
   </Grid.ColumnDefinitions>

  <!-- The page chosen from the menu bar fills this pane; the tab rail is hidden. -->
  <DockPanel Grid.Column="0">
   <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,5">
    <StackPanel>
     <DockPanel>
      <Button x:Name="ClosePaneButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="&#xE711;" FontSize="11" Width="22" Height="22"
              Margin="8,0,0,0" Click="ClosePane_Click" Visibility="{Binding ShowSharedViewer, Converter={StaticResource BoolVisibility}}"
              ToolTip="Close this pane — the model view takes the full width; any menu item opens a pane again" AutomationProperties.Name="Close pane"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding PaneStatus}" ToolTip="{Binding PaneStatus}" Style="{StaticResource TabHeaderStatus}" VerticalAlignment="Center"
                 MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
      <TextBlock x:Name="PaneHeader" Style="{StaticResource TabHeaderTitle}" VerticalAlignment="Center" AutomationProperties.Name="Current pane">
       <Run Text="{Binding PaneMenu, Mode=OneWay}" Foreground="{StaticResource Muted}"/><Run Text="  ›  " Foreground="{StaticResource Muted}"/><Run Text="{Binding PaneTitle, Mode=OneWay}"/>
      </TextBlock>
     </DockPanel>
     <TextBlock Text="{Binding OfflineModelSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                Visibility="{Binding IsOfflineModel, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Border>
  <TabControl x:Name="WorkflowTabs" SelectedIndex="{Binding SelectedTab}" SelectionChanged="WorkflowTabs_SelectionChanged" IsEnabled="{Binding HasUsableModelGeometry}" TabStripPlacement="Left" Background="{StaticResource Background}" BorderThickness="0" Padding="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <TabControl.ItemContainerStyle>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Visibility" Value="Collapsed"/></Style>
   </TabControl.ItemContainerStyle>

   <!-- The complete legacy MB workspace is archived under archive/Mcotis.Desktop.
        Inert slots 0-6 and 8 preserve the established index 7 of the active FEM workspace. -->
   <TabItem IsEnabled="False" Focusable="False"/>
   <TabItem IsEnabled="False" Focusable="False"/>
   <TabItem IsEnabled="False" Focusable="False"/>
   <TabItem IsEnabled="False" Focusable="False"/>
   <TabItem IsEnabled="False" Focusable="False"/>
   <!-- Legacy MB pages 06 and 06A are archived under archive/Mcotis.Desktop/LegacyMb.
        Inert slots preserve the established index 7 of the active FEM workspace. -->
   <TabItem IsEnabled="False" Focusable="False"/>
   <TabItem IsEnabled="False" Focusable="False"/>

   <!-- 07 FEM: one pane at a time, opened from the menu bar (MainViewModel.FemPane):
        Define → Sections / Load Patterns / Load Cases / Result Load Case, Assign → Joint Restraints,
        Run → Analysis Options, Result → outputs, Display → View Options. -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="07  FEM" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding FemStatus}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <TabControl x:Name="FemPanes" SelectedIndex="{Binding FemPane}" Background="{StaticResource Background}" BorderThickness="0" Padding="0">
     <TabControl.ItemContainerStyle>
      <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Visibility" Value="Collapsed"/></Style>
     </TabControl.ItemContainerStyle>

     <!-- ============ Define → Sections: opens in its own window (DefineSectionsWindow) ============ -->
     <TabItem Header="Sections">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" VerticalAlignment="Top">
       <StackPanel Margin="8">
        <TextBlock Text="SAP MEMBER PROPERTIES" Style="{StaticResource Subheading}"/>
        <TextBlock Text="{Binding FemSectionProperties.Count, StringFormat='{}{0} frame and cable members · the table opens in its own window.'}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
        <Button Content="Open Sections" Click="DefineSections_Click" HorizontalAlignment="Left"/>
       </StackPanel>
      </Border>
     </TabItem>

     <!-- ============ Define → Load Patterns ============ -->
     <TabItem Header="Load Patterns">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
       <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
         <TextBlock Text="LOAD PATTERNS" Style="{StaticResource Subheading}" Margin="0,0,0,2"/>
         <TextBlock Text="A pattern carries loads once they are assigned to it: a self-weight multiplier here, or a storey load / the cable target forces on Edit → VCF System. A load case combines patterns."
                    Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,5"/>
         <WrapPanel Margin="0,0,0,5" IsEnabled="{Binding CanDefineLoadPatterns}" ToolTipService.ShowOnDisabled="True"
                    ToolTip="Define the load patterns of the model. While a SAP2000 model is connected its patterns are SAP2000's.">
          <TextBox x:Name="NewPatternName" Width="130" Margin="0,0,4,0" VerticalContentAlignment="Center" AutomationProperties.Name="New load pattern name"
                   ToolTip="Name of the new load pattern, e.g. DL_Above"/>
          <ComboBox x:Name="NewPatternType" Width="78" Margin="0,0,4,0" IsEditable="True" Text="Dead" AutomationProperties.Name="New load pattern type"
                    ToolTip="Dead, Live or Other. The default load cases factor a loading pattern by it: dead 1.35, live 1.5.">
           <ComboBoxItem Content="Dead"/><ComboBoxItem Content="Live"/><ComboBoxItem Content="Other"/>
          </ComboBox>
          <Button Content="+ Add" Click="AddLoadPattern_Click" AutomationProperties.Name="Add load pattern"/>
          <Button Content="- Remove" Click="RemoveLoadPattern_Click" AutomationProperties.Name="Remove load pattern"
                  ToolTip="Remove the selected pattern (a pattern used by a load case or an assigned load stays)"/>
         </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="FemPatternRowsGrid" Grid.Row="1" ItemsSource="{Binding FemPatternRows}" IsEnabled="{Binding CanEditFemModel}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
         <DataGrid.Columns>
          <DataGridTextColumn Header="Pattern" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" MinWidth="70"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="Auto" MinWidth="64"/>
          <DataGridTextColumn Header="SW mult." Binding="{Binding SelfWeightMultiplier, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=0.###, ValidatesOnExceptions=True}"
                              Width="Auto" MinWidth="58" ElementStyle="{StaticResource NumericCell}"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" Text="{Binding FemLoadSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <Expander Grid.Row="3" Margin="0,6,0,0">
         <Expander.Header><TextBlock Text="{Binding FemLoadWarnings.Count, StringFormat='Load assignment warnings ({0})'}"/></Expander.Header>
         <ListBox ItemsSource="{Binding FemLoadWarnings}" MaxHeight="120" FontSize="11"/>
        </Expander>
       </Grid>
      </Border>
     </TabItem>

     <!-- ============ Define → Load Cases / Load Combinations ============ -->
     <TabItem Header="Load Cases">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
       <Grid Margin="8">
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
         <TextBlock Text="LOAD CASES" Style="{StaticResource Subheading}" Margin="0,0,0,2"/>
         <TextBlock Text="Select a case and click Modify to set its type, the case it continues from or takes its stiffness from, and its loads. A type that is not solved yet can be defined and saved; Run refuses it with the reason."
                    Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,5"/>
         <WrapPanel Margin="0,0,0,5">
          <Button Content="Default Setup" Click="DefaultLoadCases_Click" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Default load cases"
                  ToolTip="Define the default load cases: Pretension = cable target forces + self-weight; SLS = + 1.0 dead + 1.0 live; ULS = + 0.35 self-weight + 1.35 dead + 1.5 live. Replaces the table."/>
          <Button Content="SAP Cases" Click="SapLoadCases_Click" AutomationProperties.Name="SAP2000 load cases" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Show the load cases and combinations as saved from SAP2000 with this model. Replaces the table.">
           <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
             <Setter Property="IsEnabled" Value="{Binding IsIdle}"/>
             <Style.Triggers><DataTrigger Binding="{Binding HasSapLoadCases}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
            </Style>
           </Button.Style>
          </Button>
          <Button Content="+ Add" Click="AddLoadCase_Click" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Add load case"
                  ToolTip="Add a load case: choose its type, its load patterns and their scale factors, and the case it continues from or takes its stiffness from (Load Case Data)"/>
          <Button Content="Modify" Click="ModifyLoadCase_Click" AutomationProperties.Name="Modify load case" ToolTipService.ShowOnDisabled="True"
                  ToolTip="Load Case Data of the selected case: its name and type, the case it continues from or takes its stiffness from, its load patterns and their scale factors">
           <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
             <Setter Property="IsEnabled" Value="{Binding IsIdle}"/>
             <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedFemCaseRow}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
              <DataTrigger Binding="{Binding SelectedFemCaseRow.Supported}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
             </Style.Triggers>
            </Style>
           </Button.Style>
          </Button>
          <Button Content="- Remove" Click="RemoveLoadCase_Click" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Remove load case"
                  ToolTip="Remove the selected case (a case others continue from or take their stiffness from, or a combination uses, stays)"/>
         </WrapPanel>
        </StackPanel>
        <DataGrid x:Name="FemCaseRowsGrid" Grid.Row="1" ItemsSource="{Binding FemCaseRows}" SelectedItem="{Binding SelectedFemCaseRow, Mode=TwoWay}" IsEnabled="{Binding CanEditFemModel}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="Run" Width="Auto" MinWidth="36">
           <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <CheckBox IsChecked="{Binding Run, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Supported}" HorizontalAlignment="Center"
                      ToolTip="Solve and show this case. A case that is not ticked is solved all the same when the run needs it: a ticked case continues from it, or a ticked combination adds it up."/>
           </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Case" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="Auto" MinWidth="118"/>
          <DataGridTemplateColumn Header="Loads or Mass Source" Width="*" MinWidth="210">
           <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <Button Click="ModifyLoadCase_Click" IsEnabled="{Binding Supported}" HorizontalContentAlignment="Left"
                    HorizontalAlignment="Stretch" Padding="5,0" Margin="0" MinHeight="0" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Edit load components" ToolTip="Load Case Data: the load patterns of the case and their scale factors — or, for a modal case, its mass source and number of modes">
             <TextBlock Text="{Binding LoadsOrMass}" TextTrimming="CharacterEllipsis"/>
            </Button>
           </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="30" MinWidth="30" CanUserResize="False">
           <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <Button Content="…" Click="ModifyLoadCase_Click" IsEnabled="{Binding Supported}" Width="24" Height="22" MinHeight="22" Padding="0" Margin="0"
                    Background="Transparent" BorderThickness="0" AutomationProperties.Name="Load case data"
                    ToolTip="The type of this case, the case it continues from or takes its stiffness from, and its load patterns (Load Case Data)"/>
           </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Type" Binding="{Binding CaseType}" IsReadOnly="True" Width="Auto" MinWidth="90"/>
          <DataGridTextColumn Header="Starts From / Stiffness" Binding="{Binding StartsFrom}" IsReadOnly="True" Width="Auto" MinWidth="110"/>
          <DataGridTextColumn Header="Geometric" Binding="{Binding Geometric}" IsReadOnly="True" Width="Auto" MinWidth="70"/>
          <DataGridCheckBoxColumn Header="Cable Target Forces" Binding="{Binding CableTargetForces}" IsReadOnly="True" Width="Auto"/>
          <DataGridTextColumn Header="Src" Binding="{Binding Source}" IsReadOnly="True" Width="Auto" MinWidth="36"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Availability}" IsReadOnly="True" Width="Auto" MinWidth="90"/>
          <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="Auto" MinWidth="50" MaxWidth="260"/>
         </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,8,0,0">
         <TextBlock Text="LOAD COMBINATIONS" Style="{StaticResource Subheading}" Margin="0,0,0,2"/>
         <TextBlock Text="Linear additive · e.g. 1.2 DEAD + 1.5 LIVE" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,5"/>
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding FemCombinationRows}" IsEnabled="{Binding CanEditFemModel}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Auto">
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="Run" Width="Auto" MinWidth="36">
           <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <CheckBox IsChecked="{Binding Run, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Supported}" HorizontalAlignment="Center"/>
           </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Combination" Binding="{Binding Name}" IsReadOnly="True" Width="Auto" MinWidth="80"/>
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="Auto" MinWidth="64"/>
          <DataGridTextColumn Header="Definition" Binding="{Binding Definition, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Width="*" MinWidth="140"/>
          <DataGridTextColumn Header="Src" Binding="{Binding Source}" IsReadOnly="True" Width="Auto" MinWidth="36"/>
          <DataGridTextColumn Header="Note" Binding="{Binding Note}" IsReadOnly="True" Width="Auto" MinWidth="50" MaxWidth="260"/>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="4" Text="{Binding FemLoadSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </Grid>
      </Border>
     </TabItem>

     <!-- ============ Assign → Joint Restraints ============ -->
     <TabItem Header="Joint Restraints">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" VerticalAlignment="Top">
       <StackPanel Margin="8">
        <TextBlock Text="SUPPORTS" Style="{StaticResource Subheading}"/>
        <TextBlock Text="{Binding FemPinSupportSummary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="The restraints the model holds, component by component (UX, UY, UZ, RX, RY, RZ): read from SAP2000 or ETABS, or assigned with Assign → Joint → Restraints. A model opened or generated without any — the VCF system, an older configuration — gets the pins at the lowest joints connected to near-vertical frames once, as assignments; nothing adds a support afterwards. Joints held in the XZ plane are drawn as supports in the viewer."
                   Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </TabItem>

     <!-- ============ Define → Result Load Case ============ -->
     <TabItem Header="Result Load Case">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" VerticalAlignment="Top">
       <StackPanel Margin="8">
        <TextBlock Text="RESULT SELECTION" Style="{StaticResource Subheading}"/>
        <TextBlock Text="The load case shown by the Result menu, the viewer and the results table." Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="LOAD CASE / COMBO" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0,0,10,0"/>
         <ComboBox Grid.Column="1" ItemsSource="{Binding FemResultNames}" SelectedItem="{Binding SelectedFemResultName}"
                   IsEnabled="{Binding IsIdle}" AutomationProperties.Name="FEM load case or combination"
                   ToolTip="Load case or linear-additive combination shown in the table, the viewer and the Cable Target Fit Result column."/>
        </Grid>
        <TextBlock Text="{Binding FemResultIssue}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,6,0,0" MaxHeight="90"
                   ToolTip="{Binding FemResultIssue}" AutomationProperties.Name="FEM result issue"/>
       </StackPanel>
      </Border>
     </TabItem>

     <!-- ============ Run → Analysis Options ============ -->
     <TabItem Header="Analysis Options">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" VerticalAlignment="Top">
       <StackPanel Margin="8">
        <TextBlock Text="INTERNAL 2D FRAME ANALYSIS" Style="{StaticResource Subheading}"/>
        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Background}" Padding="6" Margin="0,4,0,6">
         <DockPanel>
          <Button DockPanel.Dock="Right" Content="Unlock" Command="{Binding UnlockFemModel}" Margin="8,0,0,0"
                  ToolTip="Delete this locked revision's output databases and enable model editing"/>
          <StackPanel>
           <TextBlock Text="{Binding FemModelEditState}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
           <TextBlock Text="{Binding FemDatabaseSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
         </DockPanel>
        </Border>
        <TextBlock Text="{Binding FemRunSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                   ToolTip="Run Analysis solves the model once as currently defined. Legacy study ranges, when present in an older file, enter this run with their first value."/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6" Visibility="{Binding HasCableMembers, Converter={StaticResource BoolVisibility}}"
                    ToolTip="Cable pretensions are adjusted together under the target-force case loads to meet their assigned targets within this tolerance. Loaded cases then use the fitted pretension.">
         <TextBlock Text="Target-force fitting ±" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
         <TextBox Width="44" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                  IsEnabled="{Binding CanEditFemModel}"
                  Text="{Binding FemTargetFitPercent, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}, ValidatesOnExceptions=True}"/>
         <TextBlock Text="% of target" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
         <Border Width="1" Background="{StaticResource Border}" Margin="10,1,10,1"/>
         <TextBlock Text="Max iterations" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"
                    ToolTip="Maximum pretension adjustments per FEM case. If targets remain outside the tolerance, the closest fit is retained and marked Not fitted."/>
         <TextBox Width="44" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                  IsEnabled="{Binding CanEditFemModel}"
                  Text="{Binding FemTargetFitIterations, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                    ToolTip="Each frame is divided into this many equal sub-elements in the FEM (cables are not meshed). Interior mesh nodes are condensed onto the frame joints, so joint results are unchanged; the mesh gives forces and displacements along each frame for the diagrams and deflected shape.">
         <TextBlock Text="Frame mesh" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
         <TextBox Width="44" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                  IsEnabled="{Binding CanEditFemModel}"
                  Text="{Binding FemFrameMeshSegments, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"/>
         <TextBlock Text="segments per frame" FontSize="11" VerticalAlignment="Center" Margin="4,0,0,0"/>
         <Border Width="1" Background="{StaticResource Border}" Margin="10,1,10,1" Visibility="{Binding HasCableMembers, Converter={StaticResource BoolVisibility}}"/>
         <CheckBox Content="Cable sag" IsChecked="{Binding FemCableSag}" IsEnabled="{Binding CanEditFemModel}" VerticalAlignment="Center" FontSize="11"
                   Visibility="{Binding HasCableMembers, Converter={StaticResource BoolVisibility}}"
                   AutomationProperties.Name="FEM cable sag"
                   ToolTip="Geometric nonlinearity of the cables. A cable that a load case loads along its length — its self-weight, when the case includes a pattern with a self-weight multiplier — hangs in a shallow parabola instead of a straight line. Its tension then follows T/k − (w·cos θ)²·L³ / 24T² = extension + P/k, its stiffness drops to Ernst's equivalent EA/L ÷ (1 + (w·cos θ·L)²·EA / 12T³), and it never goes fully slack. Negligible for highly tensioned cables; it matters for long or lightly tensioned ones. Off = straight tension-only cables."/>
        </StackPanel>
        <WrapPanel>
         <Button Content="Run Analysis" Command="{Binding RunFemAnalysis}" Style="{StaticResource Primary}"
                 ToolTip="Solve the model as it is defined, once: a linear-elastic Euler-Bernoulli frame model with the degrees of freedom of Analysis Options, tension-only cables (with sag, when Cable sag is on), and pin supports. Uses the sections, materials and loading held in the model; SAP2000 is not read or written."/>
         <Button Content="Cancel" Command="{Binding CancelFemAnalysis}"/>
         <Button Content="Monitor" Click="OpenFemMonitorClick" Margin="0,0,4,0"
                 ToolTip="Open the run monitor: every load case with its convergence, numerical stability and log, and the cable convergence."/>
         <TextBlock Style="{StaticResource InlineHelpIcon}" MouseLeftButtonUp="ShowFemHelp"
                    ToolTip="FEM procedure — click to open the documentation under Help."
                    AutomationProperties.Name="FEM procedure help"/>
        </WrapPanel>
        <TextBlock Text="{Binding FemProgressText}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
     </TabItem>

     <!-- ============ Result → Axial / Bending / Shear / Reactions / Deflection / Cable target fit ============ -->
     <TabItem Header="Results">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" VerticalAlignment="Top">
       <StackPanel Margin="8">
        <TextBlock Text="{Binding FemResultDiagramTitle}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Text="{Binding FemResultSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="Choose the load case and output in Result → Show Results."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding FemResultIssue}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,6,0,0" MaxHeight="90"
                   ToolTip="{Binding FemResultIssue}"/>
        <Button Content="View Results" Click="OpenFemResultsClick" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0,8,0,0"
                IsEnabled="{Binding HasFemResults}" ToolTip="Open the results table for this load case and output"/>
        <TextBlock Text="{Binding FemProgressText}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
     </TabItem>

     <!-- ============ Display → View Options: opens in its own window (ViewOptionsWindow) ============ -->
     <TabItem Header="View Options">
      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" VerticalAlignment="Top">
       <StackPanel Margin="8">
        <TextBlock Text="VIEW OPTIONS" Style="{StaticResource Subheading}"/>
        <TextBlock Text="Dimensions and FEM overlays are set in their own window." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/>
        <Button Content="Open View Options" Click="ViewOptions_Click" HorizontalAlignment="Left"/>
       </StackPanel>
      </Border>
     </TabItem>

     <!-- ============ Post-Processing → FEM Output Settings ============ -->
     <TabItem Header="Output Settings">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="8" IsEnabled="{Binding CanEditFemModel}">
        <TextBlock Text="FEM OUTPUT SETTINGS" Style="{StaticResource Subheading}"/>
        <TextBlock Text="Choose the cases and model objects written into the result views. Names accept comma-separated joint, frame or cable objects."
                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         </Grid.RowDefinitions>
         <TextBlock Grid.Row="0" Text="Result family" Style="{StaticResource Subheading}"/>
         <TextBlock Grid.Row="0" Grid.Column="1" Text="Case / combination" Style="{StaticResource Subheading}"/>
         <TextBlock Grid.Row="0" Grid.Column="2" Text="Monitored objects" Style="{StaticResource Subheading}"/>

         <TextBlock Grid.Row="1" Text="Deflection joints" VerticalAlignment="Center"/>
         <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding FemOutputCaseChoices}" SelectedItem="{Binding FemDeflectionOutputCase, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
         <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding FemDeflectionJointNames, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,2" ToolTip="Joint names, comma-separated"/>

         <TextBlock Grid.Row="2" Text="Frame forces" VerticalAlignment="Center"/>
         <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding FemOutputCaseChoices}" SelectedItem="{Binding FemMemberForceOutputCase, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
         <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding FemFrameObjectNames, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,2" ToolTip="Frame object names for axial, shear, moment and station diagrams"/>

         <TextBlock Grid.Row="3" Text="Left supports" VerticalAlignment="Center"/>
         <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding FemOutputCaseChoices}" SelectedItem="{Binding FemFoundationOutputCase, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
         <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding FemFoundationLeftJointNames, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,2" ToolTip="Left support joint names"/>

         <TextBlock Grid.Row="4" Text="Right supports" VerticalAlignment="Center"/>
         <TextBlock Grid.Row="4" Grid.Column="1" Text="same case" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="4,0"/>
         <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding FemFoundationRightJointNames, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,2" ToolTip="Right support joint names"/>

         <TextBlock Grid.Row="5" Text="Cable forces" VerticalAlignment="Center"/>
         <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding FemOutputCaseChoices}" SelectedItem="{Binding FemCableOutputCase, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,6,2"/>
         <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding FemCableObjectNames, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" Margin="0,2" ToolTip="Cable object names; target convergence is shown only for Cable Target Forces cases"/>
        </Grid>

        <WrapPanel Margin="0,10,0,4">
         <TextBlock Text="Downward deflection band" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <TextBox Width="64" Text="{Binding FemDeflectionLimitMinMm, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"/>
         <TextBlock Text=" to " VerticalAlignment="Center"/>
         <TextBox Width="64" Text="{Binding FemDeflectionLimitMaxMm, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"/>
         <TextBlock Text=" mm" VerticalAlignment="Center" Margin="4,0,14,0"/>
         <TextBlock Text="Max cable utilization" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <TextBox Width="64" Text="{Binding FemMaximumCableUtilization, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}, ValidatesOnExceptions=True}" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"/>
        </WrapPanel>
        <TextBlock Text="{Binding FemOutputSettingsStatus}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    </TabControl>
   </TabItem>

   <!-- Legacy MB page 08 is archived; this inert slot preserves its former index. -->
   <TabItem IsEnabled="False" Focusable="False"/>

  </TabControl>
  </DockPanel>

  <GridSplitter x:Name="ViewerSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Border}"/>

  <DockPanel x:Name="SharedViewerPane" Grid.Column="2" Margin="10,10,10,10" LastChildFill="True">
   <!-- the view plane (geometry editing, slice 01): where the plane shown is — a named level or grid line, a coordinate of
        the model's points, or the whole model projected — and previous / next. The same view as the projection box. -->
   <WrapPanel x:Name="PlaneNavigator" DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding HasUsableModelGeometry, Converter={StaticResource BoolVisibility}}">
    <TextBlock Text="PLANE" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <TextBlock Text="{Binding ViewPlaneAxisLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" MinWidth="26" Margin="0,0,2,0"/>
    <Button Style="{StaticResource ToolbarButton}" Content="&#xE76B;" FontSize="12" Click="PreviousPlane_Click" IsEnabled="{Binding ViewPlaneIsPlane}"
            ToolTip="Previous level or grid line (Ctrl+Page Down)" AutomationProperties.Name="Previous plane"/>
    <ComboBox x:Name="PlaneChoiceBox" Width="240" IsEditable="True" ItemsSource="{Binding ViewPlaneChoices}" SelectedItem="{Binding SelectedViewPlaneChoice, Mode=TwoWay}"
              IsEnabled="{Binding ViewPlaneIsPlane}" KeyDown="PlaneChoice_KeyDown" LostKeyboardFocus="PlaneChoice_LostFocus" AutomationProperties.Name="View plane"
              ToolTip="The plane shown: a level (XY), a grid line (XZ, YZ), a coordinate the model's points sit at, or All — the whole model projected. Type a coordinate in metres for any other plane. A member is shown only when it lies in the plane. In 3D the last plane is the work plane a drawing tool uses."/>
    <Button Style="{StaticResource ToolbarButton}" Content="&#xE76C;" FontSize="12" Click="NextPlane_Click" IsEnabled="{Binding ViewPlaneIsPlane}"
            ToolTip="Next level or grid line (Ctrl+Page Up)" AutomationProperties.Name="Next plane"/>
</WrapPanel>
   <TextBlock DockPanel.Dock="Top" Text="{Binding SharedViewerCaption}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding SharedViewerHint}" Style="{StaticResource Hint}" Margin="2,6,0,0"/>
   <Grid>
    <c:Structural2DViewer x:Name="SharedViewer" ShowPointLabels="True" ShowDimensions="{Binding ShowDimensions, Mode=TwoWay}" ShowFrameLocalAxes="{Binding ShowFrameLocalAxes, Mode=TwoWay}" ShowExtruded3D="{Binding ShowExtruded3D, Mode=TwoWay}" SpanPoints="{Binding SharedViewerSpanPoints}"
                          Model="{Binding SharedViewerVisibleModel}" ExtentsModel="{Binding SharedViewerModel}" KeepViewOnEdit="True" LeftInset="44"
                          ViewPlane="{Binding ViewPlane, Mode=TwoWay}" PlaneCoordinate="{Binding SharedViewerPlaneCoordinate}" ViewTitle="{Binding ViewPlaneTitle}"
                          ReferenceGeometry="{Binding SharedViewerReference}" WorkPlane="{Binding SharedViewerWorkPlane}" WorkPlaneCoordinate="{Binding SharedViewerWorkCoordinate}"
                          ShowJoints="{Binding ShowJoints}" ShowFrames="{Binding ShowFrames}" ShowCables="{Binding ShowCables}"
                          ShowGridLines="{Binding ShowGridLines}" ShowLevels="{Binding ShowLevels}" ShowReferenceLabels="{Binding ShowReferenceLabels}"
                          DrawingTool="{Binding DrawingTool, Mode=TwoWay}" SnapModes="{Binding SnapModes}" ChainDrawing="{Binding ChainDrawing}"
                          AppliedPoints="{Binding SharedViewerAppliedPoints}"
                          SelectedAppliedPoint="{Binding SelectedAppliedPoint, Mode=TwoWay}"
                          TopPoints="{Binding SharedViewerTopPoints}"
                          MiddlePoints="{Binding SharedViewerMiddlePoints}"
                          BottomPoints="{Binding SharedViewerBottomPoints}"
                          Cables="{Binding SharedViewerCables}"
                          PinSupportPoints="{Binding SharedViewerPinSupportPoints}"
                          FemResult="{Binding SharedViewerFemResult}" DeflectionIsModeShape="{Binding SharedViewerIsModeShape}"
                          FemResultMode="{Binding FemResultMode, Mode=TwoWay}"
                          FrameMeshSegments="{Binding SharedViewerFrameMeshSegments}"
                          MemberSizes="{Binding SharedViewerMemberSizes}"
                          ShowLoads="{Binding SharedViewerShowLoads, Mode=TwoWay}"
                          LoadValues="{Binding SharedViewerLoadValues}"
                          FrameLoads="{Binding SharedViewerFrameLoads}"
                          ShowAxialValues="{Binding ShowFemAxialValues}"
                          MemberSections="{Binding SharedViewerSections}"
                          SectionDrawings="{Binding SharedViewerSectionDrawings}"
                          SelectedCable="{Binding SelectedCable, Mode=TwoWay}"
                          AutomationProperties.Name="Shared structural model preview"/>
    <!-- the drawing tools (CAD-like strip at the left of the view): Select · Point · Frame · Cable · Move · Delete -->
    <Border x:Name="DrawToolStrip" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0" Padding="2" CornerRadius="3"
            Background="{StaticResource Overlay}" BorderBrush="{StaticResource Border}" BorderThickness="1"
            Visibility="{Binding HasUsableModelGeometry, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Drawing tools">
     <StackPanel>
      <StackPanel.Resources>
       <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolbarDrawingToggle}"><Setter Property="Margin" Value="0,1"/></Style>
      </StackPanel.Resources>
      <ToggleButton IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.None}}"
                    Click="SelectTool_Click" ToolTip="Select (V) — click or drag a window on the model view" AutomationProperties.Name="Select tool">
       <Path Data="M3,1 L3,14 L6.4,10.8 L8.8,15.5 L10.9,14.5 L8.5,9.9 L13,9.9 Z" Fill="{StaticResource Accent}" Stroke="{StaticResource Accent}" StrokeThickness="0.6" StrokeLineJoin="Round"/>
      </ToggleButton>
      <ToggleButton IsEnabled="{Binding CanDrawGeometry}" IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Point}}"
                    ToolTip="Draw Point — click to place points (Draw → Point)" AutomationProperties.Name="Point tool">
       <Canvas Width="16" Height="16"><Ellipse Canvas.Left="5" Canvas.Top="5" Width="6" Height="6" Fill="{StaticResource Accent}"/>
        <Path Data="M8,0.5 L8,3.5 M8,12.5 L8,15.5 M0.5,8 L3.5,8 M12.5,8 L15.5,8" Stroke="{StaticResource Accent}" StrokeThickness="1.2"/></Canvas>
      </ToggleButton>
      <ToggleButton IsEnabled="{Binding CanDrawGeometry}" IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Frame}}"
                    ToolTip="Draw Frame — click its start and end; Draw Continuous chains them (Draw → Frame)" AutomationProperties.Name="Frame tool">
       <Canvas Width="16" Height="16"><Path Data="M3,13 L13,3" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse Canvas.Left="1" Canvas.Top="11" Width="4" Height="4" Fill="White" Stroke="{StaticResource Accent}"/><Ellipse Canvas.Left="11" Canvas.Top="1" Width="4" Height="4" Fill="White" Stroke="{StaticResource Accent}"/></Canvas>
      </ToggleButton>
      <ToggleButton IsEnabled="{Binding CanDrawGeometry}" IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Cable}}"
                    ToolTip="Draw Cable — as Draw Frame, a tension-only cable (Draw → Cable)" AutomationProperties.Name="Cable tool">
       <Canvas Width="16" Height="16"><Path Data="M3,13 L13,3" Stroke="{StaticResource AccentBright}" StrokeThickness="1.8" StrokeDashArray="2,1.5"/>
        <Ellipse Canvas.Left="1" Canvas.Top="11" Width="4" Height="4" Fill="White" Stroke="{StaticResource AccentBright}"/><Ellipse Canvas.Left="11" Canvas.Top="1" Width="4" Height="4" Fill="White" Stroke="{StaticResource AccentBright}"/></Canvas>
      </ToggleButton>
      <ToggleButton IsEnabled="{Binding CanEditFemModel}" IsChecked="{Binding DrawingTool, Mode=TwoWay, Converter={x:Static p:DrawingToolConverter.Instance}, ConverterParameter={x:Static c:DrawingTool.Move}}"
                    ToolTip="Move by two points — select first, then click a base point and its destination (Edit → Move by Two Points; Edit → Move… by DX, DY, DZ)" AutomationProperties.Name="Move tool">
       <Canvas Width="16" Height="16"><Rectangle Canvas.Left="1" Canvas.Top="8" Width="7" Height="7" Stroke="{StaticResource Accent}" StrokeDashArray="1.5,1"/>
        <Path Data="M5,11 L14,2 M9,2 L14,2 L14,7" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Round"/></Canvas>
      </ToggleButton>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE74D;" FontSize="13" Margin="0,1" Click="DeleteSelection_Click" IsEnabled="{Binding CanEditFemModel}"
              ToolTip="Delete the selection (Del) — shows what goes with it first; one Undo step" AutomationProperties.Name="Delete selection"/>
     </StackPanel>
    </Border>
    <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="390" MaxWidth="390" Padding="18,14"
            Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
            Visibility="{Binding ShowBlankModelChoice, Converter={StaticResource BoolVisibility}}">
     <StackPanel>
      <TextBlock Text="BLANK MODEL" Style="{StaticResource Subheading}"/>
      <TextBlock Text="Choose the built-in template or continue with an empty model. For a blank model, define materials and frame/cable sections, then use Edit → VCF System."
                 TextWrapping="Wrap" Foreground="{StaticResource Text}" Margin="0,0,0,12"/>
      <Button Content="Load Default Template" Command="{Binding LoadDefaultModel}" Style="{StaticResource Primary}"
              HorizontalAlignment="Stretch" AutomationProperties.Name="Load default template" Margin="0,0,0,6"
              ToolTip="Open the built-in VCF example with geometry, sections, loads and load cases already configured"/>
      <Button Content="Continue with Blank Model" Command="{Binding ContinueWithBlankModel}"
              HorizontalAlignment="Stretch" AutomationProperties.Name="Continue with blank model"
              ToolTip="Keep the model empty and define its materials, sections and VCF geometry yourself"/>
     </StackPanel>
    </Border>
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,8" Background="{StaticResource Overlay}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Padding="6,3"
            Visibility="{Binding ShowTrussLegend, Converter={StaticResource BoolVisibility}}">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" Fill="{StaticResource ChordTop}" VerticalAlignment="Center"/><TextBlock Text="Top" Style="{StaticResource Caption}" Margin="4,0,10,0"/>
      <Ellipse Width="8" Height="8" Fill="{StaticResource ChordMiddle}" VerticalAlignment="Center"/><TextBlock Text="Middle" Style="{StaticResource Caption}" Margin="4,0,10,0"/>
      <Ellipse Width="8" Height="8" Fill="{StaticResource ChordBottom}" VerticalAlignment="Center"/><TextBlock Text="Bottom" Style="{StaticResource Caption}" Margin="4,0,0,0"/>
     </StackPanel>
    </Border>
    <!-- no pin legend chip on the model view (removed on request); the pins are drawn at the base joints -->
   </Grid>
  </DockPanel>
 </Grid>
 </DockPanel>
</Window>
