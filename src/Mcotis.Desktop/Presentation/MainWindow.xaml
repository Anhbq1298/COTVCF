<Window x:Class="Mcotis.Desktop.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" xmlns:c="clr-namespace:Mcotis.Desktop.Presentation.Controls" Title="{Binding WindowTitle, FallbackValue='Mcotis — Meinhardt Cities of Tomorrow Integrated Structures'}" Icon="{x:Static p:AppIcon.Window}" Width="1440" Height="810" MinWidth="1100" MinHeight="660" WindowStartupLocation="Manual">
 <Window.InputBindings>
  <!-- File shortcuts: Ctrl+S saves the active configuration, Ctrl+Shift+S asks for another file (File → Save Config / Save Config As…) -->
  <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveFemModel}"/>
  <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveFemModelAs}"/>
 </Window.InputBindings>
 <DockPanel>

  <!-- ============================ MENU BAR ============================
       Desktop-style menus (ETABS-like). The FEM page is split into panes opened from Define, Assign, Run, Result and
       Display. MB — workflow pages 01–06A and 08, the SAP2000 study — comes last, after a separator: reference only.
       Menu items reuse the existing commands. -->
  <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
        Padding="6,2" FontSize="12" AutomationProperties.Name="Main menu" MenuItem.SubmenuOpened="MainMenu_SubmenuOpened">
   <MenuItem Header="_File">
    <MenuItem Header="Open _Native Model…" Click="OpenNativeModel_Click" AutomationProperties.Name="Open Native Model"
              ToolTip="Open a .mcotis model in the native model workspace"/>
    <Separator/>
    <MenuItem Header="_New Config" Command="{Binding NewConfig}"
              ToolTip="Start a blank MCOTiS model. Define materials and frame/cable sections, then create the VCF system under Edit."/>
    <MenuItem Header="_Load Config…" Command="{Binding LoadFemModel}"
              ToolTip="Open one MCOTiS configuration containing the complete analysis model and its current setup"/>
    <MenuItem Header="_Save Config" Command="{Binding SaveFemModel}" InputGestureText="Ctrl+S"
              ToolTip="Save geometry, objects, assignments, materials, sections, loads, load cases, analysis and output settings, and the lock state in one MCOTiS configuration file. Save overwrites the active configuration; a new configuration asks for its file name."/>
    <MenuItem Header="Save Config _As…" Command="{Binding SaveFemModelAs}" InputGestureText="Ctrl+Shift+S"
              ToolTip="Save the configuration under another file name. That file becomes the active configuration: Save then overwrites it, and the file it came from is left as it was."/>
    <Separator/>
    <MenuItem Header="_Default Model" Command="{Binding LoadDefaultModel}" AutomationProperties.Name="Load default model"
              ToolTip="Set the current model aside and open the built-in default model (COT Framing_V1.2_100m) on 07 FEM, ready to run without SAP2000"/>
    <Separator/>
    <MenuItem Header="_Import From SAP2000" Click="ImportFromSap_Click" AutomationProperties.Name="Import From SAP2000"
              ToolTip="Import the model open in SAP2000 — geometry, member properties, materials and sections, load patterns and loads, load cases and combinations, chord groups and cable target forces — ready to run. Read-only; SAP2000 is never written."/>
    <MenuItem Header="Import From _ETABS" Click="ImportFromEtabs_Click" AutomationProperties.Name="Import From ETABS"
              ToolTip="Import the model open in ETABS — joints, frames, materials and sections (CFT, steel encased and Section Designer included), end releases, load patterns and loads, load cases and combinations — as a Mcotis model ready to run. Read-only; ETABS is never written. Without ETABS running, an .e2k file can be imported instead."/>
    <MenuItem Header="_Export to SAP2000…" Click="ExportToSap_Click" AutomationProperties.Name="Export to SAP2000"
              ToolTip="Write the Mcotis model into the model open in SAP2000 — geometry, sections, materials, assignments, supports, load patterns, Tab 01 loads, cable target forces, load cases and combinations — ready to run there. Shows the changes first; the SAP2000 model is not saved."/>
    <MenuItem Header="Export to E_TABS…" Click="ExportToEtabs_Click" AutomationProperties.Name="Export to ETABS"
              ToolTip="Write the Mcotis model into the model open in ETABS — frames matched by their ends, sections, materials, releases, supports, load patterns with every joint and frame load, load cases and combinations — ready to run there. Shows the changes first; the ETABS model is not saved."/>
    <MenuItem Header="_Read FEM Properties from SAP" Command="{Binding ReadFemProperties}"
              ToolTip="Read sections, materials (unit weight / mass), modifiers, end releases, load patterns with their assigned loads, static load cases and combinations from the connected SAP2000 model. Read-only; resets the Loads tables to SAP."/>
   </MenuItem>
   <MenuItem Header="_Define" IsEnabled="{Binding CanDefineFemModel}">
    <MenuItem Header="_Materials…" Click="DefineMaterials_Click" AutomationProperties.Name="Define Materials"
              ToolTip="Material library: Get From SAP2000, add, copy, modify or delete materials; changes apply to the FEM members that use them"/>
    <MenuItem Header="Section _Properties" AutomationProperties.Name="Section Properties">
     <MenuItem Header="_Frame Sections…" Tag="Frame" Click="SectionList_Click" AutomationProperties.Name="Frame Sections"/>
     <MenuItem Header="_Tendon Sections…" Tag="Tendon" Click="SectionList_Click" AutomationProperties.Name="Tendon Sections"/>
     <MenuItem Header="_Cable Sections…" Tag="Cable" Click="SectionList_Click" AutomationProperties.Name="Cable Sections"/>
     <Separator/>
     <MenuItem Header="_Member Sections Table…" Click="DefineSections_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="The section, material and properties of every member the FEM uses"/>
    </MenuItem>
    <MenuItem Header="Load _Patterns" Tag="1" Click="FemPaneMenu_Click" IsEnabled="{Binding HasUsableModelGeometry}"
              ToolTip="The load patterns of the model. Their loads are part of the VCF system: Edit → VCF System → Storey Force and Cable Force"/>
    <MenuItem Header="Load _Cases / Load Combinations" Tag="2" Click="FemPaneMenu_Click" IsEnabled="{Binding HasUsableModelGeometry}"
              ToolTip="Define the load cases: the default staged setup (Pretension → SLS / ULS), the cases saved from SAP2000, or your own"/>
   </MenuItem>
   <MenuItem Header="_Edit">
    <MenuItem Header="_TemplateBuilding…" Click="TemplateBuilding_Click" AutomationProperties.Name="TemplateBuilding"
              ToolTip="Create a native building frame with X/Y bays, storey heights and beam line loads in a new model workspace"/>
    <MenuItem Header="_VCF System…" Click="VcfGeometry_Click" AutomationProperties.Name="VCF System" IsEnabled="{Binding CanEditVcfGeometry}"
              ToolTip="Create or edit the parametric VCF geometry after defining materials and frame/cable sections"/>
    <Separator/>
    <MenuItem Header="_Delete" Click="DeleteSelection_Click" InputGestureText="Del" IsEnabled="{Binding CanEditFemModel}" AutomationProperties.Name="Delete"
              ToolTip="Delete the joints, frames and cables selected on the model view (a deleted joint takes its connected members); SAP2000 is unchanged"/>
   </MenuItem>
   <MenuItem Header="_Assign" IsEnabled="{Binding CanEditFemModel}">
    <MenuItem Header="_Joint">
     <MenuItem Header="_Restraints (Pin Supports)…" Tag="3" Click="FemPaneMenu_Click"/>
    </MenuItem>
    <MenuItem Header="_Frame">
     <MenuItem Header="Frame _Sections…" Tag="Frame" Click="AssignSections_Click" AutomationProperties.Name="Assign Frame Sections"
               ToolTip="Assign a frame section to the frames selected on the model view (select them first, as in SAP2000)"/>
     <MenuItem Header="_Local Axes…" Click="AssignFrameAxes_Click" AutomationProperties.Name="Assign Frame Local Axes"
               ToolTip="Rotate the local 2/3 axes of the selected frames and update their in-plane FEM stiffness"/>
    </MenuItem>
    <MenuItem Header="_Cable">
     <MenuItem Header="Cable _Sections…" Tag="Cable" Click="AssignSections_Click" AutomationProperties.Name="Assign Cable Sections"
               ToolTip="Assign a cable section to the cables selected on the model view (select them first, as in SAP2000)"/>
    </MenuItem>
   </MenuItem>
   <MenuItem Header="_Run" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Run _Study" Command="{Binding RunStudyFromToolbar}"
              ToolTip="Validate and run the study from anywhere — jumps to 05 Iteration for the worker monitor and any validation issues"/>
    <MenuItem Header="Cancel Study" Command="{Binding CancelStudy}"/>
    <Separator/>
    <MenuItem Header="Run _FEM Analysis" Command="{Binding RunFemAnalysis}"
              ToolTip="Solve the model as it is defined — one run of the internal 2D frame model. SAP2000 is not read or written. Many cases belong to the parametric study (Optimization VCF)."/>
    <MenuItem Header="_Unlock FEM Model" Command="{Binding UnlockFemModel}"
              ToolTip="Delete this revision's FEM output databases, clear Post-Processing and enable editing"/>
    <MenuItem Header="Cancel FEM Analysis" Command="{Binding CancelFemAnalysis}"/>
    <MenuItem Header="Analysis _Monitor" Click="OpenFemMonitorClick"
              ToolTip="Open analysis progress and cable convergence. Diagnostic details are collapsed by default."/>
    <Separator/>
    <MenuItem Header="Analysis _Options…" Click="AnalysisOptions_Click" AutomationProperties.Name="Analysis Options"/>
   </MenuItem>
   <MenuItem x:Name="ResultMenu" Header="Res_ult" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Show _Deformed Shape…" InputGestureText="F5" Click="ShowDeformedShape_Click" IsEnabled="{Binding HasFemResults}" ToolTip="Choose the load case for the deformed shape"/>
    <MenuItem Header="Show Member _Forces…" InputGestureText="F6" Click="ShowMemberForces_Click" IsEnabled="{Binding HasFemResults}" ToolTip="Choose the load case and N, V or M diagram"/>
    <MenuItem Header="Show _Joint Reactions…" InputGestureText="F7" Click="ShowJointReactions_Click" IsEnabled="{Binding HasFemResults}" ToolTip="Choose the load case for joint reactions"/>
    <Separator/>
    <MenuItem Header="_Axial forces / cables" Tag="AxialForce" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Bending moments" Tag="BendingMoment" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Shear forces" Tag="Shear" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="Support _reactions" Tag="Reactions" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Deflection" Tag="DeflectedShape" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <MenuItem Header="_Cable target fit" Tag="CableFit" Click="FemResultMenu_Click" IsEnabled="{Binding HasFemResults}"/>
    <Separator/>
    <MenuItem Header="Show _Results…" Click="ShowResults_Click" ToolTip="Choose the load case / combo and the output to draw on the model"/>
    <MenuItem Header="Results _Table…" Click="OpenFemResultsClick" IsEnabled="{Binding HasFemResults}"
              ToolTip="Open the results table for the selected load case and output"/>
   </MenuItem>
   <MenuItem Header="_Post-Processing" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Post-Processing (_Optimization)" IsEnabled="False" ToolTipService.ShowOnDisabled="True"
              AutomationProperties.Name="Post-Processing Optimization"
              ToolTip="Multi-candidate optimization reports will use the MB study report engine in a later release.">
     <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D2;" FontSize="14"/></MenuItem.Icon>
    </MenuItem>
    <Separator/>
    <MenuItem Header="_Output Settings" Tag="8" Click="FemPaneMenu_Click"
              ToolTip="Choose result cases, monitored objects and limits for FEM output"/>
    <MenuItem Header="FEM Live Results (_HTML)…" Click="OpenFemHtml_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Open the interactive FEM report: switch load cases and result families, inspect values, zoom and pan without regenerating HTML">
     <MenuItem.Icon><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14"/></MenuItem.Icon>
    </MenuItem>
    <Separator/>
    <MenuItem Header="Study Reports…" Tag="5" Click="MbMenu_Click"/>
   </MenuItem>
   <MenuItem Header="Di_splay" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="Show _Undeformed Shape" InputGestureText="F4" Click="ShowUndeformed_Click" AutomationProperties.Name="Show Undeformed Shape menu"
              ToolTip="Clear the result display (forces, deformed shape, reactions) and show the model; Show Results draws a result again"/>
    <Separator/>
    <MenuItem Header="Frame _mesh" IsCheckable="True" IsChecked="{Binding ShowFemFrameMesh}"
              ToolTip="Draw each frame broken into its FEM mesh segments (Analysis → Frame mesh). Cables are not meshed."/>
    <MenuItem Header="Member _size" IsCheckable="True" IsChecked="{Binding ShowFemMemberSizes}"
              ToolTip="Label each frame and cable with its assigned SAP section."/>
    <MenuItem Header="Frame local _axes" IsCheckable="True" IsChecked="{Binding ShowFrameLocalAxes}"
              ToolTip="Show local 1/2/3 axes of frames; select frames to isolate their axes."/>
    <MenuItem Header="_Dimensions" IsCheckable="True" IsChecked="{Binding ShowDimensions}"
              ToolTip="Dimension the model: bay spans and overall span below it; level heights, overall height and node elevations beside it"/>
    <MenuItem Header="_Loading" IsCheckable="True" IsChecked="{Binding ShowFemLoads}"
              ToolTip="Show the Tab 01 load arrows; with a completed case selected, each arrow is labelled with its Fz."/>
    <Separator/>
    <MenuItem Header="_View Options…" Click="ViewOptions_Click"/>
   </MenuItem>
   <MenuItem Header="Desi_gn" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="_RC Column Design…" Tag="ReinforcedConcrete" Click="DesignMenu_Click" AutomationProperties.Name="RC Column Design"
              ToolTip="Reinforced concrete column design to SS EN 1992-1-1 (EC2) + Singapore NA"/>
    <MenuItem Header="_CFT (Concrete Filled Tube) Design…" Tag="ConcreteFilledTube" Click="DesignMenu_Click" AutomationProperties.Name="CFT Design"
              ToolTip="Concrete filled steel tube column design to SS EN 1994-1-1 + Singapore NA and BCA BC4:2025 (high-strength materials)"/>
    <MenuItem Header="_Steel Encased Composite Column Design…" Tag="SteelEncased" Click="DesignMenu_Click" AutomationProperties.Name="Steel Encased Composite Column Design"
              ToolTip="Concrete-encased steel section column design to SS EN 1994-1-1 + Singapore NA and BCA BC4:2025 (high-strength materials)"/>
    <MenuItem Header="_Mega Composite Column Design…" Tag="MegaComposite" Click="DesignMenu_Click" AutomationProperties.Name="Mega Composite Column Design"
              ToolTip="Several concrete-encased steel profiles: CTBUH / ArcelorMittal (2016) simplified method on SS EN 1994-1-1 6.7.3, high-strength materials per BCA BC4:2025"/>
   </MenuItem>
   <MenuItem Header="_Help">
    <MenuItem Header="_Workflow Help" Click="ShowWorkflowHelp"/>
    <MenuItem Header="_FEM Procedure" Click="ShowFemHelp"/>
    <Separator/>
    <MenuItem Header="_Development Plans" Click="ShowDevelopmentPlans" AutomationProperties.Name="Development Plans"
              ToolTip="What has been built in Mcotis, by whom, where to find it and how it is checked — and what is planned (docs/DEVELOPMENT_LOG.md)"/>
   </MenuItem>
   <!-- Optimization — the parametric study with the internal solver — has a tab of its own: set apart by a separator and
        highlighted (the header template; the Header stays a string, which the window and the checks read). -->
   <Separator x:Name="OptimizationMenuSeparator" Style="{StaticResource MenuBarSeparator}"/>
   <MenuItem x:Name="OptimizationMenu" Header="_Optimization" HeaderTemplate="{StaticResource HighlightedMenuHeader}" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="_Optimization VCF…" Click="OptimizationVcf_Click" AutomationProperties.Name="Optimization VCF"
              ToolTip="Set the VCF search space — min / max / step for bays, bay width, truss depth (middle chord kept at 0.5 × depth), clear height, back-span and back-stay height, and candidate sections per chord, mega column and cable; Run Optimization analyses every combination and lists the max deflection of each case"/>
    <MenuItem Header="Optimization _Results…" Click="OptimizationResults_Click" AutomationProperties.Name="Optimization Results"
              ToolTip="Every case of the last Optimization VCF run with its max deflection (sortable)"/>
    <MenuItem Header="_Cancel Optimization" Click="CancelOptimization_Click" IsEnabled="{Binding IsVcfOptimizationRunning}"/>
   </MenuItem>
   <!-- MB (the SAP2000 study pages) is kept for reference only: last on the bar, set apart by a separator. -->
   <Separator x:Name="MbMenuSeparator" Style="{StaticResource MenuBarSeparator}"/>
   <MenuItem Header="_MB" IsEnabled="{Binding HasUsableModelGeometry}">
    <MenuItem Header="01  Loading" Tag="0" Click="MbMenu_Click" InputGestureText="{Binding LoadStatus}"/>
    <MenuItem Header="02  Truss Height" Tag="1" Click="MbMenu_Click" InputGestureText="{Binding TrussStatus}"/>
    <MenuItem Header="03  Pretension" Tag="2" Click="MbMenu_Click" InputGestureText="{Binding CableStatus}"/>
    <MenuItem Header="04  Output Settings" Tag="3" Click="MbMenu_Click" InputGestureText="{Binding OutputStatus}"/>
    <MenuItem Header="05  Iteration" Tag="4" Click="MbMenu_Click" InputGestureText="{Binding StudyBuildStateText}"/>
    <MenuItem Header="06A  Optimization" Tag="6" Click="MbMenu_Click" InputGestureText="{Binding OptimizationTabStatus}"
              IsEnabled="{Binding HasRawData}" ToolTipService.ShowOnDisabled="True"
              ToolTip="Qualify the stored candidates against acceptance criteria — available once Tab 06 has raw data"/>
    <Separator/>
    <MenuItem Header="08  Quantities" Tag="8" Click="MbMenu_Click" InputGestureText="{Binding QuantityTabStatus}"/>
   </MenuItem>
  </Menu>

  <!-- ============================ TOP BAR ============================ -->
  <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
   <DockPanel>
    <StackPanel x:Name="SapConnectionControls" Visibility="Collapsed" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Content="Connect SAP" Command="{Binding Connect}" Style="{StaticResource Primary}"/>
     <Button Command="{Binding Refresh}" Style="{StaticResource IconButton}" ToolTip="Refresh connection and geometry">
      <Viewbox Width="15" Height="15"><Path Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M14,5 A6,6 0 1 0 16,11 M16,11 L16,6 M16,11 L11,11"/></Viewbox>
     </Button>
    </StackPanel>
    <Grid VerticalAlignment="Center">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" MaxWidth="300"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" MaxWidth="260"/><ColumnDefinition Width="*"/>
     </Grid.ColumnDefinitions>
     <!-- Tool icons (ETABS-like): file · run · zoom · projection · view options. Same commands as the menus. -->
     <StackPanel x:Name="TopToolbar" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="Toolbar">
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8A5;" Command="{Binding NewConfig}" ToolTip="New Config (File → New Config)" AutomationProperties.Name="New Config"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8E5;" Command="{Binding LoadFemModel}" ToolTip="Open — Load MCOTiS Config (File → Load Config)" AutomationProperties.Name="Load Config"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE74E;" Command="{Binding SaveFemModel}" ToolTip="Save MCOTiS Config (File → Save Config · Ctrl+S)" AutomationProperties.Name="Save Config"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE792;" Command="{Binding SaveFemModelAs}" ToolTip="Save MCOTiS Config As… — under another file name (File → Save Config As · Ctrl+Shift+S)" AutomationProperties.Name="Save Config As"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE749;" Command="{Binding PrintAllReports}" ToolTip="Print All Reports (06 Post-Processing; available once the reports exist)" AutomationProperties.Name="Print All Reports"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarButton}" Content="{Binding FemLockGlyph}" Command="{Binding ToggleFemModelLock}"
              ToolTip="{Binding FemLockActionText}" AutomationProperties.Name="Lock or unlock FEM model"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE768;" Command="{Binding RunFemAnalysis}" ToolTip="Run FEM Analysis (Run → Run FEM Analysis)" AutomationProperties.Name="Run FEM Analysis"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE713;" Click="AnalysisOptions_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="Analysis Options (Run → Analysis Options)" AutomationProperties.Name="Analysis Options"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE9D9;" Click="OpenFemMonitorClick" ToolTip="Analysis Monitor (Run → Analysis Monitor)" AutomationProperties.Name="Analysis Monitor"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <!-- SAP2000-style tools: Select (default — a click selects joints / members, a drag draws a window) and Pan -->
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" IsEnabled="{Binding ShowSharedViewer}"
                    IsChecked="{Binding PanMode, ElementName=SharedViewer, Converter={x:Static p:InverseBoolConverter.Instance}}"
                    ToolTip="Select (V, default) — left-click a point, frame or cable to select it (again to deselect), right-click it for its information; drag a window: left to right selects what is inside, right to left also what it crosses. Works in the 3D view too. Esc clears the selection."
                    Click="SelectTool_Click" AutomationProperties.Name="Select">
       <Path Data="M3,1 L3,14 L6.4,10.8 L8.8,15.5 L10.9,14.5 L8.5,9.9 L13,9.9 Z" Fill="{StaticResource Accent}" Stroke="{StaticResource Accent}" StrokeThickness="0.6" StrokeLineJoin="Round"/>
      </ToggleButton>
      <ToggleButton Style="{StaticResource ToolbarDrawingToggle}" IsEnabled="{Binding ShowSharedViewer}" IsChecked="{Binding PanMode, ElementName=SharedViewer}"
                    ToolTip="Pan — drag to move the model (the middle mouse button always pans). V or Select returns to selecting."
                    AutomationProperties.Name="Pan">
       <!-- four-way move arrows -->
       <Path Data="M8,0.5 L10.6,3.4 L8.9,3.4 L8.9,7.1 L12.6,7.1 L12.6,5.4 L15.5,8 L12.6,10.6 L12.6,8.9 L8.9,8.9 L8.9,12.6 L10.6,12.6 L8,15.5 L5.4,12.6 L7.1,12.6 L7.1,8.9 L3.4,8.9 L3.4,10.6 L0.5,8 L3.4,5.4 L3.4,7.1 L7.1,7.1 L7.1,3.4 L5.4,3.4 Z"
             Fill="{StaticResource Accent}"/>
      </ToggleButton>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE894;" Click="ClearSelection_Click" IsEnabled="{Binding ShowSharedViewer}" FontSize="12"
              ToolTip="Clear Selection (Esc)" AutomationProperties.Name="Clear Selection"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE9A6;" Click="ToolbarFit_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Zoom extents / fit (Home)" AutomationProperties.Name="Zoom extents"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE8A3;" Tag="1.25" Click="ToolbarZoom_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Zoom in (+)" AutomationProperties.Name="Zoom in"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE71F;" Tag="0.8" Click="ToolbarZoom_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Zoom out (−)" AutomationProperties.Name="Zoom out"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="3-d" Tag="3D" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="3D view — isometric, members to their SAP section size" AutomationProperties.Name="3D view"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="xy" Tag="XY" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Plan view (XY)" AutomationProperties.Name="XY view"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="xz" Tag="XZ" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Elevation view (XZ)" AutomationProperties.Name="XZ view"/>
      <Button Style="{StaticResource ToolbarTextButton}" Content="yz" Tag="YZ" Click="ToolbarPlane_Click" IsEnabled="{Binding ShowSharedViewer}" ToolTip="Elevation view (YZ)" AutomationProperties.Name="YZ view"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowUndeformed_Click" IsEnabled="{Binding HasUsableModelGeometry}"
              ToolTip="Show Undeformed Shape — clear the result display and show the model (Display → Show Undeformed Shape, F4)" AutomationProperties.Name="Show Undeformed Shape">
       <!-- SAP2000's icon: a portal frame in a box -->
       <Canvas Width="16" Height="16">
        <Rectangle Width="16" Height="16" Stroke="{StaticResource Accent}" StrokeThickness="1"/>
        <Path Data="M4,13.5 L4,4 L12,4 L12,13.5" Stroke="{StaticResource Accent}" StrokeThickness="1.6" StrokeLineJoin="Miter"/>
       </Canvas>
      </Button>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE890;" Click="ViewOptions_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="View Options (Display → View Options)" AutomationProperties.Name="View Options"/>
      <Button Style="{StaticResource ToolbarButton}" Content="&#xE9D2;" Click="ShowResults_Click" IsEnabled="{Binding HasUsableModelGeometry}" ToolTip="Show Results — choose the load case / combo and the output to draw on the model" AutomationProperties.Name="Show Results"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowDeformedShape_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Show Deformed Shape (F5) — choose load case" AutomationProperties.Name="Show Deformed Shape F5">
       <Canvas Width="16" Height="16">
        <Path Data="M2,13 L2,3 L14,3 L14,13" Stroke="{StaticResource ViewportEdge}" StrokeThickness="1" StrokeDashArray="2,2"/>
        <Path Data="M2,13 C3,7 4,5 8,4 C12,4 13,8 14,13" Stroke="{StaticResource AccentBright}" StrokeThickness="1.8" Fill="Transparent"/>
       </Canvas>
      </Button>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowMemberForces_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Show Member Forces (F6) — choose load case and N, V or M" AutomationProperties.Name="Show Member Forces F6">
       <Canvas Width="18" Height="18">
        <!-- Filled bending-moment regions of a two-storey planar frame. -->
        <Path Data="M2,2 C5,2 5,6 9,6 C13,6 13,2 16,2 Z M2,9 C5,9 6,12.5 9,12.5 C12,12.5 13,9 16,9 Z M2,2 C4,4 4,7 2,9 Z M2,9 C4,11 4,14 2,16 Z M16,2 C14,4 14,7 16,9 Z M16,9 C14,11 14,14 16,16 Z"
              Fill="{StaticResource Warning}" Opacity="0.32"/>
        <Path Data="M2,2 C5,2 5,6 9,6 C13,6 13,2 16,2 M2,9 C5,9 6,12.5 9,12.5 C12,12.5 13,9 16,9 M2,2 C4,4 4,7 2,9 M2,9 C4,11 4,14 2,16 M16,2 C14,4 14,7 16,9 M16,9 C14,11 14,14 16,16"
              Stroke="{StaticResource Warning}" StrokeThickness="1.1" Fill="Transparent"/>
        <Path Data="M2,16 L2,2 L16,2 L16,16 M2,9 L16,9" Stroke="{StaticResource Accent}" StrokeThickness="1.4" Fill="Transparent"/>
       </Canvas>
      </Button>
      <Button Style="{StaticResource ToolbarDrawingButton}" Click="ShowJointReactions_Click" IsEnabled="{Binding HasFemResults}"
              ToolTip="Show Joint Reactions (F7) — choose load case" AutomationProperties.Name="Show Joint Reactions F7">
       <Canvas Width="16" Height="16">
        <Path Data="M2,13 L8,7 L14,13 Z M1,14 L15,14" Stroke="{StaticResource Accent}" StrokeThickness="1.3" Fill="Transparent"/>
        <Path Data="M8,7 L8,1 M8,1 L5.5,4 M8,1 L10.5,4" Stroke="{StaticResource AccentBright}" StrokeThickness="1.6" Fill="Transparent"/>
       </Canvas>
      </Button>
     </StackPanel>
    </Grid>
   </DockPanel>
  </Border>

  <!-- ========================== STATUS BAR ========================== -->
  <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
   <StackPanel>
    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,4"/>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding State.Units}" Style="{StaticResource MonoSmall}" Margin="16,0,0,0"/>
     <!-- what is selected on the model view (2D or 3D), by kind of object -->
     <TextBlock x:Name="SelectionStatus" DockPanel.Dock="Right" Style="{StaticResource MonoSmall}" Margin="16,0,0,0" Text="Selected: 0 Frames · 0 Cables · 0 Points · 0 Shells"
                ToolTip="The frames, cables, points and shells selected on the model view" AutomationProperties.Name="Selection" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
   </StackPanel>
  </Border>

  <!-- ============ WORKFLOW TABS (params) + SHARED MODEL PREVIEW ============ -->
  <Grid>
   <Grid.ColumnDefinitions>
    <ColumnDefinition x:Name="ParamsColumn" Width="2*" MinWidth="150"/>
    <ColumnDefinition x:Name="ViewerSplitterColumn" Width="Auto"/>
    <ColumnDefinition x:Name="ViewerColumn" Width="3*"/>
   </Grid.ColumnDefinitions>

  <!-- The page chosen from the menu bar (MB, Define, Assign, Run, Result, Display) fills this pane; the tab rail is hidden. -->
  <DockPanel Grid.Column="0">
   <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,5">
    <StackPanel>
     <DockPanel>
      <Button x:Name="ClosePaneButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Content="&#xE711;" FontSize="11" Width="22" Height="22"
              Margin="8,0,0,0" Click="ClosePane_Click" Visibility="{Binding ShowSharedViewer, Converter={StaticResource BoolVisibility}}"
              ToolTip="Close this pane — the model view takes the full width; any menu item opens a pane again" AutomationProperties.Name="Close pane"/>
      <TextBlock DockPanel.Dock="Right" Text="{Binding PaneStatus}" ToolTip="{Binding PaneStatus}" Style="{StaticResource TabHeaderStatus}" VerticalAlignment="Center"
                 MaxWidth="320" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
      <TextBlock x:Name="PaneHeader" Style="{StaticResource TabHeaderTitle}" VerticalAlignment="Center" AutomationProperties.Name="Current pane">
       <Run Text="{Binding PaneMenu, Mode=OneWay}" Foreground="{StaticResource Muted}"/><Run Text="  ›  " Foreground="{StaticResource Muted}"/><Run Text="{Binding PaneTitle, Mode=OneWay}"/>
      </TextBlock>
     </DockPanel>
     <TextBlock Text="{Binding OfflineModelSummary}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                Visibility="{Binding IsOfflineModel, Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
   </Border>
  <TabControl x:Name="WorkflowTabs" SelectedIndex="{Binding SelectedTab}" SelectionChanged="WorkflowTabs_SelectionChanged" IsEnabled="{Binding HasUsableModelGeometry}" TabStripPlacement="Left" Background="{StaticResource Background}" BorderThickness="0" Padding="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <TabControl.ItemContainerStyle>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Visibility" Value="Collapsed"/></Style>
   </TabControl.ItemContainerStyle>

   <!-- 01 LOADING CRITERIA -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="01  LOADING" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding LoadStatus}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <Grid IsEnabled="{Binding IsIdle}">
      <Grid.RowDefinitions><RowDefinition Height="44*"/><RowDefinition Height="8"/><RowDefinition Height="56*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
       <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="{Binding AppliedPointsTitle}" Style="{StaticResource Subheading}"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
         <Button Content="+ Add" Command="{Binding AddPoints}" ToolTip="Add load locations from model geometry"/>
         <Button Content="&#8722; Remove" Command="{Binding RemoveAppliedPoints}" CommandParameter="{Binding SelectedItems, ElementName=AppliedPointsGrid}"/>
        </WrapPanel>
        <DataGrid x:Name="AppliedPointsGrid" Grid.Row="2" ItemsSource="{Binding State.AppliedPoints}" SelectedItem="{Binding SelectedAppliedPoint, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" SelectionChanged="AppliedPoints_SelectionChanged" CanUserDeleteRows="False">
         <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Order}" IsReadOnly="True" Width=".4*" MinWidth="34" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="Point" Binding="{Binding PointName}" IsReadOnly="True" Width="1.2*" MinWidth="80"/>
          <DataGridTextColumn Header="X [m]" Binding="{Binding X, StringFormat=F3}" IsReadOnly="True" Width=".8*" MinWidth="62" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="Z [m]" Binding="{Binding Z, StringFormat=F3}" IsReadOnly="True" Width=".8*" MinWidth="62" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1*" MinWidth="76"/>
         </DataGrid.Columns>
        </DataGrid>
       </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
       <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="LOAD DEFINITION" Style="{StaticResource Subheading}"/>
        <Grid Grid.Row="1" Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Grid.Column="0" Text="Trib. width B" VerticalAlignment="Top" Margin="0,5,6,0"/>
         <c:EngineeringInput Grid.Column="1" Width="118" Label="" AutomationProperties.Name="Out-of-plane tributary width B" Value="{Binding State.TributaryWidthB}" Unit="m" Minimum="0.000000001" Margin="0"/>
         <TextBlock Grid.Column="3" Text="NStories" VerticalAlignment="Top" Margin="0,5,6,0"/>
         <c:EngineeringInput Grid.Column="4" Width="96" Label="" AutomationProperties.Name="Number of stories" Value="{Binding State.NumberOfStories}" Unit="" Minimum="1" Maximum="2147483647" Increment="1" WholeNumbersOnly="True" Margin="0"/>
         <Button Grid.Column="6" Content="View Candidates" Click="ViewCandidates_Click" VerticalAlignment="Top" Margin="6,0,0,0"/>
        </Grid>
        <DataGrid x:Name="LoadDefinitionsGrid" Grid.Row="2" ItemsSource="{Binding State.LoadDefinitions}" IsEnabled="{Binding IsIdle}" CanUserDeleteRows="False" SelectionMode="Single" FrozenColumnCount="0">
         <DataGrid.Resources>
          <Style x:Key="LoadValueEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
           <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="TextAlignment" Value="Right"/>
           <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger></Style.Triggers>
          </Style>
         </DataGrid.Resources>
         <DataGrid.Columns>
          <DataGridTemplateColumn Header="Load Pattern" Width="1.4*" MinWidth="110">
           <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
             <ComboBox ItemsSource="{Binding DataContext.State.LoadPatterns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                       SelectedItem="{Binding LoadName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       IsEditable="False" BorderThickness="0" Padding="5,0" Background="Transparent"/>
            </DataTemplate>
           </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Width="46" MinWidth="46"><DataGridTemplateColumn.Header><TextBlock Text="Incr?" ToolTip="Apply increment step"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ApplyIncrementStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="qz [kPa]" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding IsSingleValue}" Text="{Binding Qz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Min qz" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding MinQz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Max qz" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding MaxQz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Step" Width=".7*" MinWidth="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding IncrementStep, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Width="34" MinWidth="34"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding DataContext.DeleteLoadDefinition, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete load definition" Width="24" Height="22" MinHeight="22" Padding="5" Margin="0" Background="Transparent" BorderThickness="0"><Viewbox Width="11" Height="11"><Path Stroke="{StaticResource Error}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14 M14,2 L2,14"/></Viewbox></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
         <Button DockPanel.Dock="Right" Content="Save Config" Command="{Binding SaveTabConfig}" CommandParameter="Loading" ToolTip="Save only this tab's loading configuration to a JSON file" Margin="0"/>
         <Button Content="+ Add Load" Command="{Binding AddLoadDefinition}" Click="AddLoad_Click" HorizontalAlignment="Left"/>
        </DockPanel>
       </Grid>
      </Border>
     </Grid>
   </TabItem>

   <!-- 02 TRUSS HEIGHT -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="02  TRUSS HEIGHT" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding TrussStatus}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel IsEnabled="{Binding IsIdle}" Margin="2,2,0,0">
       <TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,0,0,8"/>

       <Grid Margin="0,0,0,2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="POINT GROUPS" Style="{StaticResource Subheading}" Margin="0"/>
        <TextBlock Grid.Column="1" Text="REF." Style="{StaticResource Subheading}" Margin="0" HorizontalAlignment="Right"
                  ToolTip="Selected chord elevation remains fixed while generating truss-height candidates."/>
       </Grid>

       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
         <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource ChordTop}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Top chord" FontWeight="SemiBold"/></StackPanel>
         <TextBlock Text="{Binding TopSummary}" Foreground="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>
        <Button Grid.Row="0" Grid.Column="1" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Top" Margin="6,0,6,6" VerticalAlignment="Center"/>
        <RadioButton Grid.Row="0" Grid.Column="2" GroupName="TrussRef" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"
                    IsChecked="{Binding State.Truss.Reference, Converter={StaticResource EnumMatch}, ConverterParameter=Top}"
                    ToolTip="Top chord elevation stays fixed while generating candidates."/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
         <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource ChordMiddle}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Middle" FontWeight="SemiBold"/></StackPanel>
         <TextBlock Text="{Binding MiddleSummary}" Foreground="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>
        <Button Grid.Row="1" Grid.Column="1" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Middle" Margin="6,0,6,6" VerticalAlignment="Center"/>
        <RadioButton Grid.Row="1" Grid.Column="2" GroupName="TrussRef" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"
                    IsChecked="{Binding State.Truss.Reference, Converter={StaticResource EnumMatch}, ConverterParameter=Middle}"
                    ToolTip="Middle chord elevation stays fixed while generating candidates."/>

        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
         <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource ChordBottom}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="Bottom chord" FontWeight="SemiBold"/></StackPanel>
         <TextBlock Text="{Binding BottomSummary}" Foreground="{StaticResource Muted}" FontSize="11"/>
        </StackPanel>
        <Button Grid.Row="2" Grid.Column="1" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Bottom" Margin="6,0,6,6" VerticalAlignment="Center"/>
        <RadioButton Grid.Row="2" Grid.Column="2" GroupName="TrussRef" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,6"
                    IsChecked="{Binding State.Truss.Reference, Converter={StaticResource EnumMatch}, ConverterParameter=Bottom}"
                    ToolTip="Bottom chord elevation stays fixed while generating candidates."/>
       </Grid>

       <TextBlock Text="{Binding GroupWarning}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" FontSize="11" Margin="0,2,0,6"/>
       <Button Content="Capture Baseline" Command="{Binding CaptureBaseline}" HorizontalAlignment="Left" Margin="0,0,0,4"
              ToolTip="Freeze the selected chord coordinates and truss height H&#8320; as the immutable reference for every candidate."/>
       <TextBlock Text="{Binding BaselineStatus}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Success}" Margin="0,0,0,12"/>

       <TextBlock Text="HEIGHT RANGE" Style="{StaticResource Subheading}"/>
       <c:EngineeringInput Label="Minimum height" Value="{Binding State.Truss.MinimumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Maximum height" Value="{Binding State.Truss.MaximumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Increment step" Value="{Binding State.Truss.Increment}" Unit="{Binding LengthUnit}"/>
       <Grid Margin="0,2,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Generated candidates" Foreground="{StaticResource Muted}"/>
        <TextBlock Grid.Column="1" Text="{Binding CandidateCountText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
       </Grid>
       <TextBlock Text="{Binding CandidateWarning}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" FontSize="10.5" Margin="0,2,0,10"/>

       <TextBlock Text="PREVIEW" Style="{StaticResource Subheading}"/>
       <c:EngineeringInput Label="Preview height" Value="{Binding State.Truss.CurrentHeight}" Unit="{Binding LengthUnit}"/>
       <Slider Minimum="{Binding State.Truss.MinimumHeight}" Maximum="{Binding State.Truss.MaximumHeight}" TickFrequency="{Binding State.Truss.Increment}" Value="{Binding State.Truss.CurrentHeight}" Margin="0,4,0,4" AutomationProperties.Name="Preview truss height"/>
       <TextBlock Text="{Binding PreviewDelta}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
       <StackPanel Orientation="Horizontal">
        <Button Content="Reset Preview" Command="{Binding ResetPreview}"/>
        <Button Content="View Candidates" Click="ViewTrussCandidates_Click" Style="{StaticResource Primary}"
               IsEnabled="{Binding CanViewTrussCandidates}" ToolTip="{Binding TrussCandidatesHint}"/>
       </StackPanel>
       <Button Content="Save Config" Command="{Binding SaveTabConfig}" CommandParameter="Truss" HorizontalAlignment="Left" Margin="0,8,0,0"
              ToolTip="Save only this tab's truss-height configuration to a JSON file"/>
      </StackPanel>
    </ScrollViewer>
   </TabItem>

   <!-- 03 CABLE PRETENSION -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="03  PRETENSION" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding CableStatus}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <Grid IsEnabled="{Binding IsIdle}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,4">
       <Button DockPanel.Dock="Right" Content="Save Config" Command="{Binding SaveTabConfig}" CommandParameter="Cable"
               ToolTip="Save only this tab's cable-pretension configuration to a JSON file" Margin="0"/>
       <StackPanel Orientation="Horizontal">
        <Button Content="+ Add Cable" Command="{Binding AddCables}" ToolTip="Pick cable objects from the loaded SAP2000 model"/>
        <Button Content="&#8722; Remove" Command="{Binding RemoveCables}" CommandParameter="{Binding SelectedItems, ElementName=Cables}"/>
        <Button x:Name="RefreshCableSectionsButton" Command="{Binding RefreshCableSections}" Style="{StaticResource IconButton}"
                Margin="8,0,0,0" ToolTip="Refresh cable sections, areas, and design capacities from SAP2000"
                AutomationProperties.Name="Refresh cable sections and areas">
          <Viewbox Width="15" Height="15"><Path Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M14,5 A6,6 0 1 0 16,11 M16,11 L16,6 M16,11 L11,11"/></Viewbox>
         </Button>
        </StackPanel>
      </DockPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,3">
       <TextBlock Text="Cables" Foreground="{StaticResource Muted}" FontSize="11"/>
       <TextBlock Text="{Binding CableCount}" FontWeight="SemiBold" FontSize="11" Margin="4,0,14,0"/>
       <TextBlock Text="Variable" Foreground="{StaticResource Muted}" FontSize="11"/>
       <TextBlock Text="{Binding VariableCableCount}" FontWeight="SemiBold" FontSize="11" Margin="4,0,14,0"/>
       <TextBlock Text="Candidates" Foreground="{StaticResource Muted}" FontSize="11"/>
       <TextBlock Text="{Binding PretensionCandidateCount}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}" Margin="6,0,14,0"/>
       <TextBlock Text="{Binding SyncGroupSummary}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
       <Border Width="1" Background="{StaticResource Border}" Margin="12,1,12,1"/>
       <TextBlock Text="Design capacity =" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                  ToolTip="Each cable's read-only design capacity = section area × fpu × 1000 × φ [kN]. After changing fpu or φ, press Generate Outputs / Regenerate on Tab 06 to use the new capacity — no SAP2000 re-run."/>
       <TextBlock Text="fpu" FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
       <TextBox Width="52" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                ToolTip="Cable material strength [MPa] — Grade 1860 strand by default"
                Text="{Binding CableStrengthMpa, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}, ValidatesOnExceptions=True}"/>
       <TextBlock Text="MPa  ·  φ" FontSize="11" VerticalAlignment="Center" Margin="4,0,2,0"/>
       <TextBox Width="40" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"
                ToolTip="Strength-reduction coefficient φ (0 &lt; φ ≤ 1), default 0.5"
                Text="{Binding CableStrengthReductionFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.###}, ValidatesOnExceptions=True}"/>
      </StackPanel>
      <TextBlock Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="10.5" Margin="0,0,0,6" TextWrapping="Wrap"
               Text="{Binding ForceUnit, StringFormat=Define Cable Target Force candidates by SAP load pattern · forces in [{0}] · editing does not modify SAP2000}"/>

      <DataGrid x:Name="Cables" Grid.Row="3" ItemsSource="{Binding State.Cables}" SelectedItem="{Binding SelectedCable, Mode=TwoWay}"
                SelectionChanged="Cables_SelectionChanged" SelectionMode="Extended" IsEnabled="{Binding IsIdle}"
                CanUserDeleteRows="False" FrozenColumnCount="1" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Resources>
       <Style x:Key="ForceEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="TextAlignment" Value="Right"/>
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger></Style.Triggers>
       </Style>
       <Style x:Key="DerivedCableCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
       </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Cable" Binding="{Binding CableName}" IsReadOnly="True" Width="1.1*" MinWidth="80"/>
       <DataGridTemplateColumn Header="Load Pattern" Width="1.3*" MinWidth="120">
        <DataGridTemplateColumn.CellTemplate>
         <DataTemplate>
          <ComboBox IsEditable="True" BorderThickness="0" Background="Transparent" Padding="4,0" MinHeight="0" VerticalContentAlignment="Center"
                    ToolTip="SAP2000 load pattern the target force is assigned to"
                    ItemsSource="{Binding DataContext.State.LoadPatterns, RelativeSource={RelativeSource AncestorType=Window}}"
                    Text="{Binding LoadPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
         </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Width="2.5*" MinWidth="230">
        <DataGridTemplateColumn.Header><TextBlock Text="Sync" ToolTip="Independent = its own Cartesian axis. Same Values = copies the reference's candidate values. Same Step = own Min / Max, spacing derived to match the reference's count. Same Ratio / Same Offset = reference × k or + Δ. Chains resolve to the Independent root; followers never add a Cartesian dimension."/></DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellStyle>
         <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
          <Setter Property="Background" Value="#EFF5FD"/>
          <Style.Triggers>
           <DataTrigger Binding="{Binding SyncProblem, Converter={StaticResource NonEmpty}}" Value="True">
            <Setter Property="Background" Value="#FDECEC"/>
            <Setter Property="ToolTip" Value="{Binding SyncProblem}"/>
           </DataTrigger>
          </Style.Triggers>
         </Style>
        </DataGridTemplateColumn.CellStyle>
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,1" ToolTip="{Binding SyncPreview}">
          <ComboBox Width="104" MinHeight="0" Padding="4,0" VerticalContentAlignment="Center"
                    ItemsSource="{Binding DataContext.CableSyncModes, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding SyncMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
           <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource SyncModeLabel}}"/></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox MinWidth="80" MinHeight="0" Padding="4,0" Margin="4,0,0,0" VerticalContentAlignment="Center"
                    Visibility="{Binding CanPickReference, Converter={StaticResource BoolVisibility}}"
                    ItemsSource="{Binding DataContext.CableSyncReferenceOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                    SelectedItem="{Binding ReferenceCableName, Mode=TwoWay, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"/>
          <TextBox Width="52" Margin="4,0,0,0" Style="{StaticResource ForceEditor}" TextAlignment="Left"
                   Visibility="{Binding CanEditFactor, Converter={StaticResource BoolVisibility}}"
                   ToolTip="k for Same Ratio, Δ [kN] for Same Offset"
                   Text="{Binding SyncFactor, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/>
         </StackPanel>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Width="58" MinWidth="58">
        <DataGridTemplateColumn.Header><TextBlock Text="Range" ToolTip="Apply a Min / Max / Step range instead of a fixed target force"/></DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ApplyRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanToggleRange}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Target Force" Width=".95*" MinWidth="82">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource ForceEditor}" IsEnabled="{Binding CanEditTarget}" Text="{Binding TargetForce, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Min Force" Width=".85*" MinWidth="74">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource ForceEditor}" IsEnabled="{Binding CanEditRange}" Text="{Binding MinForce, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Max Force" Width=".85*" MinWidth="74">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource ForceEditor}" IsEnabled="{Binding CanEditRange}" Text="{Binding MaxForce, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Step Force" Width=".8*" MinWidth="70">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource ForceEditor}" IsEnabled="{Binding CanEditStepForce}" Text="{Binding StepForce, Mode=TwoWay, UpdateSourceTrigger=LostFocus, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Binding="{Binding SectionName, Mode=OneWay}" IsReadOnly="True" Width=".9*" MinWidth="76" CellStyle="{StaticResource DerivedCableCell}">
        <DataGridTextColumn.Header><TextBlock Text="Section" ToolTip="SAP cable-section property assigned to this cable — read straight from the model, not editable"/></DataGridTextColumn.Header>
       </DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding SectionAreaM2, Mode=OneWay, StringFormat={}{0:0.######}}" IsReadOnly="True" Width=".8*" MinWidth="72" ElementStyle="{StaticResource NumericCell}" CellStyle="{StaticResource DerivedCableCell}">
        <DataGridTextColumn.Header><TextBlock Text="Area m²" ToolTip="Cross-section area from the SAP cable section — read straight from the model, not editable"/></DataGridTextColumn.Header>
       </DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding DesignCapacityKN, Mode=OneWay, StringFormat={}{0:0.####}}" IsReadOnly="True" Width=".95*" MinWidth="86" ElementStyle="{StaticResource NumericCell}" CellStyle="{StaticResource DerivedCableCell}">
        <DataGridTextColumn.Header><TextBlock Text="Capacity kN" ToolTip="Calculated read-only as section area × fpu × 1000 × φ. Changing fpu or φ refreshes this value."/></DataGridTextColumn.Header>
       </DataGridTextColumn>
       <DataGridTextColumn Header="Candidates" Binding="{Binding CandidateSummary}" IsReadOnly="True" Width=".7*" MinWidth="72" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1.1*" MinWidth="96"/>
      </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="4" Text="Total candidates = product of the Independent cables' candidate counts. Same Values / Same Step followers are zipped, not multiplied. Assignment happens later in Run." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    </Grid>
   </TabItem>

   <!-- 04 OUTPUT SETTINGS -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="04  OUTPUT SETTINGS" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding OutputStatus}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <Grid IsEnabled="{Binding IsIdle}" Margin="2,2,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid.Resources>
      <Style x:Key="OutRule" TargetType="Border"><Setter Property="Height" Value="1"/><Setter Property="Background" Value="{StaticResource Border}"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
      <Style x:Key="OutSummary" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
      <Style x:Key="OutStatus" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
      <Style x:Key="OutEdit" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="12,2"/><Setter Property="Margin" Value="0"/></Style>
      <Style x:Key="BandEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="6,1"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextAlignment" Value="Right"/></Style>
     </Grid.Resources>

     <StackPanel Grid.Row="0" Margin="0,0,0,6">
      <TextBlock Text="OUTPUT SETTINGS" Style="{StaticResource Subheading}" Margin="0"/>
      <TextBlock Text="Study-wide outputs for all candidates" FontSize="10.5" Foreground="{StaticResource Muted}"/>
      <TextBlock FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding BaselineModelPath}">
       <Run Text="Baseline: " Foreground="{StaticResource Muted}"/><Run Text="{Binding BaselineModelName, Mode=OneWay}" FontWeight="SemiBold"/>
      </TextBlock>
     </StackPanel>

     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
      <StackPanel>
       <Border Style="{StaticResource OutRule}" Margin="0,2,0,8"/>

       <TextBlock Text="01  MONITORED POINTS" Style="{StaticResource Subheading}" Margin="0"/>
       <TextBlock Text="{Binding MonitoredPointCaseSummary}" Style="{StaticResource OutSummary}" ToolTip="{Binding MonitoredPointCaseSummary}"/>
       <TextBlock Text="{Binding MonitoredPointSummary}" Style="{StaticResource OutSummary}" Margin="0,1,0,0"/>
       <!-- Deflection limit band: post-processing only (Deflection report band + Tab 06A deflection criterion). Blank = open bound. -->
       <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Limit band ↓U3" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                   ToolTip="Acceptance window on each candidate's peak downward deflection. A candidate passes when Min ≤ peak ↓U3 ≤ Max. Leave a bound blank to keep it open."/>
        <TextBox Grid.Column="1" Style="{StaticResource BandEditor}" AutomationProperties.Name="Deflection limit band minimum [mm]"
                 ToolTip="Min peak downward deflection [mm] — blank = no lower limit"
                 Text="{Binding State.OutputSettings.DeflectionLimitMinMm, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
        <TextBlock Grid.Column="2" Text="–" FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
        <TextBox Grid.Column="3" Style="{StaticResource BandEditor}" AutomationProperties.Name="Deflection limit band maximum [mm]"
                 ToolTip="Max peak downward deflection [mm] — blank = no upper limit"
                 Text="{Binding State.OutputSettings.DeflectionLimitMaxMm, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
        <TextBlock Grid.Column="4" Text="mm" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
       </Grid>
       <TextBlock Text="{Binding DeflectionLimitSummary}" Style="{StaticResource OutStatus}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeflectionLimitSummary}"/>
       <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding MonitoredPointStatus}" Style="{StaticResource OutStatus}"/>
        <Button Grid.Column="1" Content="Edit" Command="{Binding ConfigureDeflectionOutput}" Style="{StaticResource OutEdit}"/>
       </Grid>
       <Border Style="{StaticResource OutRule}"/>

       <TextBlock Text="02  MEMBER FORCES" Style="{StaticResource Subheading}" Margin="0"/>
       <TextBlock Text="{Binding MemberForceSummary}" Style="{StaticResource OutSummary}"/>
       <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding MemberForceStatus}" Style="{StaticResource OutStatus}"/>
        <Button Grid.Column="1" Content="Edit" Command="{Binding ConfigureMemberForceOutput}" Style="{StaticResource OutEdit}"/>
       </Grid>
       <Border Style="{StaticResource OutRule}"/>

       <TextBlock Text="03  FOUNDATION REACTIONS" Style="{StaticResource Subheading}" Margin="0"/>
       <TextBlock Text="{Binding FoundationSummary}" Style="{StaticResource OutSummary}"/>
       <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding FoundationStatus}" Style="{StaticResource OutStatus}"/>
        <Button Grid.Column="1" Content="Edit" Command="{Binding ConfigureFoundationOutput}" Style="{StaticResource OutEdit}"/>
       </Grid>
       <Border Style="{StaticResource OutRule}"/>

       <TextBlock Text="04  CABLE FORCES" Style="{StaticResource Subheading}" Margin="0"/>
       <TextBlock Text="{Binding CableForceSummary}" Style="{StaticResource OutSummary}"/>
       <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding CableForceStatus}" Style="{StaticResource OutStatus}"/>
        <Button Grid.Column="1" Content="Edit" Command="{Binding ConfigureCableOutput}" Style="{StaticResource OutEdit}"/>
       </Grid>
       <Border Style="{StaticResource OutRule}"/>
      </StackPanel>
     </ScrollViewer>

     <StackPanel Grid.Row="2" Margin="0,6,0,0">
      <TextBlock Text="OUTPUT UNITS" Style="{StaticResource Subheading}"/>
      <TextBlock Text="{Binding OutputUnitsSummary}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,8"/>
      <TextBlock Text="{Binding ConfiguredOutputCount}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <Button Content="Validate Output Settings" Command="{Binding ValidateOutputSettings}" Style="{StaticResource Primary}" HorizontalContentAlignment="Center"/>
      <Button Content="Save Config" Command="{Binding SaveTabConfig}" CommandParameter="Output" HorizontalContentAlignment="Center" Margin="0,6,0,0"
              ToolTip="Save Tab 04 Output Settings into the active project"/>
     </StackPanel>
    </Grid>
   </TabItem>

   <!-- 05 ITERATION STUDY -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="05  ITERATION" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding StudyBuildStateText}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <Grid>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="520"/></Grid.ColumnDefinitions>

      <Grid Grid.Column="0" IsEnabled="{Binding IsIdle}" TextElement.FontSize="11">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

       <!-- ZONE · Candidate definitions — scrolls inside its own box -->
       <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Padding="8" Margin="0,0,10,0" MinHeight="120">
        <DockPanel>
         <DockPanel.Resources>
           <Style x:Key="DefExp" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
           </Style>
           <Style x:Key="DefRowId" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
           </Style>
           <Style x:Key="DefRowVal" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
           </Style>
           <Style x:Key="DefColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="10.5"/>
           </Style>
         </DockPanel.Resources>

         <TextBlock DockPanel.Dock="Top" Text="CANDIDATE DEFINITIONS" Style="{StaticResource Subheading}"/>
         <TextBlock DockPanel.Dock="Top" Text="The preview grid shows IDs only — expand a list to see what each ID means. Hovering a grid cell also shows its definition." Style="{StaticResource Hint}"/>
         <Border DockPanel.Dock="Top" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="6,3" Margin="0,0,0,6">
          <TextBlock Text="{Binding SelectedCandidateBreadcrumb}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
         </Border>

         <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
          <Expander Style="{StaticResource DefExp}" IsExpanded="True">
           <Expander.Header>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="Loading Candidates" FontWeight="SemiBold" VerticalAlignment="Center"/>
             <c:LatexTextBlock Grid.Column="1" Formula="N_L" Style="{StaticResource Formula}" Margin="6,0" VerticalAlignment="Center"/>
             <TextBlock Grid.Column="2" Text="{Binding LoadingCandidatesTotalText}" Style="{StaticResource DefColHead}" VerticalAlignment="Center"/>
            </Grid>
           </Expander.Header>
           <StackPanel Margin="4,4,0,2">
            <Grid Margin="0,0,0,3">
             <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <ItemsControl Grid.Column="1" ItemsSource="{Binding LoadingDefinitionColumns}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate><DataTemplate>
               <TextBlock Text="{Binding}" Width="92" Style="{StaticResource DefColHead}" TextTrimming="CharacterEllipsis"/>
              </DataTemplate></ItemsControl.ItemTemplate>
             </ItemsControl>
            </Grid>
            <ItemsControl ItemsSource="{Binding LoadingDefinitionRows}">
             <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,2">
               <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <TextBlock Text="{Binding Id}" Style="{StaticResource DefRowId}"/>
               <ItemsControl Grid.Column="1" ItemsSource="{Binding Values}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                 <TextBlock Text="{Binding}" Width="92" Style="{StaticResource DefRowVal}"/>
                </DataTemplate></ItemsControl.ItemTemplate>
               </ItemsControl>
              </Grid>
             </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </Expander>

          <Expander Style="{StaticResource DefExp}" IsExpanded="True">
           <Expander.Header>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="Truss-Height Candidates" FontWeight="SemiBold" VerticalAlignment="Center"/>
             <c:LatexTextBlock Grid.Column="1" Formula="N_H" Style="{StaticResource Formula}" Margin="6,0" VerticalAlignment="Center"/>
             <TextBlock Grid.Column="2" Text="{Binding HeightCandidatesTotalText}" Style="{StaticResource DefColHead}" VerticalAlignment="Center"/>
            </Grid>
           </Expander.Header>
           <StackPanel Margin="4,4,0,2">
            <Grid Margin="0,0,0,3">
             <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
             <TextBlock Grid.Column="1" Text="ΔH baseline" Style="{StaticResource DefColHead}"/>
             <TextBlock Grid.Column="2" Text="Truss height" Style="{StaticResource DefColHead}"/>
            </Grid>
            <ItemsControl ItemsSource="{Binding HeightDefinitionRows}">
             <ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,2">
               <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
               <TextBlock Text="{Binding Id}" Style="{StaticResource DefRowId}"/>
               <TextBlock Grid.Column="1" Text="{Binding Delta}" Style="{StaticResource DefRowVal}"/>
               <TextBlock Grid.Column="2" Text="{Binding Height}" Style="{StaticResource DefRowVal}"/>
              </Grid>
             </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
           </StackPanel>
          </Expander>

          <Expander Style="{StaticResource DefExp}" IsExpanded="True">
           <Expander.Header>
            <Grid>
             <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
             <TextBlock Text="Pretension Candidates" FontWeight="SemiBold" VerticalAlignment="Center"/>
             <c:LatexTextBlock Grid.Column="1" Formula="N_P" Style="{StaticResource Formula}" Margin="6,0" VerticalAlignment="Center"/>
             <TextBlock Grid.Column="2" Text="{Binding PretensionCandidatesTotalText}" Style="{StaticResource DefColHead}" VerticalAlignment="Center"/>
            </Grid>
           </Expander.Header>
           <ItemsControl ItemsSource="{Binding PretensionDefinitionGroups}" Margin="4,4,0,0">
            <ItemsControl.ItemTemplate><DataTemplate>
             <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="0,4,0,5" Margin="0,0,0,2">
              <StackPanel>
               <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource DefColHead}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Id}" Style="{StaticResource DefRowId}"/>
               </DockPanel>
               <ItemsControl ItemsSource="{Binding Cables}" Margin="10,3,0,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                 <Grid Margin="0,1">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Cable}" Style="{StaticResource DefRowVal}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Force}" Style="{StaticResource DefRowVal}" Margin="8,0,0,0"/>
                 </Grid>
                </DataTemplate></ItemsControl.ItemTemplate>
               </ItemsControl>
              </StackPanel>
             </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
           </ItemsControl>
          </Expander>
          </StackPanel>
         </ScrollViewer>
        </DockPanel>
       </Border>

       <!-- 50 / 50 divider -->
       <Border Grid.Row="1" Height="1" Background="{StaticResource Border}" Margin="0,6,10,6"/>

       <!-- ZONE · Study setup — scrolls inside its own box -->
       <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
        <StackPanel>
        <TextBlock Text="STUDY MODE" Style="{StaticResource Subheading}"/>
        <RadioButton GroupName="StudyMode" Margin="0,0,0,7" HorizontalContentAlignment="Stretch"
                     IsChecked="{Binding State.Study.Mode, Converter={StaticResource EnumMatch}, ConverterParameter=FixPretension}">
         <Grid Width="282">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Fix Pretension" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="Vary Loading and Truss Height" FontSize="11" Foreground="{StaticResource Muted}"/>
          <c:LatexTextBlock Grid.Row="1" Formula="N_L \times N_H" Style="{StaticResource Formula}" FontSize="11" HorizontalAlignment="Right"/>
         </Grid>
        </RadioButton>
        <RadioButton GroupName="StudyMode" Margin="0,0,0,7" HorizontalContentAlignment="Stretch"
                     IsChecked="{Binding State.Study.Mode, Converter={StaticResource EnumMatch}, ConverterParameter=FixHeight}">
         <Grid Width="282">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Fix Height" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="Vary Loading and Cable Pretension" FontSize="11" Foreground="{StaticResource Muted}"/>
          <c:LatexTextBlock Grid.Row="1" Formula="N_L \times N_P" Style="{StaticResource Formula}" FontSize="11" HorizontalAlignment="Right"/>
         </Grid>
        </RadioButton>
        <RadioButton GroupName="StudyMode" Margin="0,0,0,12" HorizontalContentAlignment="Stretch"
                     IsChecked="{Binding State.Study.Mode, Converter={StaticResource EnumMatch}, ConverterParameter=Combined}">
         <Grid Width="282">
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Combined" FontWeight="SemiBold"/>
          <TextBlock Grid.Row="1" Text="Vary all candidate dimensions" FontSize="11" Foreground="{StaticResource Muted}"/>
          <c:LatexTextBlock Grid.Row="1" Formula="N_L \times N_H \times N_P" Style="{StaticResource Formula}" FontSize="11" HorizontalAlignment="Right"/>
         </Grid>
        </RadioButton>

        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding StudyNeedsFixedPretension, Converter={StaticResource BoolVisibility}}">
         <StackPanel>
          <TextBlock Text="FIXED CABLE PRETENSION" Style="{StaticResource Subheading}"/>
          <ComboBox ItemsSource="{Binding PretensionStudyCandidates}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                    SelectedValue="{Binding FixedPretensionCandidateId, Mode=TwoWay}"/>
          <TextBlock Text="{Binding FixedPretensionValueText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
         </StackPanel>
        </Border>

        <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Padding="10" Margin="0,0,0,12"
                Visibility="{Binding StudyNeedsFixedHeight, Converter={StaticResource BoolVisibility}}">
         <StackPanel>
          <TextBlock Text="FIXED TRUSS HEIGHT" Style="{StaticResource Subheading}"/>
          <ComboBox ItemsSource="{Binding HeightStudyCandidates}" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                    SelectedValue="{Binding FixedHeightCandidateId, Mode=TwoWay}"/>
          <TextBlock Text="{Binding FixedHeightValueText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
         </StackPanel>
        </Border>

        <Expander Header="CANDIDATE FILTERS" Margin="0,0,0,10">
         <StackPanel Margin="8,5,8,8">
          <CheckBox Content="Enable persisted engineering filters" IsChecked="{Binding State.Study.UseCandidateFilters}" Margin="0,0,0,5"/>
          <Grid IsEnabled="{Binding State.Study.UseCandidateFilters}">
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
           <TextBlock Grid.Column="1" Text="Min" Style="{StaticResource Hint}"/><TextBlock Grid.Column="2" Text="Max" Style="{StaticResource Hint}"/>
           <TextBlock Grid.Row="1" Text="|qz| [kPa]" VerticalAlignment="Center"/>
           <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding State.Study.MinLoadingKpa, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
           <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding State.Study.MaxLoadingKpa, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
           <TextBlock Grid.Row="2" Text="Height [m]" VerticalAlignment="Center"/>
           <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding State.Study.MinHeightM, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
           <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding State.Study.MaxHeightM, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
           <TextBlock Grid.Row="3" Text="|Pret.| [kN]" VerticalAlignment="Center"/>
           <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding State.Study.MinPretensionKn, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
           <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding State.Study.MaxPretensionKn, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
           <TextBlock Grid.Row="4" Text="Max ratio L/H · P/H" VerticalAlignment="Center" ToolTip="Cross-dimension predicates: max |qz| / height [kPa/m] and max |pretension| / height [kN/m]"/>
           <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding State.Study.MaxLoadingToHeightRatio, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Maximum |qz| / height [kPa/m]"/>
           <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding State.Study.MaxPretensionToHeightRatio, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" ToolTip="Maximum |pretension| / height [kN/m]"/>
          </Grid>
          <TextBlock Text="{Binding FilterAuditText}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
         </StackPanel>
        </Expander>

        <TextBlock Text="CANDIDATE SUMMARY" Style="{StaticResource Subheading}"/>
        <Grid Margin="0,0,0,10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="70"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
         <TextBlock Grid.Column="1" Text="Available" Foreground="{StaticResource Muted}" FontSize="10.5"/>
         <TextBlock Grid.Column="2" Text="Current Study" Foreground="{StaticResource Muted}" FontSize="10.5"/>
         <StackPanel Grid.Row="1" Orientation="Horizontal"><TextBlock Text="Loading"/><TextBlock Text="  "/><c:LatexTextBlock Formula="N_L" Style="{StaticResource Formula}"/></StackPanel>
         <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LoadingCandidateCount}" FontFamily="{StaticResource MonoFont}"/>
         <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding StudyLoadingCell}" FontFamily="{StaticResource MonoFont}"/>
         <StackPanel Grid.Row="2" Orientation="Horizontal"><TextBlock Text="Height"/><TextBlock Text="  "/><c:LatexTextBlock Formula="N_H" Style="{StaticResource Formula}"/></StackPanel>
         <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HeightCandidateCount}" FontFamily="{StaticResource MonoFont}"/>
         <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding StudyHeightCell}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StudyHeightCell}"/>
         <StackPanel Grid.Row="3" Orientation="Horizontal"><TextBlock Text="Pretension"/><TextBlock Text="  "/><c:LatexTextBlock Formula="N_P" Style="{StaticResource Formula}"/></StackPanel>
         <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PretensionCandidateCount}" FontFamily="{StaticResource MonoFont}"/>
         <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding StudyPretensionCell}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StudyPretensionCell}"/>
        </Grid>

        <StackPanel Margin="0,2,0,0">
         <TextBlock Text="Total study to be conducted" FontWeight="SemiBold"/>
         <c:LatexTextBlock Formula="{Binding StudySpaceHeadlineFormula}" Style="{StaticResource Formula}" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,2,0,0"/>
         <TextBlock Text="{Binding StudyModeLabel}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
        </StackPanel>
       </ScrollViewer>
      </Grid>

      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>

       <Grid Grid.Column="2" Margin="10,0,0,0">
