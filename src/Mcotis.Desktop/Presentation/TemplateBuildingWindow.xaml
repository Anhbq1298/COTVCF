<Window x:Class="Mcotis.Desktop.Presentation.TemplateBuildingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Mcotis.Desktop.Presentation"
 Title="TemplateBuilding" Icon="{x:Static p:AppIcon.Window}" Width="760" Height="610" MinWidth="640" MinHeight="480"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <DockPanel Margin="10">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="New building frame · kN / m" Style="{StaticResource Heading}"/>
   <TextBlock Text="Creates a new native model workspace. Rigid beam-column connections; no slabs or diaphragms." TextWrapping="Wrap" Margin="0,0,0,8"/>
   <WrapPanel>
    <TextBlock Text="X bays" Margin="0,0,6,0"/><TextBox Text="{Binding BaysX, UpdateSourceTrigger=PropertyChanged}" Width="55" AutomationProperties.Name="Number of X bays"/>
    <TextBlock Text="Y bays" Margin="14,0,6,0"/><TextBox Text="{Binding BaysY, UpdateSourceTrigger=PropertyChanged}" Width="55" AutomationProperties.Name="Number of Y bays"/>
    <TextBlock Text="Storeys" Margin="14,0,6,0"/><TextBox Text="{Binding StoreyCount, UpdateSourceTrigger=PropertyChanged}" Width="55" AutomationProperties.Name="Number of storeys"/>
    <Button Content="Update Tables" Margin="14,0,0,0" Click="UpdateTables_Click"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,0,0,6" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Create Model" MinWidth="100" Margin="4" IsDefault="True" Click="Create_Click"/>
    <Button Content="Cancel" MinWidth="80" Margin="4" IsCancel="True"/>
   </StackPanel>
  </StackPanel>
  <TabControl Margin="0,10,0,0">
   <TabItem Header="Grid and Storeys">
    <Grid Margin="8">
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <DataGrid x:Name="XGrid" ItemsSource="{Binding XWidths}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="X bay widths">
       <DataGrid.Columns><DataGridTextColumn Header="X bay" Binding="{Binding Bay}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Width (m)" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
      </DataGrid>
      <DataGrid x:Name="YGrid" Grid.Column="2" ItemsSource="{Binding YWidths}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Y bay widths">
       <DataGrid.Columns><DataGridTextColumn Header="Y bay" Binding="{Binding Bay}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Width (m)" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="*"/></DataGrid.Columns>
      </DataGrid>
     </Grid>
     <TextBlock Grid.Row="1" Text="Each floor: height above the floor below; positive line load acts downward on every beam in that direction." TextWrapping="Wrap" Margin="0,10"/>
     <DataGrid x:Name="StoreyGrid" Grid.Row="2" ItemsSource="{Binding Storeys}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" AutomationProperties.Name="Storey heights and beam line loads">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Storey" Binding="{Binding Storey}" IsReadOnly="True" Width="*"/>
       <DataGridTextColumn Header="Height (m)" Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridTextColumn Header="X beams (kN/m)" Binding="{Binding LoadX, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridTextColumn Header="Y beams (kN/m)" Binding="{Binding LoadY, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>
   <TabItem Header="Properties and Supports">
    <StackPanel Margin="12">
     <TextBlock Text="Elastic material" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="32"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <TextBlock Text="Elastic modulus E (kN/m²)"/><TextBox Grid.Column="1" Text="{Binding ElasticModulus, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Elastic modulus kN per square metre"/>
      <TextBlock Grid.Row="1" Text="Poisson ratio"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PoissonRatio, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Poisson ratio"/>
      <TextBlock Grid.Row="2" Text="Weight density (kN/m³)"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WeightDensity, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Weight density kN per cubic metre"/>
     </Grid>
     <TextBlock Text="General section properties · starter values, review before analysis" FontWeight="SemiBold" Margin="0,12,0,6"/>
     <DataGrid x:Name="SectionGrid" ItemsSource="{Binding Sections}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="100" AutomationProperties.Name="Column and beam section properties">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Members" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
       <DataGridTextColumn Header="A (m²)" Binding="{Binding Area, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridTextColumn Header="I33 (m⁴)" Binding="{Binding I33, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridTextColumn Header="I22 (m⁴)" Binding="{Binding I22, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
       <DataGridTextColumn Header="J (m⁴)" Binding="{Binding J, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
     <CheckBox Content="Fixed bases (clear for pinned translations with free rotations)" IsChecked="{Binding FixedBases}" Margin="0,12,0,6"/>
     <CheckBox Content="Include member self-weight in BuildingLoad, in addition to the entered line loads" IsChecked="{Binding IncludeSelfWeight}"/>
    </StackPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
