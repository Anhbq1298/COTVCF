<Window x:Class="Mcotis.Desktop.Presentation.QuantityTakeoffWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:Mcotis.Desktop.Presentation.Controls" xmlns:p="clr-namespace:Mcotis.Desktop.Presentation"
        Title="Show Quantities" Icon="{x:Static p:AppIcon.Window}" Width="1360" Height="720" MinWidth="960" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <DockPanel Margin="12">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
   <DockPanel>
    <Button DockPanel.Dock="Right" Content="Refresh" Click="Refresh_Click" MinWidth="88" AutomationProperties.Name="Refresh quantities"/>
    <TextBlock x:Name="ModelLabel" Style="{StaticResource Subheading}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <TextBlock Text="Quantities use Mcotis's stored member geometry, section assignments, section areas and material densities. Composite breakdowns are unavailable when the native model does not store their component geometry." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
   <StackPanel>
    <TextBlock x:Name="TotalsLabel" FontWeight="SemiBold"/>
    <ItemsControl x:Name="NotesList" Margin="0,5,0,0" MaxHeight="72">
     <ItemsControl.ItemTemplate><DataTemplate><TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,1"><Run Text="• "/><Run Text="{Binding Path=.}"/></TextBlock></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
  <DataGrid x:Name="RowsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
            CanUserReorderColumns="True" CanUserSortColumns="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
            RowHeaderWidth="0" RowHeight="72" ColumnHeaderHeight="32" EnableRowVirtualization="True"
            AutomationProperties.Name="Native model quantities">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="1.1*" MinWidth="120"/>
    <DataGridTextColumn Header="Member type" Binding="{Binding SectionType}" Width="1.15*" MinWidth="145"/>
    <DataGridTemplateColumn Header="Cross section" Width="108" MinWidth="108">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <c:SectionFigureView Figure="{Binding Figure}" Width="96" Height="64" VerticalAlignment="Center"
                           HorizontalAlignment="Center" ToolTip="{Binding FigureDescription}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Header="Section dimensions" Binding="{Binding FigureDescription}" Width="1.5*" MinWidth="160">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="72" MinWidth="72"/>
    <DataGridTextColumn Header="Members" Binding="{Binding MemberCount, StringFormat=N0}" Width="78" MinWidth="78"/>
    <DataGridTextColumn Header="Total length" Binding="{Binding LengthText}" Width="110" MinWidth="110"/>
    <DataGridTextColumn Header="Concrete volume" Binding="{Binding ConcreteText}" Width="136" MinWidth="136"/>
    <DataGridTextColumn Header="Steel mass" Binding="{Binding SteelText}" Width="104" MinWidth="104"/>
    <DataGridTextColumn Header="Notes" Binding="{Binding Details}" Width="1.5*" MinWidth="150">
     <DataGridTextColumn.ElementStyle>
      <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
     </DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</Window>
