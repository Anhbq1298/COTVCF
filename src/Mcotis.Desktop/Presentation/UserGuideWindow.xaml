<Window x:Class="Mcotis.Desktop.Presentation.UserGuideWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:Mcotis.Desktop.Presentation"
        Title="Mcotis User Guide" Icon="{x:Static p:AppIcon.Window}" Width="1160" Height="780" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Surface}">
 <!-- Help → User Guide (F1): the encyclopedia of Mcotis's functions, docs/USER_GUIDE.md built into the app (UserGuide). -->
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="220"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Margin="10,10,4,10">
   <TextBlock DockPanel.Dock="Top" Text="MCOTIS USER GUIDE" Style="{StaticResource Subheading}"/>
   <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,4" TextChanged="Search_Changed" KeyDown="Search_KeyDown"
            AutomationProperties.Name="Search the User Guide" ToolTip="Search every article (all words must match); Enter opens the first result"/>
   <TextBlock x:Name="SearchCount" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,0,0,6"/>
   <TreeView x:Name="Contents" SelectedItemChanged="Contents_SelectedItemChanged" BorderThickness="1" BorderBrush="{StaticResource Border}"
             AutomationProperties.Name="User Guide contents"/>
  </DockPanel>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>
  <DockPanel Grid.Column="2" Margin="4,10,10,10">
   <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
    <StackPanel Orientation="Horizontal">
     <Button x:Name="BackButton" Content="◀ Back" MinWidth="72" Margin="0,0,6,0" Click="Back_Click" IsEnabled="False"/>
     <Button x:Name="ForwardButton" Content="Forward ▶" MinWidth="82" Margin="0,0,6,0" Click="Forward_Click" IsEnabled="False"/>
     <Button Content="Main page" MinWidth="82" Margin="0,0,12,0" Click="Home_Click"/>
    </StackPanel>
    <TextBlock x:Name="Breadcrumb" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Raised}">
    <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="User Guide article"/>
   </Border>
  </DockPanel>
 </Grid>
</Window>
