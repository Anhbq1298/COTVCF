<Window x:Class="Mcotis.Desktop.Presentation.NativeModelWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" xmlns:c="clr-namespace:Mcotis.Desktop.Presentation.Controls"
 Title="{Binding Title}" Icon="{x:Static p:AppIcon.Window}" Width="1150" Height="760" MinWidth="850" MinHeight="540" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Menu DockPanel.Dock="Top" IsEnabled="{Binding Editable}">
   <MenuItem Header="_File"><MenuItem Header="_Open Native Model…" Click="Open_Click"/>
    <MenuItem Header="_Save" Click="Save_Click" InputGestureText="Ctrl+S"/><MenuItem Header="Save _As…" Click="SaveAs_Click"/></MenuItem>
   <MenuItem Header="_Edit"><MenuItem Header="_TemplateBuilding…" Click="Template_Click" ToolTip="Create another building in a new native model window"/>
    <Separator/><MenuItem Header="_Undo" Click="Undo_Click" IsEnabled="{Binding Session.CanUndo}"/><MenuItem Header="_Redo" Click="Redo_Click" IsEnabled="{Binding Session.CanRedo}"/></MenuItem>
   <MenuItem Header="_Define"><MenuItem Header="_Modal Eigen Case…" Click="Modal_Click" ToolTip="Define or modify an Eigen case and its lumped mass source"/></MenuItem>
   <MenuItem Header="_Assign"><MenuItem Header="_Joint Mass…" Click="JointMass_Click" ToolTip="Assign translational mass and rotational inertia at a joint"/></MenuItem>
   <MenuItem Header="_Run"><MenuItem Header="Analysis _Options…" Click="Options_Click"/><MenuItem Header="_Run Analysis" Click="Run_Click" InputGestureText="F5"/></MenuItem>
  </Menu>
  <StackPanel DockPanel.Dock="Top" Margin="8,4">
   <WrapPanel Margin="0,2,0,6" VerticalAlignment="Center">
    <TextBlock Text="View" VerticalAlignment="Center" Margin="0,0,8,0"/>
    <ComboBox x:Name="ViewOrientation" Width="145" SelectedIndex="0" SelectionChanged="ViewOrientation_Changed">
     <ComboBoxItem Content="3D"/><ComboBoxItem Content="XY plan @ Z"/><ComboBoxItem Content="XZ elevation @ Y"/><ComboBoxItem Content="YZ elevation @ X"/>
    </ComboBox>
    <TextBlock x:Name="FixedAxisLabel" Text="Coordinate (m)" VerticalAlignment="Center" Margin="12,0,6,0"/>
    <Button Content="◀" Width="27" Click="PreviousLevel_Click" ToolTip="Previous grid/level"/>
    <ComboBox x:Name="ViewCoordinate" Width="116" IsEditable="True" IsEnabled="False"
      SelectionChanged="ViewCoordinate_Changed" LostKeyboardFocus="ViewCoordinate_Commit"/>
    <Button Content="▶" Width="27" Click="NextLevel_Click" ToolTip="Next grid/level"/>
    <TextBlock x:Name="ReferenceKind" Text="Model coordinates" VerticalAlignment="Center" Margin="10,0,0,0"/>
   </WrapPanel>
   <TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/>
   <WrapPanel Margin="0,6,0,2" IsEnabled="{Binding Editable}">
    <TextBlock Text="Load case" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedCase}" DisplayMemberPath="Name" Width="190" AutomationProperties.Name="Analysis load case"/>
    <Button Content="Analysis Options…" Margin="8,0" Click="Options_Click"/><Button Content="Run Analysis" Click="Run_Click"/>
   </WrapPanel>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" Padding="8" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
   <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
  </Border>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="5"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
   <c:Structural2DViewer x:Name="Viewer" Model="{Binding VisibleGeometry}" PinSupportPoints="{Binding Supports}" ShowPointLabels="False" ShowFrameLabels="False" ShowDimensions="False"
                         FemResult="{Binding ModalDisplayResult}" FemResultMode="DeflectedShape" DeflectionIsModeShape="True"/>
   <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
   <TabControl Grid.Row="2" Margin="8,0,8,8">
    <TabItem Header="Joint results">
     <DataGrid ItemsSource="{Binding Joints}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Point" Binding="{Binding Point}"/>
       <DataGridTextColumn Header="UX (m)" Binding="{Binding UX, StringFormat=G6}"/><DataGridTextColumn Header="UY (m)" Binding="{Binding UY, StringFormat=G6}"/><DataGridTextColumn Header="UZ (m)" Binding="{Binding UZ, StringFormat=G6}"/>
       <DataGridTextColumn Header="RX (rad)" Binding="{Binding RX, StringFormat=G6}"/><DataGridTextColumn Header="RY (rad)" Binding="{Binding RY, StringFormat=G6}"/><DataGridTextColumn Header="RZ (rad)" Binding="{Binding RZ, StringFormat=G6}"/>
       <DataGridTextColumn Header="FX (kN)" Binding="{Binding FX, StringFormat=G6}"/><DataGridTextColumn Header="FY (kN)" Binding="{Binding FY, StringFormat=G6}"/><DataGridTextColumn Header="FZ (kN)" Binding="{Binding FZ, StringFormat=G6}"/>
       <DataGridTextColumn Header="MX (kN·m)" Binding="{Binding MX, StringFormat=G6}"/><DataGridTextColumn Header="MY (kN·m)" Binding="{Binding MY, StringFormat=G6}"/><DataGridTextColumn Header="MZ (kN·m)" Binding="{Binding MZ, StringFormat=G6}"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Frame local end actions">
     <DataGrid ItemsSource="{Binding Frames}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Frame" Binding="{Binding Frame}"/><DataGridTextColumn Header="End" Binding="{Binding End}"/>
       <DataGridTextColumn Header="N (kN)" Binding="{Binding N, StringFormat=G6}"/><DataGridTextColumn Header="V2 (kN)" Binding="{Binding V2, StringFormat=G6}"/><DataGridTextColumn Header="V3 (kN)" Binding="{Binding V3, StringFormat=G6}"/>
       <DataGridTextColumn Header="T (kN·m)" Binding="{Binding T, StringFormat=G6}"/><DataGridTextColumn Header="M2 (kN·m)" Binding="{Binding M2, StringFormat=G6}"/><DataGridTextColumn Header="M3 (kN·m)" Binding="{Binding M3, StringFormat=G6}"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Cable results">
     <DataGrid ItemsSource="{Binding Cables}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Cable" Binding="{Binding Cable}"/><DataGridTextColumn Header="Tension (kN)" Binding="{Binding Tension, StringFormat=G6}"/>
       <DataGridTextColumn Header="State" Binding="{Binding State}"/><DataGridTextColumn Header="Target (kN)" Binding="{Binding Target, StringFormat=G6}"/>
       <DataGridTextColumn Header="Applied pretension (kN)" Binding="{Binding Pretension, StringFormat=G6}"/><DataGridTextColumn Header="At fit stage (kN)" Binding="{Binding FitStage, StringFormat=G6}"/>
       <DataGridTextColumn Header="Sag (m)" Binding="{Binding Sag, StringFormat=G4}"/><DataGridTextColumn Header="Stiffness / (EA/L)" Binding="{Binding StiffnessRatio, StringFormat=G4}"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Frame line loads">
     <DataGrid ItemsSource="{Binding Loads}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Frame" Binding="{Binding Frame}"/><DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}"/>
       <DataGridTextColumn Header="Direction" Binding="{Binding Direction}"/><DataGridTextColumn Header="Start (relative)" Binding="{Binding Start}"/><DataGridTextColumn Header="End (relative)" Binding="{Binding End}"/>
       <DataGridTextColumn Header="qI (kN/m)" Binding="{Binding QI}"/><DataGridTextColumn Header="qJ (kN/m)" Binding="{Binding QJ}"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Modal modes">
     <DataGrid ItemsSource="{Binding Modes}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Mode" Binding="{Binding Mode}"/>
       <DataGridTextColumn Header="Eigenvalue (s⁻²)" Binding="{Binding Eigenvalue, StringFormat=G8}"/>
       <DataGridTextColumn Header="Frequency (Hz)" Binding="{Binding Frequency, StringFormat=G8}"/>
       <DataGridTextColumn Header="Period (s)" Binding="{Binding Period, StringFormat=G8}"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}"/><DataGridTextColumn Header="Scaled residual" Binding="{Binding Residual, StringFormat=G4}"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Modal participation">
     <DataGrid ItemsSource="{Binding Participation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Mode" Binding="{Binding Mode}"/><DataGridTextColumn Header="Direction" Binding="{Binding Direction}"/>
       <DataGridTextColumn Header="Factor" Binding="{Binding Factor, StringFormat=G8}"/><DataGridTextColumn Header="Effective mass (t)" Binding="{Binding EffectiveMass, StringFormat=G8}"/>
       <DataGridTextColumn Header="Ratio (%)" Binding="{Binding Ratio, StringFormat=F3}"/><DataGridTextColumn Header="Cumulative (%)" Binding="{Binding Cumulative, StringFormat=F3}"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Modal mass inventory">
     <DataGrid ItemsSource="{Binding ModalMass}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
      <DataGrid.Columns><DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="170"/>
       <DataGridTextColumn Header="Value" Binding="{Binding Value, StringFormat=G10}"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}"/>
       <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="*"/>
      </DataGrid.Columns>
     </DataGrid>
    </TabItem>
    <TabItem Header="Mode shape amplitudes">
     <DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
       <TextBlock Text="Mode" Margin="0,0,8,0"/><ComboBox ItemsSource="{Binding ModeNumbers}" SelectedItem="{Binding SelectedMode}" Width="80" AutomationProperties.Name="Displayed modal mode"/>
       <TextBlock Text="Mass-normalized eigenvector; amplitude is not a physical displacement." Margin="12,0,0,0" Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding ModeShape}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
       <DataGrid.Columns><DataGridTextColumn Header="Point" Binding="{Binding Point}"/>
        <DataGridTextColumn Header="UX" Binding="{Binding UX, StringFormat=G8}"/><DataGridTextColumn Header="UY" Binding="{Binding UY, StringFormat=G8}"/><DataGridTextColumn Header="UZ" Binding="{Binding UZ, StringFormat=G8}"/>
        <DataGridTextColumn Header="RX" Binding="{Binding RX, StringFormat=G8}"/><DataGridTextColumn Header="RY" Binding="{Binding RY, StringFormat=G8}"/><DataGridTextColumn Header="RZ" Binding="{Binding RZ, StringFormat=G8}"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</Window>
