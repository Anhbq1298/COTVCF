<Window x:Class="Mcotis.Desktop.Presentation.ExportResultsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" Title="Export Results" Icon="{x:Static p:AppIcon.Window}"
 Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <StackPanel Margin="10">
  <StackPanel x:Name="Options">
   <GroupBox Header="Format" Padding="8" Margin="0,0,0,8">
    <StackPanel>
     <StackPanel Orientation="Horizontal"><RadioButton x:Name="WordFormat" Content="Word (.docx)" IsChecked="True" GroupName="Format" Margin="0,0,20,0"/><RadioButton x:Name="PdfFormat" Content="PDF (.pdf)" GroupName="Format"/></StackPanel>
     <TextBlock Text="A4 · Arial 11 pt · line spacing 1.15" Margin="0,8,0,0"/>
     <TextBlock Text="Margins [cm]: top 1.88 · bottom 1.28 · left 1.88 · right 1.58" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </GroupBox>
   <GroupBox Header="Load cases / combinations" Padding="8" Margin="0,0,0,8">
    <StackPanel>
     <CheckBox x:Name="AllCases" Content="All solved load cases / combinations" Click="AllCases_Click" Margin="0,0,0,6"/>
     <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CaseChoices"/></ScrollViewer>
    </StackPanel>
   </GroupBox>
   <GroupBox Header="Results" Padding="8" Margin="0,0,0,8">
    <StackPanel>
     <CheckBox x:Name="AllOutputs" Content="All results" IsChecked="True" Click="AllOutputs_Click" Margin="0,0,0,6"/>
     <UniformGrid x:Name="OutputChoices" Columns="2"/>
    </StackPanel>
   </GroupBox>
   <TextBlock Text="Each selected result is captured as a model-view figure with its figure number and load case caption. Choose the file name and folder after OK; the saved report opens automatically." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
  </StackPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,0,0,8"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="84" Click="Ok_Click"/>
   <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="84" Margin="8,0,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
