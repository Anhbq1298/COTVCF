<Window x:Class="Mcotis.Desktop.Presentation.ExportResultsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:Mcotis.Desktop.Presentation" Title="Export Results" Icon="{x:Static p:AppIcon.Window}"
 Width="540" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <StackPanel Margin="10">
  <StackPanel x:Name="Options">
   <GroupBox Header="Format" Padding="8" Margin="0,0,0,8">
    <StackPanel>
     <StackPanel Orientation="Horizontal"><RadioButton x:Name="WordFormat" Content="Word (.docx)" IsChecked="True" GroupName="Format" Margin="0,0,20,0"/><RadioButton x:Name="PdfFormat" Content="PDF (.pdf)" GroupName="Format"/></StackPanel>
     <TextBlock Text="A4 · Arial 11 pt · line spacing 1.15" Margin="0,8,0,0"/>
     <TextBlock Text="Margins [cm]: top 1.88 · bottom 1.28 · left 1.88 · right 1.58" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    </StackPanel>
   </GroupBox>
   <GroupBox Header="SLS — serviceability (deflection, loading)" Padding="8" Margin="0,0,0,8">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Load cases / combinations" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <CheckBox x:Name="SlsAllCases" Content="All solved" Margin="0,0,0,4"/>
      <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SlsCaseChoices"/></ScrollViewer>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Results" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <CheckBox x:Name="SlsAllOutputs" Content="All results" Margin="0,0,0,4"/>
      <StackPanel x:Name="SlsOutputChoices"/>
     </StackPanel>
    </Grid>
   </GroupBox>
   <GroupBox Header="ULS — strength (forces, reactions)" Padding="8" Margin="0,0,0,8">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Load cases / combinations" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <CheckBox x:Name="UlsAllCases" Content="All solved" Margin="0,0,0,4"/>
      <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="UlsCaseChoices"/></ScrollViewer>
     </StackPanel>
     <StackPanel Grid.Column="2">
      <TextBlock Text="Results" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <CheckBox x:Name="UlsAllOutputs" Content="All results" Margin="0,0,0,4"/>
      <StackPanel x:Name="UlsOutputChoices"/>
     </StackPanel>
    </Grid>
   </GroupBox>
   <GroupBox Header="Tables (after the figures; forces in MN, 1 decimal)" Padding="8" Margin="0,0,0,8">
    <StackPanel>
     <CheckBox x:Name="IncludeForces" IsChecked="True" Margin="0,2,0,2" AutomationProperties.Name="Include member forces">
      <TextBlock TextWrapping="Wrap" Text="Member forces — summary with section drawings, the members of each group and the cables, per selected case"/></CheckBox>
     <CheckBox x:Name="IncludeQuantities" IsChecked="True" Margin="0,2,0,2" AutomationProperties.Name="Include quantities">
      <TextBlock TextWrapping="Wrap" Text="Quantities — section drawing and description, members, length, concrete, steel and estimated cost"/></CheckBox>
     <CheckBox x:Name="IncludeUtilization" Margin="0,2,0,2" AutomationProperties.Name="Include design utilization">
      <TextBlock TextWrapping="Wrap" Text="Design utilization — runs every member design on current results and adds a UR column to every table"/></CheckBox>
    </StackPanel>
   </GroupBox>
   <TextBlock Text="Each selected load case gives the model-view figures of the results ticked in its part and, with Member forces, its force tables. A case ticked in both parts is reported once. With Member forces a part may have no figures. Design utilization first makes sure the FEM results are those of the current model. Choose the file name and folder after OK; the saved report opens automatically." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
  </StackPanel>
  <TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,0,0,8"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="84" Click="Ok_Click"/>
   <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" MinWidth="84" Margin="8,0,0,0"/>
  </StackPanel>
 </StackPanel>
</Window>
