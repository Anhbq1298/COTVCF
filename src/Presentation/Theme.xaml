<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:COT_VCF.Presentation" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls">

 <!-- ============================ PALETTE ============================ -->
 <!-- Neutral engineering light chrome + charcoal model viewport.       -->
 <SolidColorBrush x:Key="Accent" Color="#1F4788"/>
 <SolidColorBrush x:Key="AccentBright" Color="#2E90FA"/>
 <SolidColorBrush x:Key="Success" Color="#2E7D32"/>
 <SolidColorBrush x:Key="Warning" Color="#F57C00"/>
 <SolidColorBrush x:Key="Error" Color="#C62828"/>
 <SolidColorBrush x:Key="Background" Color="#E6E8EB"/>
 <SolidColorBrush x:Key="Surface" Color="#F3F4F6"/>
 <SolidColorBrush x:Key="Raised" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="Border" Color="#C7CCD2"/>
 <SolidColorBrush x:Key="Text" Color="#1A1D21"/>
 <SolidColorBrush x:Key="Muted" Color="#6B7178"/>
 <SolidColorBrush x:Key="Frame" Color="#5A6470"/>
 <SolidColorBrush x:Key="Selected" Color="#DCEBFB"/>
 <SolidColorBrush x:Key="SelectedBorder" Color="#AFC7DF"/>
 <!-- Translucent-looking chip behind floating viewer controls / legends. -->
 <SolidColorBrush x:Key="Overlay" Color="#F2F3F5"/>
 <!-- Truss chord-group identity — used for legend dots and viewer overlays. -->
 <SolidColorBrush x:Key="ChordTop" Color="#C62828"/>
 <SolidColorBrush x:Key="ChordMiddle" Color="#2563EB"/>
 <SolidColorBrush x:Key="ChordBottom" Color="#2E7D32"/>
 <!-- 45° diagonal hatch — marks a disabled / not-in-use surface -->
 <DrawingBrush x:Key="HatchBrush" TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute" Stretch="None">
  <DrawingBrush.Drawing>
   <GeometryDrawing>
    <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,7" EndPoint="7,0"/><LineGeometry StartPoint="-1,1" EndPoint="1,-1"/><LineGeometry StartPoint="6,8" EndPoint="8,6"/></GeometryGroup></GeometryDrawing.Geometry>
    <GeometryDrawing.Pen><Pen Thickness="1" Brush="#C7CCD2"/></GeometryDrawing.Pen>
   </GeometryDrawing>
  </DrawingBrush.Drawing>
 </DrawingBrush>
 <!-- Viewport tokens (consumed by ModelCanvas.OnRender) — white model background -->
 <SolidColorBrush x:Key="ViewportBg" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="ViewportGrid" Color="#EEF0F2"/>
 <SolidColorBrush x:Key="ViewportGeom" Color="#3A4048"/>
 <SolidColorBrush x:Key="ViewportEdge" Color="#8A929C"/>
 <!-- Section figures (Tab 08 Quantities): concrete as in the 3D view, lighter for a flat fill; steel in the accent blue -->
 <SolidColorBrush x:Key="SectionConcrete" Color="#CFCAC0"/>
 <SolidColorBrush x:Key="SectionSteel" Color="#1F4788"/>

 <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
 <p:NullableDoubleConverter x:Key="NullableDouble"/>
 <p:EnumMatchConverter x:Key="EnumMatch"/>
 <p:CableSyncModeLabelConverter x:Key="SyncModeLabel"/>
 <p:NonEmptyStringConverter x:Key="NonEmpty"/>

 <!-- ===================== APPLICATION LOGO ========================= -->
 <!-- Isometric Vierendeel truss with cable stays (src/Presentation/AppLogo.png, 256 px); the .exe icon is AppIcon.ico from the same image. -->
 <BitmapImage x:Key="AppLogo" UriSource="pack://application:,,,/Mcotis;component/src/Presentation/AppLogo.png"/>

 <!-- ======================== TYPOGRAPHY =========================== -->
 <!-- One type system for the whole app. Two families, one size ramp.   -->
 <!--   UiFont   — every label, heading, banner, grid header and body.   -->
 <!--   MonoFont — numeric values, IDs, paths, status/telemetry read-out.-->
 <!-- Size ramp: 15 heading · 13 banner · 12 body · 11 section/label     -->
 <!--            · 10.5 hint/mono-small · 10 caption.                     -->
 <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
 <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>

 <Style TargetType="Window">
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Background" Value="{StaticResource Background}"/>
  <Setter Property="Foreground" Value="{StaticResource Text}"/>
 </Style>
 <Style TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>

 <!-- Page / dialog heading. -->
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
 <!-- Section label above a group of controls (typically an ALL-CAPS string). -->
 <Style x:Key="Subheading" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,2,0,6"/></Style>
 <!-- Inline field label / small key text. -->
 <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
 <!-- Explanatory hint paragraph. -->
 <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="10.5"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
 <!-- Smallest annotation / secondary caption. -->
 <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>

 <!-- Top-bar (banner) product name + eyebrow. -->
 <Style x:Key="BannerTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
 <Style x:Key="BannerEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Caption}"/>

 <!-- Left workflow-tab header: title line + status line. -->
 <Style x:Key="TabHeaderTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
 <Style x:Key="TabHeaderStatus" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Margin" Value="0,1,0,0"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>

 <!-- Monospace read-outs. Mono = inline value · MonoSmall = telemetry line
      · MonoStrong = emphasised figure (accent). -->
 <Style x:Key="Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="MonoSmall" TargetType="TextBlock" BasedOn="{StaticResource Mono}"><Setter Property="FontSize" Value="10.5"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Style>
 <Style x:Key="MonoStrong" TargetType="TextBlock" BasedOn="{StaticResource Mono}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Style>

 <Style x:Key="Formula" TargetType="c:LatexTextBlock">
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>

 <!-- ========================= BUTTONS ============================= -->
 <Style TargetType="Button">
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="Padding" Value="10,3"/>
  <Setter Property="Margin" Value="0,0,6,0"/>
  <Setter Property="Background" Value="{StaticResource Raised}"/>
  <Setter Property="Foreground" Value="{StaticResource Accent}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource Surface}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBright}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{StaticResource Accent}"/>
  <Setter Property="Foreground" Value="{StaticResource Raised}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
  </Style.Triggers>
 </Style>
 <!-- On/off view toggle: same chrome as Button; checked = accent fill. -->
 <Style x:Key="ViewToggle" TargetType="ToggleButton">
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="Padding" Value="10,3"/>
  <Setter Property="Background" Value="{StaticResource Raised}"/>
  <Setter Property="Foreground" Value="{StaticResource Accent}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="{StaticResource Surface}"/></Trigger>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Border" Property="Background" Value="{StaticResource Accent}"/>
       <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Accent}"/>
       <Setter Property="Foreground" Value="{StaticResource Raised}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource AccentBright}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Icon-only chrome button (top bar). -->
 <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Width" Value="28"/>
  <Setter Property="Height" Value="28"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="Margin" Value="0,0,4,0"/>
 </Style>
 <!-- Top-bar tool icons (ETABS-like): borderless 26 px buttons with a Segoe Fluent / MDL2 glyph, or short text such as "xz". -->
 <!-- a toolbar button whose content is a drawing (e.g. the SAP2000-style undeformed-shape frame) -->
 <Style x:Key="ToolbarDrawingButton" TargetType="Button">
  <Setter Property="Width" Value="26"/>
  <Setter Property="Height" Value="26"/>
  <Setter Property="Margin" Value="1,0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A2E90FA"/><Setter TargetName="b" Property="BorderBrush" Value="#552E90FA"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#332E90FA"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- a toolbar tool that stays on (Select / Pan): pressed look while checked -->
 <Style x:Key="ToolbarDrawingToggle" TargetType="ToggleButton">
  <Setter Property="Width" Value="26"/>
  <Setter Property="Height" Value="26"/>
  <Setter Property="Margin" Value="1,0"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A2E90FA"/><Setter TargetName="b" Property="BorderBrush" Value="#552E90FA"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#332E90FA"/><Setter TargetName="b" Property="BorderBrush" Value="#992E90FA"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ToolbarButton" TargetType="Button">
  <Setter Property="Width" Value="26"/>
  <Setter Property="Height" Value="26"/>
  <Setter Property="Margin" Value="1,0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="Foreground" Value="{StaticResource Accent}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="3" BorderThickness="1" BorderBrush="Transparent">
      <!-- own TextBlock: the theme's implicit TextBlock font would replace the icon font of a ContentPresenter -->
      <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                 Foreground="{TemplateBinding Foreground}" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1A2E90FA"/><Setter TargetName="b" Property="BorderBrush" Value="#552E90FA"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#332E90FA"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="ToolbarTextButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="FontWeight" Value="Bold"/>
  <Setter Property="Width" Value="Auto"/>
  <Setter Property="MinWidth" Value="26"/>
  <Setter Property="Padding" Value="3,0"/>
 </Style>
 <Style x:Key="ToolbarSeparator" TargetType="Border">
  <Setter Property="Width" Value="1"/>
  <Setter Property="Height" Value="18"/>
  <Setter Property="Margin" Value="5,0"/>
  <Setter Property="Background" Value="{StaticResource Border}"/>
 </Style>
 <!-- The same line between top-level menus of the menu bar. A Separator there otherwise takes the drop-down style,
      a horizontal rule, which a horizontal bar does not show. -->
 <Style x:Key="MenuBarSeparator" TargetType="Separator">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="IsTabStop" Value="False"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Separator">
     <Border Width="1" Height="14" Margin="8,0" Background="{StaticResource Border}" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Faded, independently focusable help target placed beside compact actions. -->
 <Style x:Key="InlineHelpIcon" TargetType="TextBlock">
  <Setter Property="Text" Value="&#9432;"/>
  <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
  <Setter Property="Opacity" Value="0.55"/>
  <Setter Property="Margin" Value="3,0,6,0"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Cursor" Value="Help"/>
  <Setter Property="Focusable" Value="True"/>
  <Setter Property="ToolTipService.InitialShowDelay" Value="180"/>
  <Setter Property="ToolTipService.ShowDuration" Value="30000"/>
  <Setter Property="ToolTipService.ShowsToolTipOnKeyboardFocus" Value="True"/>
  <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
   <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
  </Style.Triggers>
 </Style>

 <!-- ===================== INPUTS / COMBOS ======================== -->
 <Style TargetType="TextBox">
  <Setter Property="MinHeight" Value="26"/>
  <Setter Property="Padding" Value="6,2"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
  <Setter Property="Background" Value="{StaticResource Raised}"/>
  <Style.Triggers>
   <Trigger Property="Validation.HasError" Value="True">
    <Setter Property="BorderBrush" Value="{StaticResource Error}"/>
    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="MinHeight" Value="24"/>
  <Setter Property="Padding" Value="6,1"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
 </Style>
 <Style TargetType="CheckBox"><Setter Property="VerticalAlignment" Value="Center"/></Style>

 <!-- Slider with a visible tick per increment step. -->
 <Style TargetType="Slider">
  <Setter Property="IsSnapToTickEnabled" Value="True"/>
  <Setter Property="TickPlacement" Value="Both"/>
  <Setter Property="Height" Value="30"/>
  <Setter Property="Foreground" Value="{StaticResource Border}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Slider">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto" MinHeight="18"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TickBar x:Name="TopTick" Grid.Row="0" Height="5" Placement="Top" Fill="{StaticResource Muted}" SnapsToDevicePixels="True"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}"/>
      <Border Grid.Row="1" Height="4" VerticalAlignment="Center" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="2"/>
      <Track x:Name="PART_Track" Grid.Row="1">
       <Track.DecreaseRepeatButton>
        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
         <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{StaticResource AccentBright}" Height="4" VerticalAlignment="Center" CornerRadius="2"/></ControlTemplate></RepeatButton.Template>
        </RepeatButton>
       </Track.DecreaseRepeatButton>
       <Track.IncreaseRepeatButton>
        <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
         <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" Height="4"/></ControlTemplate></RepeatButton.Template>
        </RepeatButton>
       </Track.IncreaseRepeatButton>
       <Track.Thumb>
        <Thumb x:Name="Thumb" Width="12" Height="16">
         <Thumb.Template>
          <ControlTemplate TargetType="Thumb">
           <Border Background="{StaticResource Accent}" BorderBrush="{StaticResource Raised}" BorderThickness="1.5" CornerRadius="2"/>
          </ControlTemplate>
         </Thumb.Template>
        </Thumb>
       </Track.Thumb>
      </Track>
      <TickBar x:Name="BottomTick" Grid.Row="2" Height="5" Placement="Bottom" Fill="{StaticResource Muted}" SnapsToDevicePixels="True"
               Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="{TemplateBinding TickFrequency}" Ticks="{TemplateBinding Ticks}"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- ========================= DATAGRID =========================== -->
 <Style TargetType="DataGrid">
  <Setter Property="AutoGenerateColumns" Value="False"/>
  <Setter Property="CanUserAddRows" Value="False"/>
  <Setter Property="CanUserDeleteRows" Value="True"/>
  <Setter Property="SelectionMode" Value="Extended"/>
  <Setter Property="SelectionUnit" Value="FullRow"/>
  <Setter Property="RowHeight" Value="24"/>
  <Setter Property="ColumnHeaderHeight" Value="26"/>
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="RowHeaderWidth" Value="0"/>
  <Setter Property="EnableRowVirtualization" Value="True"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="AlternatingRowBackground" Value="{StaticResource Surface}"/>
  <Setter Property="Background" Value="{StaticResource Raised}"/>
  <Setter Property="RowBackground" Value="{StaticResource Raised}"/>
  <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="GridLinesVisibility" Value="All"/>
  <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border}"/>
  <Setter Property="VerticalGridLinesBrush" Value="{StaticResource Border}"/>
  <Setter Property="HeadersVisibility" Value="Column"/>
  <Setter Property="FrozenColumnCount" Value="1"/>
  <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/>
  <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
  <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
  <Setter Property="ColumnHeaderStyle">
   <Setter.Value>
    <Style TargetType="DataGridColumnHeader">
     <Setter Property="Padding" Value="6,2"/>
     <Setter Property="FontSize" Value="11"/>
     <Setter Property="FontWeight" Value="SemiBold"/>
     <Setter Property="Foreground" Value="{StaticResource Muted}"/>
     <Setter Property="Background" Value="{StaticResource Surface}"/>
     <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
     <Setter Property="BorderThickness" Value="0,0,1,1"/>
     <Setter Property="HorizontalContentAlignment" Value="Left"/>
     <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="DataGridRow">
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True">
    <Setter Property="Background" Value="{StaticResource Selected}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="DataGridCell">
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="4,0"/>
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True">
    <Setter Property="Background" Value="{StaticResource Selected}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource SelectedBorder}"/>
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style x:Key="NumericCell" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="TextAlignment" Value="Right"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Margin" Value="6,0"/>
 </Style>
 <Style x:Key="IdCell" TargetType="TextBlock">
  <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="TextAlignment" Value="Center"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>

 <!-- ================== LEFT WORKFLOW TAB STRIP =================== -->
 <Style TargetType="TabItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Height" Value="42"/>
  <Setter Property="Width" Value="152"/>
  <Setter Property="Margin" Value="0"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TabItem">
     <Grid SnapsToDevicePixels="True">
      <Border x:Name="Fill" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,1"/>
      <Border x:Name="Accent" Width="3" HorizontalAlignment="Left" Background="{StaticResource AccentBright}" Opacity="0"/>
      <ContentPresenter ContentSource="Header" Margin="12,0,8,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsSelected" Value="True">
       <Setter TargetName="Fill" Property="Background" Value="{StaticResource Raised}"/>
       <Setter TargetName="Accent" Property="Opacity" Value="1"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{StaticResource Background}"/></Trigger>
      <MultiTrigger>
       <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="True"/></MultiTrigger.Conditions>
