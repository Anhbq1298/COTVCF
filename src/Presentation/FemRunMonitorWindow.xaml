<Window x:Class="COT_VCF.Presentation.FemRunMonitorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:COT_VCF.Presentation" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls"
        Title="FEM Analysis — Run Monitor" Icon="{x:Static p:AppIcon.Window}" Width="900" Height="720" MinWidth="640" MinHeight="520"
        Background="{StaticResource Background}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="8"/>
   <RowDefinition Height="3*"/>
   <RowDefinition Height="8"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Progress -->
  <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Padding="8">
   <StackPanel>
    <DockPanel>
     <TextBlock Text="INTERNAL 2D FRAME ANALYSIS" Style="{StaticResource Subheading}"/>
     <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Text="{Binding FemMonitorProgressText}" FontFamily="{StaticResource MonoFont}" FontSize="11"/>
    </DockPanel>
    <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding FemMonitorProgress, Mode=OneWay}" IsIndeterminate="{Binding FemMonitorRunning, Mode=OneWay}" Margin="0,0,0,4"/>
    <TextBlock Text="{Binding FemProgressText}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>

  <!-- Convergence chart -->
  <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Padding="8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,6" LastChildFill="False">
     <TextBlock Text="CABLE TARGET-FORCE CONVERGENCE" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <TextBlock Text="Cable" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
     <ComboBox Width="130" ItemsSource="{Binding FemMonitorCableNames}" SelectedItem="{Binding FemMonitorCable}" VerticalAlignment="Center"
               ToolTip="Cable whose P_result / P_preset history is charted."/>
     <TextBlock Text="Target stage" FontSize="11" VerticalAlignment="Center" Margin="12,0,4,0"/>
     <ComboBox Width="240" ItemsSource="{Binding FemMonitorTargetStages}" SelectedItem="{Binding FemMonitorTargetStage}" VerticalAlignment="Center"
               ToolTip="Only stages that fit the specified cable target forces. Subsequent load cases are viewed under Results."/>
    </DockPanel>
    <c:ConvergenceChart Grid.Row="1" Ratios="{Binding FemMonitorRatios}" TolerancePercent="{Binding FemMonitorTolerancePercent}"
                        EmptyText="No pretension-fitting history for this cable yet."/>
    <TextBlock Grid.Row="2" Text="{Binding FemMonitorChartSummary}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
   </Grid>
  </Border>

  <!-- Live log -->
  <Border Grid.Row="4" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Padding="8">
   <Expander Header="Diagnostic details" IsExpanded="False">
    <ListBox x:Name="LogList" MaxHeight="150" ItemsSource="{Binding FemLog}" FontFamily="{StaticResource MonoFont}" FontSize="11"
             ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" BorderThickness="1"/>
   </Expander>
  </Border>

  <DockPanel Grid.Row="5" Margin="0,8,0,0" LastChildFill="False">
   <TextBlock DockPanel.Dock="Left" Text="One run of the model as it is defined. SAP2000 is not read or written." Style="{StaticResource Caption}" VerticalAlignment="Center"/>
   <Button DockPanel.Dock="Right" Content="Close" Click="CloseWindow" Margin="0"/>
   <Button DockPanel.Dock="Right" Content="Cancel Analysis" Command="{Binding CancelFemAnalysis}"/>
  </DockPanel>
 </Grid>
</Window>
