       <DockPanel Grid.Row="0" Margin="0,0,0,7">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
         <TextBlock Text="{Binding StudySelectionSummary}" Foreground="{StaticResource Accent}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Margin="0,0,10,0"/>
