         <Button Content="Clear All" Command="{Binding ClearAllStudyRuns}" MinHeight="24" Padding="8,2" Margin="0"/>
        </StackPanel>
        <StackPanel>
         <TextBlock Text="STUDY PREVIEW" Style="{StaticResource Subheading}" Margin="0"/>
         <TextBlock Text="{Binding BaselineModelName}" FontWeight="SemiBold" ToolTip="{Binding BaselineModelPath}"/>
        </StackPanel>
       </DockPanel>

       <Grid Grid.Row="1" Margin="0,0,0,7">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Study Root" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBox Grid.Column="1" Text="{Binding StudyRoot, Mode=OneWay}" IsReadOnly="True" ToolTip="Derived automatically from the immutable baseline model path"/>
       </Grid>

       <Grid Grid.Row="2">
        <DataGrid x:Name="StudyPreviewGrid" ItemsSource="{Binding StudyIterations}" SelectedItem="{Binding SelectedStudyIteration, Mode=TwoWay}" CanUserDeleteRows="False" FrozenColumnCount="2" IsReadOnly="{Binding IsStudyRunning}"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
         <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding RunIndex}" IsReadOnly="True" Width="38" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="SAP Model Name" Binding="{Binding SapModelName}" IsReadOnly="True" Width="180" MinWidth="160">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding ModelFullPath}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Load" Binding="{Binding LoadingCandidateId}" IsReadOnly="True" Width="56" MinWidth="48">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource IdCell}"><Setter Property="ToolTip" Value="{Binding LoadingAssignmentDetails}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Height" Binding="{Binding HeightCandidateId}" IsReadOnly="True" Width="60" MinWidth="52">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource IdCell}"><Setter Property="ToolTip" Value="{Binding HeightAssignmentDetails}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Pret." Binding="{Binding PretensionCandidateId}" IsReadOnly="True" Width="56" MinWidth="48">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource IdCell}"><Setter Property="ToolTip" Value="{Binding PretensionAssignmentDetails}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Worker" Binding="{Binding WorkerText}" IsReadOnly="True" Width="56" MinWidth="52"/>
          <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" IsReadOnly="True" Width="105" MinWidth="92">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding CurrentStageText}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="Resume" Binding="{Binding ResumeDispositionText}" IsReadOnly="True" Width="92" MinWidth="78">
           <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding ResumeReason}"/></Style></DataGridTextColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridCheckBoxColumn Header="Run" Binding="{Binding RunIterate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="48" MinWidth="46"/>
          <DataGridTemplateColumn Header="Open" Width="52" MinWidth="50" IsReadOnly="True">
           <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <Grid>
             <Button Content="Folder" MinHeight="20" Padding="4,0" Margin="0" Command="{Binding DataContext.OpenIterationFolder, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Open this iteration folder">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
             </Button>
             <Button Content="Error" MinHeight="20" Padding="4,0" Margin="0" Command="{Binding DataContext.ViewIterationError, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Show the exact SAP2000 operation that failed">
              <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
             </Button>
            </Grid>
           </DataTemplate></DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="{Binding StudyPreviewEmptyText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding ShowStudyEmptyState, Converter={StaticResource BoolVisibility}}"/>
       </Grid>

       <Border Grid.Row="3" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Margin="0,8,0,0">
        <StackPanel Margin="8">
         <DockPanel Margin="0,0,0,6">
          <ComboBox DockPanel.Dock="Right" Width="52" VerticalAlignment="Top" ItemsSource="{Binding WorkerCountOptions}" SelectedItem="{Binding RequestedWorkerCount, Mode=TwoWay}"
                    AutomationProperties.Name="SAP2000 instances" ToolTip="All 3 monitor slots stay visible; slots past this count are hatched Not in use."/>
          <StackPanel>
           <TextBlock Text="Total SAP2000 Instances" Style="{StaticResource Subheading}" Margin="0"/>
           <TextBlock Text="SAP2000 instances — defaults to 2. Worker 1 is the connected instance; 2 and 3 start in the background. Sequential per worker · parallel across workers." Style="{StaticResource Hint}" Margin="0"/>
            <TextBlock Text="{Binding RunProvenanceText}" Style="{StaticResource MonoSmall}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding ResumeStatusText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ResumeStatusText}" Margin="0,2,0,0"/>
          </StackPanel>
         </DockPanel>
         <Border Height="1" Background="{StaticResource Border}" Margin="0,0,0,6"/>
         <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="WORKER MONITOR" Style="{StaticResource Subheading}" Margin="0"/>
          <ProgressBar Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="{Binding StudyOverallProgress, Mode=OneWay}" Margin="10,3"/>
          <TextBlock Grid.Column="2" Text="{Binding StudyProgressText}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
         </Grid>
         <ItemsControl Grid.Row="1" ItemsSource="{Binding WorkerMonitorSlots}" Margin="0,6,0,5">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
           <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="7" Margin="0,0,6,0" MinHeight="86">
            <Border.Style>
             <Style TargetType="Border">
              <Setter Property="Background" Value="{StaticResource Raised}"/>
              <Style.Triggers>
               <DataTrigger Binding="{Binding InUse}" Value="False">
                <Setter Property="Background" Value="{StaticResource HatchBrush}"/>
               </DataTrigger>
              </Style.Triggers>
             </Style>
            </Border.Style>
            <Grid>
             <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
             <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding Snapshot.StateText}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="SemiBold" Visibility="{Binding ShowLive, Converter={StaticResource BoolVisibility}}"/>
              <TextBlock Text="{Binding InstanceName}" FontWeight="SemiBold"/>
             </DockPanel>
             <TextBlock Grid.Row="1" Margin="0,6,0,0" Text="{Binding StatusLabel}" Foreground="{StaticResource Muted}" FontSize="10.5"
                        Visibility="{Binding ShowStatus, Converter={StaticResource BoolVisibility}}"/>
             <Grid Grid.Row="1" Visibility="{Binding ShowLive, Converter={StaticResource BoolVisibility}}">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="{Binding Snapshot.GateText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Muted}"/>
              <DockPanel Grid.Row="1" Margin="0,4,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding Snapshot.StageProgressText}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Snapshot.CurrentIterationId, TargetNullValue=Waiting}" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis"/></DockPanel>
              <DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Right" Text="{Binding Snapshot.CompletedCount, StringFormat=Ready: {0}}" FontFamily="{StaticResource MonoFont}" FontSize="10"/><TextBlock Text="{Binding Snapshot.StageText}" FontSize="10.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Snapshot.LastMessage}"/></DockPanel>
             </Grid>
            </Grid>
           </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
         <DockPanel Grid.Row="2"><TextBlock DockPanel.Dock="Right" Text="{Binding StudyBuildStateText}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="{Binding StudyCountsText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/></DockPanel>
         </Grid>
        </StackPanel>
       </Border>

       <StackPanel Grid.Row="4">
       <Border BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Margin="0,8,0,0" Padding="8,5">
        <StackPanel>
         <DockPanel><TextBlock Text="PREFLIGHT" Style="{StaticResource Subheading}" Margin="0"/><TextBlock DockPanel.Dock="Right" Text="{Binding PreflightSummary}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PreflightSummary}"/></DockPanel>
         <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,3,0,0">
          <ItemsControl ItemsSource="{Binding PreflightMetrics}">
           <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
           <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0" Padding="0,0,10,0" Margin="0,0,10,0" ToolTip="{Binding Detail}"><StackPanel><TextBlock Text="{Binding Label}" Style="{StaticResource Hint}"/><TextBlock Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </ScrollViewer>
        </StackPanel>
       </Border>
       <Border x:Name="StudyValidationPanel" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}" Margin="0,6,0,0" MaxHeight="116">
        <Grid>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <TextBlock Text="VALIDATION ISSUES" Style="{StaticResource Subheading}" Margin="8,5,8,4"/>
         <TextBlock Grid.Row="1" Text="{Binding ValidationStatusText}" Foreground="{StaticResource Muted}" Margin="8,2,8,8"
                    Visibility="{Binding ShowValidationStatus, Converter={StaticResource BoolVisibility}}"/>
         <DataGrid Grid.Row="1" ItemsSource="{Binding Issues}" IsReadOnly="True" CanUserDeleteRows="False" HeadersVisibility="Column"
                   Visibility="{Binding HasValidationIssues, Converter={StaticResource BoolVisibility}}" MaxHeight="106">
          <DataGrid.Columns>
           <DataGridTemplateColumn Header="Go" Width="42"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Go" MinHeight="20" Padding="4,0" Margin="0" Command="{Binding DataContext.NavigateToIssue, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="76"/>
           <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="130"/>
           <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle>
           </DataGridTextColumn>
          </DataGrid.Columns>
         </DataGrid>
       </Grid>
       </Border>
       </StackPanel>
      </Grid>
     </Grid>

     <Grid Grid.Row="1" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
       <Button Content="Validate Study" Command="{Binding Validate}" Style="{StaticResource Primary}" PreviewMouseDown="ValidateEditors" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Checks the study inputs, paths, filters, outputs, and selected candidates. It does not start SAP2000 workers."
                  AutomationProperties.Name="Validate Study help" AutomationProperties.HelpText="Checks the study inputs, paths, filters, outputs, and selected candidates without starting SAP2000 workers."/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
       <Button Content="Inspect Run" Command="{Binding InspectPreviousRun}" ToolTip="Check the latest manifest against this baseline and study definition" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Compares the latest saved run with the current baseline and study settings, then identifies reusable, resumable, and retryable candidates."
                  AutomationProperties.Name="Inspect Run help" AutomationProperties.HelpText="Compares the latest saved run with the current baseline and study settings."/>
       <Button Content="Resume" Command="{Binding ResumeInterruptedStudy}" ToolTip="Continue only unfinished candidates from the latest compatible run" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Runs only unfinished candidates from the latest compatible run. Verified candidates are reused."
                  AutomationProperties.Name="Resume help" AutomationProperties.HelpText="Runs only unfinished candidates from the latest compatible run."/>
       <Button Content="Retry Failed" Command="{Binding RetryFailedStudy}" ToolTip="Dispatch only failed or cancelled candidates from the latest compatible run" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Runs only candidates that previously failed or were cancelled."
                  AutomationProperties.Name="Retry Failed help" AutomationProperties.HelpText="Runs only candidates that previously failed or were cancelled."/>
       <Button Content="Rebuild Selected" Command="{Binding RebuildSelectedModels}" ToolTip="Archive selected candidate folders, then rebuild them without overwriting" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Archives existing folders for selected rows, then rebuilds those candidates without overwriting prior files."
                  AutomationProperties.Name="Rebuild Selected help" AutomationProperties.HelpText="Archives existing folders for selected rows, then rebuilds those candidates."/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal">
       <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Opens the current baseline model's Study folder in File Explorer."
                  AutomationProperties.Name="Open Study Folder help" AutomationProperties.HelpText="Opens the current baseline model's Study folder in File Explorer."/>
      </StackPanel>
      <StackPanel Grid.Column="3" Orientation="Horizontal">
       <Button Content="Save Study" Command="{Binding SaveTabConfig}" CommandParameter="Study" ToolTip="Save Tab 05 into the active project" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Saves the study mode, filters, worker count, and run selections into the active COT VCF project."
                  AutomationProperties.Name="Save Study help" AutomationProperties.HelpText="Saves the study settings into the active COT VCF project."/>
      </StackPanel>
      <StackPanel Grid.Column="4" Orientation="Horizontal">
       <Button Content="Cancel Remaining" Command="{Binding CancelStudy}" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" ToolTip="Stops queued work at safe boundaries. Active workers finish the current SAP2000 call and return to the baseline model."
                  AutomationProperties.Name="Cancel Remaining help" AutomationProperties.HelpText="Stops queued work at safe boundaries and returns workers to the baseline model."/>
      </StackPanel>
      <StackPanel Grid.Column="5" Orientation="Horizontal">
       <Button Content="{Binding RunStudyLabel}" Command="{Binding BuildSelectedModels}" Style="{StaticResource Primary}" ToolTip="{Binding RunStudyToolTip}" Margin="0"/>
       <TextBlock Style="{StaticResource InlineHelpIcon}" Margin="3,0,0,0" ToolTip="Builds selected candidates in isolated child models, runs SAP2000 analysis, verifies results, and writes raw JSON/CSV. Reports are generated separately on Tab 06. Existing verified children are reused."
                  AutomationProperties.Name="Build and Analyze help" AutomationProperties.HelpText="Builds selected child models, runs SAP2000 analysis, verifies results, and writes raw JSON and CSV for Tab 06."/>
      </StackPanel>
     </Grid>
    </Grid>
   </TabItem>

   <!-- 06 POST-PROCESSING -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="06  POST-PROCESSING" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="Raw data → reports" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <Grid Margin="2,2,6,2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <Grid.Resources>
      <Style x:Key="PpModule" TargetType="Expander"><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Padding" Value="10,4,10,10"/></Style>
      <Style x:Key="PpDesc" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Margin" Value="0,2,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
      <Style x:Key="PpTodo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#9AA0A6"/><Setter Property="Margin" Value="0,3,0,0"/></Style>
     </Grid.Resources>

     <StackPanel Grid.Row="0" Margin="0,0,0,4">
      <TextBlock Text="POST-PROCESSING · RESULT LIBRARY" Style="{StaticResource Subheading}" Margin="0"/>
      <DockPanel Margin="0,3,0,4">
       <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
        <Button Content="Generate Outputs" Command="{Binding GeneratePostProcessOutputs}" Style="{StaticResource Primary}"
                ToolTip="Read RawData/Study_Raw_Results.json and generate Excel plus all implemented HTML reports — no SAP2000"/>
        <Button Content="Open Raw Data" Command="{Binding OpenRawDataFolder}" Margin="0"
                ToolTip="Open the JSON/CSV source folder used by Tab 06"/>
       </WrapPanel>
       <StackPanel>
        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding BaselineModelPath}">
         <Run Text="Study: " Foreground="{StaticResource Muted}"/><Run Text="{Binding BaselineModelName, Mode=OneWay}" FontWeight="SemiBold"/>
        </TextBlock>
        <TextBlock Text="{Binding RawDataSummary}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding RawJsonPath}"/>
       </StackPanel>
      </DockPanel>
     </StackPanel>

     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
      <StackPanel>

       <!-- Print Setup: header / footer of the printed reports. Per-user preference; applied on the next Generate / Regenerate. -->
       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="PRINT SETUP · HEADER / FOOTER" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Printed in the page margins of every report page: logo top-left, project and job number in the header, company, note and page numbers in the footer. Saved for this Windows user · applied on the next Generate / Regenerate · charts print as vector graphics." Style="{StaticResource PpDesc}"/>
         <Grid Margin="0,8,0,0">
          <Grid.Resources>
           <Style x:Key="PrLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
           <Style x:Key="PrText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,0,0,4"/><Setter Property="MaxLength" Value="90"/></Style>
          </Grid.Resources>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Company" Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource PrText}" AutomationProperties.Name="Company name" ToolTip="Footer, left. Printed top-left instead of the logo when no logo is set."
                   Text="{Binding PrintSettings.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Text="Project" Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="0" Grid.Column="4" Style="{StaticResource PrText}" AutomationProperties.Name="Project name" ToolTip="Header, centre — above the report name and model"
                   Text="{Binding PrintSettings.ProjectName, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Job No." Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource PrText}" AutomationProperties.Name="Job number" ToolTip="Header, right"
                   Text="{Binding PrintSettings.JobNumber, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Text="Revision" Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="1" Grid.Column="4" Style="{StaticResource PrText}" AutomationProperties.Name="Revision" ToolTip="Header, right — beside the job number"
                   Text="{Binding PrintSettings.Revision, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Prepared by" Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource PrText}" AutomationProperties.Name="Prepared by" ToolTip="Footer, left"
                   Text="{Binding PrintSettings.PreparedBy, UpdateSourceTrigger=PropertyChanged}"/>
          <TextBlock Grid.Row="2" Grid.Column="3" Text="Checked by" Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource PrText}" AutomationProperties.Name="Checked by" ToolTip="Footer, left"
                   Text="{Binding PrintSettings.CheckedBy, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Footer note" Style="{StaticResource PrLabel}"/>
          <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Style="{StaticResource PrText}" AutomationProperties.Name="Footer note" ToolTip="Footer, centre — for example a status or confidentiality line"
                   Text="{Binding PrintSettings.FooterNote, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Logo" Style="{StaticResource PrLabel}"/>
          <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,2">
           <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearPrintLogo}" Margin="4,0,0,0" ToolTip="Print the company name top-left instead of a logo"/>
           <Button DockPanel.Dock="Right" Content="Browse..." Command="{Binding BrowsePrintLogo}" Margin="6,0,0,0" ToolTip="Choose the logo printed top-left on every page — SVG, or PNG at least 600 px wide, prints sharpest"/>
           <TextBox IsReadOnly="True" Margin="0" FontFamily="{StaticResource MonoFont}" FontSize="11" AutomationProperties.Name="Logo file"
                    Text="{Binding PrintSettings.LogoPath, Mode=OneWay}" ToolTip="{Binding PrintSettings.LogoPath}"/>
          </DockPanel>
          <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding PrintLogoStatus}" FontSize="11" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PrintLogoStatus}"/>
         </Grid>
         <WrapPanel Margin="0,8,0,0">
          <TextBlock Text="Paper" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox Width="78" ItemsSource="{Binding PrintPaperSizes}" SelectedItem="{Binding PrintSettings.PaperSize}" AutomationProperties.Name="Default paper size" Margin="0,0,14,0"
                    ToolTip="Default sheet — it can still be changed in the report's Print panel"/>
          <TextBlock Text="Orientation" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox Width="104" ItemsSource="{Binding PrintOrientations}" SelectedItem="{Binding PrintSettings.Orientation}" AutomationProperties.Name="Default page orientation" Margin="0,0,14,0"
                    ToolTip="Landscape suits the wide cable charts"/>
          <CheckBox Content="Page numbers" IsChecked="{Binding PrintSettings.ShowPageNumbers}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Footer, right: Page N of M"/>
          <CheckBox Content="Date" IsChecked="{Binding PrintSettings.ShowDate}" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Header, right: the date the report was generated"/>
          <CheckBox Content="Include Source Data table" IsChecked="{Binding PrintSettings.IncludeSourceData}" VerticalAlignment="Center" ToolTip="Default for the report's print option — the full table adds many pages"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}" IsExpanded="True">
        <Expander.Header><TextBlock Text="01  DEFLECTION · Uz" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Vertical deflection profile per monitored-point group · Global Z [mm]" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="{Binding PostProcessStatus}" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
         <DataGrid ItemsSource="{Binding PostProcessRows}" IsReadOnly="True" CanUserDeleteRows="False" CanUserResizeRows="False"
                   HeadersVisibility="Column" RowHeaderWidth="0" MaxHeight="200" Margin="0,6,0,0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <DataGrid.Resources>
           <ContextMenu x:Key="PpRowMenu">
            <MenuItem Header="View Report"
                      Command="{Binding PlacementTarget.Tag.OpenCandidateDiagnostic, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding}"/>
            <MenuItem Header="Open Study Folder"
                      Command="{Binding PlacementTarget.Tag.OpenStudyFolder, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
           </ContextMenu>
          </DataGrid.Resources>
          <DataGrid.RowStyle>
           <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="ContextMenu" Value="{StaticResource PpRowMenu}"/>
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
           </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
           <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" MinWidth="120"/>
           <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="1.7*" MinWidth="180"/>
           <DataGridTemplateColumn Header="Status · output" Width="1.3*" MinWidth="150">
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
             <StackPanel Margin="0,1">
              <TextBlock Text="{Binding StatusLine}" FontSize="11.5"/>
              <TextBlock Text="{Binding OutputPath}" FontSize="9.5" Foreground="{StaticResource Muted}"
                         TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputPath}"/>
             </StackPanel>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
           </DataGridTemplateColumn>
          </DataGrid.Columns>
         </DataGrid>
         <Border Height="1" Background="{StaticResource Border}" Margin="0,10,0,8"/>
         <TextBlock Text="{Binding DeflectionReportName}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeflectionReportPath}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenDeflectionReport}" Style="{StaticResource Primary}" ToolTip="Open Deflection_Report.html in your web browser"/>
          <Button Content="Regenerate" Command="{Binding RegenerateDeflectionReport}" ToolTip="Regenerate Tab 06 outputs from RawData/Study_Raw_Results.json — no SAP"/>
          <Button Content="Export PDF" Command="{Binding ExportDeflectionPdf}" ToolTip="Print Deflection_Report.html to a vector PDF with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Excel" Command="{Binding OpenResultsWorkbook}"/>
          <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="02  TOP CHORDS" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Summary — governing axial compression max |P| [MN] per pretension candidate and truss height, with a trend line per height · View by Station for |P| along the chord" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="Member forces P / V2 / V3 [kN] · T / M2 / M3 [kNm] stay under Display in the same report · L / H / P filters · automatic envelope above 50 candidates" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="{Binding MemberForceReportName}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MemberForceReportPath}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenTopChordReport}" Style="{StaticResource Primary}" ToolTip="Open the Top Chord summary of Member_Forces_Report.html in your web browser"/>
          <Button Content="Regenerate" Command="{Binding RegenerateMemberForceReport}" ToolTip="Rebuild Member_Forces_Report.html from Study_Raw_Results.json — no SAP"/>
          <Button Content="Export PDF" Command="{Binding ExportTopChordPdf}" ToolTip="Print the Top Chord summary to Top_Chord_Report.pdf with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Excel" Command="{Binding OpenResultsWorkbook}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="03  BOTTOM CHORDS" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Summary — governing axial tension max P [MN] per pretension candidate and truss height, with a trend line per height · View by Station for P along the chord" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="Opens the Bottom Chord summary in the member-force report; the other components stay under Display." Style="{StaticResource PpDesc}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenBottomChordReport}" Style="{StaticResource Primary}" ToolTip="Open the Bottom Chord summary of Member_Forces_Report.html in your web browser"/>
          <Button Content="Export PDF" Command="{Binding ExportBottomChordPdf}" ToolTip="Print the Bottom Chord summary to Bottom_Chord_Report.pdf with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="04  VIERENDEEL MEMBERS" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Member forces — P / V2 / V3 [kN] · T / M2 / M3 [kNm]" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="Uses the same member-force report; choose the Vierendeel Members group in the report toolbar." Style="{StaticResource PpDesc}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenMemberForceReport}" Style="{StaticResource Primary}"/>
          <Button Content="Export PDF" Command="{Binding ExportMemberForcePdf}" ToolTip="Print Member_Forces_Report.html (all groups) to a vector PDF with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="05  MEGA COLUMNS" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Summary — governing axial compression max |P| [MN] per pretension candidate and truss height, with a trend line per height · no station view" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="Opens the Mega Column summary in the member-force report; the other components stay under Display." Style="{StaticResource PpDesc}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenMegaColumnReport}" Style="{StaticResource Primary}" ToolTip="Open the Mega Column summary of Member_Forces_Report.html in your web browser"/>
          <Button Content="Export PDF" Command="{Binding ExportMegaColumnPdf}" ToolTip="Print the Mega Column summary to Mega_Column_Report.pdf with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="06  SUPPORT REACTIONS" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Summary — per foundation side, vertical Fz and horizontal Fx [MN] of the inner support, the outer support and their Σ net, per pretension candidate and truss height · governing KPI cards · View by Candidate for both sides of one iteration" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="All components Fx / Fy / Fz [kN] · Mx / My / Mz [kNm] stay under View: individual supports, foundation totals, candidate matrix · result-step and L / H / P filters" Style="{StaticResource PpDesc}"/>
         <TextBlock Text="{Binding SupportReactionReportName}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SupportReactionReportPath}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenSupportReactionReport}" Style="{StaticResource Primary}" ToolTip="Open Support_Reactions_Report.html in your web browser"/>
          <Button Content="Regenerate" Command="{Binding RegenerateSupportReactionReport}" ToolTip="Rebuild Support_Reactions_Report.html from Study_Raw_Results.json — no SAP"/>
          <Button Content="Export PDF" Command="{Binding ExportSupportReactionPdf}" ToolTip="Print the Support Reactions summary (Left foundation, as the report opens) to a vector PDF with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Excel" Command="{Binding OpenResultsWorkbook}"/>
          <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
       </Expander>

       <Expander Style="{StaticResource PpModule}">
        <Expander.Header><TextBlock Text="07  CABLE FORCES · kN" Style="{StaticResource Subheading}" Margin="0"/></Expander.Header>
        <StackPanel>
         <TextBlock Text="Prestress target vs final analysed cable force · grouped by pretension candidate, truss height and user-defined cable side · force pickup/loss and design limit" Style="{StaticResource PpDesc}"/>
         <Border Height="1" Background="{StaticResource Border}" Margin="0,8,0,8"/>
         <TextBlock Text="{Binding CableForceReportName}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CableForceReportPath}"/>
         <WrapPanel Margin="0,4,0,0">
          <Button Content="View Report" Command="{Binding OpenCableForceReport}" Style="{StaticResource Primary}" ToolTip="Open Cable_Forces_Report.html in your web browser"/>
          <Button Content="Regenerate" Command="{Binding RegenerateCableForceReport}" ToolTip="Regenerate Tab 06 outputs from raw JSON using the current fpu / &#966; capacities — no SAP"/>
          <Button Content="Export PDF" Command="{Binding ExportCableForcePdf}" ToolTip="Print Cable_Forces_Report.html to a vector PDF with the Print Setup header and footer — runs Microsoft Edge in the background, no SAP"/>
          <Button Content="Open Excel" Command="{Binding OpenResultsWorkbook}"/>
          <Button Content="Open Study Folder" Command="{Binding OpenStudyFolder}" Margin="0"/>
         </WrapPanel>
        </StackPanel>
        </Expander>

       </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>

   <!-- 06A OPTIMIZATION: qualify the stored candidates against acceptance criteria, and the reports for the
        qualified set. Post-processing only; available once Tab 06 has raw data. -->
   <TabItem x:Name="OptimizationTab" IsEnabled="{Binding HasRawData}" ToolTipService.ShowOnDisabled="True"
            ToolTip="Qualify the stored candidates against acceptance criteria — available once Tab 06 has raw data">
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="06A  OPTIMIZATION" Style="{StaticResource TabHeaderTitle}"/>
      <TextBlock Text="{Binding OptimizationTabStatus}" Style="{StaticResource TabHeaderStatus}"/>
     </StackPanel>
    </TabItem.Header>
    <Grid Margin="2,2,6,2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid.Resources>
      <Style x:Key="OptEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="6,1"/><Setter Property="FontFamily" Value="{StaticResource MonoFont}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextAlignment" Value="Right"/></Style>
      <Style x:Key="OptHint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
      <Style x:Key="OptCard" TargetType="Border"><Setter Property="BorderBrush" Value="{StaticResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Padding" Value="10,6,10,9"/></Style>
     </Grid.Resources>

     <StackPanel Grid.Row="0" Margin="0,0,0,6">
      <TextBlock Text="OPTIMIZATION · QUALIFIED CANDIDATES" Style="{StaticResource Subheading}" Margin="0"/>
      <DockPanel Margin="0,3,0,0">
       <WrapPanel DockPanel.Dock="Right" Margin="12,0,0,0">
        <Button Content="Generate Optimized Reports" Command="{Binding GenerateOptimizedReports}" Style="{StaticResource Primary}"
                ToolTip="Write the reports for the qualified candidates only into Study/Optimized — the full Tab 06 reports are not touched · no SAP2000"/>
        <Button Content="Open Optimized Folder" Command="{Binding OpenOptimizedFolder}" Margin="0"
                ToolTip="Open Study/Optimized in File Explorer"/>
       </WrapPanel>
       <StackPanel>
        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding BaselineModelPath}">
         <Run Text="Study: " Foreground="{StaticResource Muted}"/><Run Text="{Binding BaselineModelName, Mode=OneWay}" FontWeight="SemiBold"/>
        </TextBlock>
        <TextBlock Text="{Binding OptimizationRawSummary}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Muted}"
                   TextTrimming="CharacterEllipsis" ToolTip="{Binding RawJsonPath}"/>
       </StackPanel>
      </DockPanel>
     </StackPanel>

     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <!-- criteria -->
      <Border x:Name="OptimizationCriteria" Style="{StaticResource OptCard}">
       <StackPanel>
        <TextBlock Text="CRITERIA" Style="{StaticResource Subheading}" Margin="0"/>
        <TextBlock Style="{StaticResource OptHint}" Margin="0,2,0,0"
                   Text="A candidate is qualified when it passes every active criterion. Post-processing only — changing a criterion never invalidates a run."/>

        <CheckBox Content="Deflection within range" FontWeight="SemiBold" Margin="0,8,0,0" AutomationProperties.Name="Deflection criterion"
                  IsChecked="{Binding State.OutputSettings.DeflectionCriterionEnabled}"
                  ToolTip="Min ≤ δ ≤ Max, where δ is the candidate's peak downward deflection −min(Uz) over the monitored points"/>
        <Grid Margin="20,4,0,0" IsEnabled="{Binding State.OutputSettings.DeflectionCriterionEnabled}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="δ  peak ↓Uz" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBox Grid.Column="1" Style="{StaticResource OptEditor}" AutomationProperties.Name="Qualifying deflection minimum [mm]"
                  ToolTip="Min peak downward deflection [mm] — blank = no lower limit"
                  Text="{Binding State.OutputSettings.DeflectionLimitMinMm, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Grid.Column="2" Text="–" FontSize="11" VerticalAlignment="Center" Margin="6,0"/>
         <TextBox Grid.Column="3" Style="{StaticResource OptEditor}" AutomationProperties.Name="Qualifying deflection maximum [mm]"
                  ToolTip="Max peak downward deflection [mm] — blank = no upper limit"
                  Text="{Binding State.OutputSettings.DeflectionLimitMaxMm, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Grid.Column="4" Text="mm" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>
        <TextBlock Text="{Binding DeflectionStudyRange}" Style="{StaticResource OptHint}" Margin="20,3,0,0"/>

        <CheckBox Content="Cable forces below the limit" FontWeight="SemiBold" Margin="0,9,0,0" AutomationProperties.Name="Cable force criterion"
                  IsChecked="{Binding State.OutputSettings.CableCriterionEnabled}"
                  ToolTip="Every cable's final analysed force stays within the limit — a share of its Tab 03 design capacity"/>
        <Grid Margin="20,4,0,0" IsEnabled="{Binding State.OutputSettings.CableCriterionEnabled}">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="force / design capacity  ≤" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBox Grid.Column="1" Style="{StaticResource OptEditor}" AutomationProperties.Name="Cable utilisation limit"
                  ToolTip="Largest allowed final force / design capacity of any cable — 1.00 = 100 % of the Tab 03 capacity (area × fpu × φ)"
                  Text="{Binding State.OutputSettings.MaxCableUtilization, Converter={StaticResource NullableDouble}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
         <TextBlock Grid.Column="2" Text="1.00 = 100 % of the Tab 03 capacity" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <TextBlock Text="{Binding CableStudyRange}" Style="{StaticResource OptHint}" Margin="20,3,0,0"/>

        <TextBlock Text="{Binding OptimizationProblem}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Error}" TextWrapping="Wrap" Margin="0,7,0,0">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding HasOptimizationProblem}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <DockPanel Margin="0,8,0,0">
         <Button DockPanel.Dock="Right" Content="Save Criteria" Command="{Binding SaveTabConfig}" CommandParameter="Output" Margin="8,0,0,0" VerticalAlignment="Bottom"
                 ToolTip="Save the criteria into the active project, with the Tab 04 output settings they belong to"/>
         <TextBlock Style="{StaticResource OptHint}" VerticalAlignment="Center"
                    Text="The deflection range is the Tab 04 limit band — one value, edited in either place, and the band shaded in the Deflection report."/>
        </DockPanel>
       </StackPanel>
      </Border>

      <!-- result and the optimized report set -->
      <Border x:Name="OptimizationResult" Grid.Column="2" Style="{StaticResource OptCard}">
       <StackPanel>
        <TextBlock Text="RESULT" Style="{StaticResource Subheading}" Margin="0"/>
        <TextBlock Text="{Binding OptimizationHeadline}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,2,0,0" AutomationProperties.Name="Qualified candidates"/>
        <TextBlock Text="{Binding OptimizationBreakdown}" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding OptimizationCriteriaNote}" Style="{StaticResource OptHint}" Margin="0,3,0,0"/>
        <Border Height="1" Background="{StaticResource Border}" Margin="0,9,0,7"/>
        <TextBlock Text="OPTIMIZED REPORTS" Style="{StaticResource Subheading}" Margin="0"/>
        <TextBlock Text="{Binding OptimizedReportsStatus}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.Name="Optimized reports status">
         <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers><DataTrigger Binding="{Binding OptimizedReportsStale}" Value="True"><Setter Property="Foreground" Value="{StaticResource Warning}"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Style="{StaticResource OptHint}" Margin="0,3,0,0"
                   Text="The same charts as Tab 06, for the qualified candidates only, in Study/Optimized. A combination that did not qualify is left blank and marked NQ."/>
        <WrapPanel Margin="0,6,0,0">
         <Button Content="View Summary" Command="{Binding OpenOptimizationSummary}" Style="{StaticResource Primary}" ToolTip="Open Optimization_Summary.html — criteria, counts, the acceptance map and the qualified candidates"/>
         <Button Content="Deflection" Command="{Binding OpenOptimizedDeflection}" ToolTip="Deflection report of the qualified candidates"/>
         <Button Content="Top Chord" Command="{Binding OpenOptimizedTopChord}" ToolTip="Top Chord summary of the qualified candidates"/>
         <Button Content="Bottom Chord" Command="{Binding OpenOptimizedBottomChord}" ToolTip="Bottom Chord summary of the qualified candidates"/>
         <Button Content="Mega Column" Command="{Binding OpenOptimizedMegaColumn}" ToolTip="Mega Column summary of the qualified candidates"/>
         <Button Content="Member Forces" Command="{Binding OpenOptimizedMemberForces}" ToolTip="Member-force report of the qualified candidates — every group"/>
         <Button Content="Support Reactions" Command="{Binding OpenOptimizedSupportReactions}" ToolTip="Support Reactions summary of the qualified candidates"/>
         <Button Content="Cable Forces" Command="{Binding OpenOptimizedCableForces}" Margin="0" ToolTip="Cable Forces report of the qualified candidates"/>
        </WrapPanel>
       </StackPanel>
      </Border>
     </Grid>

     <DockPanel Grid.Row="2" Margin="0,8,0,4">
      <ComboBox DockPanel.Dock="Right" Width="126" ItemsSource="{Binding OptimizationFilters}" SelectedItem="{Binding OptimizationFilter}" AutomationProperties.Name="Candidate status filter"
                ToolTip="Show every candidate or one status"/>
      <TextBlock DockPanel.Dock="Right" Text="Show" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
      <TextBlock Text="CANDIDATES" Style="{StaticResource Subheading}" Margin="0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding OptimizationTableSummary}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
     </DockPanel>
     <DataGrid x:Name="OptimizationGrid" Grid.Row="3" ItemsSource="{Binding OptimizationRows}" IsReadOnly="True" AutoGenerateColumns="False"
               CanUserDeleteRows="False" CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
               EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Iteration" Binding="{Binding IterationKey}" Width="128"/>
       <DataGridTextColumn Header="Load" Binding="{Binding LoadId}" Width="54"/>
       <DataGridTextColumn Header="Height" Binding="{Binding Height}" Width="62"/>
       <DataGridTextColumn Header="Pretension" Binding="{Binding PretensionId}" Width="80"/>
       <DataGridTextColumn Header="δ [mm]" Binding="{Binding PeakDownMm, StringFormat={}{0:0.0}, TargetNullValue=—}" Width="74" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Cable util. [%]" Binding="{Binding UtilisationPercent, StringFormat={}{0:0.0}, TargetNullValue=—}" Width="98" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Governing cable" Binding="{Binding GoverningCable}" Width="118"/>
       <DataGridTemplateColumn Header="Status" Width="108" SortMemberPath="Status">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
         <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0">
          <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
           <Setter Property="Foreground" Value="{StaticResource Muted}"/>
           <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="Qualified"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="Not qualified"><Setter Property="Foreground" Value="{StaticResource Error}"/></DataTrigger>
           </Style.Triggers>
          </Style></TextBlock.Style>
         </TextBlock>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
       </DataGridTemplateColumn>
       <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" MinWidth="220">
        <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Reason}"/></Style></DataGridTextColumn.ElementStyle>
       </DataGridTextColumn>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </TabItem>

  </TabControl>

  <GridSplitter x:Name="ViewerSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Border}"/>

  <DockPanel x:Name="SharedViewerPane" Grid.Column="2" Margin="10,10,10,10" LastChildFill="True">
   <TextBlock DockPanel.Dock="Top" Text="{Binding SharedViewerCaption}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
   <TextBlock DockPanel.Dock="Bottom" Text="{Binding SharedViewerHint}" Style="{StaticResource Hint}" Margin="2,6,0,0"/>
   <Grid>
    <c:Structural2DViewer x:Name="SharedViewer" ShowPointLabels="True"
                          Model="{Binding SharedViewerModel}"
                          AppliedPoints="{Binding SharedViewerAppliedPoints}"
                          SelectedAppliedPoint="{Binding SelectedAppliedPoint, Mode=TwoWay}"
                          TopPoints="{Binding SharedViewerTopPoints}"
                          MiddlePoints="{Binding SharedViewerMiddlePoints}"
                          BottomPoints="{Binding SharedViewerBottomPoints}"
                          Cables="{Binding SharedViewerCables}"
                          SelectedCable="{Binding SelectedCable, Mode=TwoWay}"
                          AutomationProperties.Name="Shared structural model preview"/>
    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,8" Background="{StaticResource Overlay}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="3" Padding="6,3"
            Visibility="{Binding ShowTrussLegend, Converter={StaticResource BoolVisibility}}">
     <StackPanel Orientation="Horizontal">
      <Ellipse Width="8" Height="8" Fill="{StaticResource ChordTop}" VerticalAlignment="Center"/><TextBlock Text="Top" Style="{StaticResource Caption}" Margin="4,0,10,0"/>
      <Ellipse Width="8" Height="8" Fill="{StaticResource ChordMiddle}" VerticalAlignment="Center"/><TextBlock Text="Middle" Style="{StaticResource Caption}" Margin="4,0,10,0"/>
      <Ellipse Width="8" Height="8" Fill="{StaticResource ChordBottom}" VerticalAlignment="Center"/><TextBlock Text="Bottom" Style="{StaticResource Caption}" Margin="4,0,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </DockPanel>
 </Grid>
 </DockPanel>
</Window>
