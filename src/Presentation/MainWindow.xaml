<Window x:Class="COT_VCF.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls" Title="COT VCF tools" Width="1366" Height="768" MinWidth="1060" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Connect" Command="{Binding Connect}" Style="{StaticResource Primary}" Margin="0,0,8,0"/><Button Command="{Binding Refresh}" ToolTip="Refresh connection and geometry" Width="40" Padding="10,8" Margin="0,0,16,0"><Viewbox Width="16" Height="16"><Path Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M14,5 A6,6 0 1 0 16,11 M16,11 L16,6 M16,11 L11,11"/></Viewbox></Button><TextBlock Text="{Binding State.Connection}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,16,0"/><Button Content="Help" Click="ShowHelp" Margin="0"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="COT VCF tools" FontSize="20" FontWeight="Bold"/><TextBlock Text="PARAMETRIC STRUCTURAL WORKFLOW" Margin="24,0,0,0" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8"><StackPanel><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State.Units}" FontFamily="Consolas" Margin="16,0,0,0"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></StackPanel></Border>
   <TabControl x:Name="WorkflowTabs" SelectedIndex="{Binding SelectedTab}" TabStripPlacement="Left" Background="{StaticResource Background}" BorderThickness="0" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <TabItem><TabItem.Header><StackPanel Width="150"><TextBlock Text="01  SAP MODEL" Foreground="{StaticResource Surface}" FontWeight="SemiBold"/><TextBlock Text="{Binding SapStatus}" Foreground="#D8E8F8" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <c:Structural2DViewer Grid.Row="0" Model="{Binding State.Geometry}"/>
     <TextBlock Grid.Row="1" Text="{Binding GeometrySummary}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="150"><TextBlock Text="02  LOADING CRITERIA" Foreground="{StaticResource Surface}" FontWeight="SemiBold"/><TextBlock Text="{Binding LoadStatus}" Foreground="#D8E8F8" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="45*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="55*"/></Grid.ColumnDefinitions>
      <c:Structural2DViewer Grid.Column="0" Model="{Binding State.Geometry}" ShowPointLabels="True" AppliedPoints="{Binding State.AppliedPoints}" SelectedAppliedPoint="{Binding SelectedAppliedPoint, Mode=TwoWay}"/>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
      <Grid Grid.Column="2" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="42*"/><RowDefinition Height="12"/><RowDefinition Height="58*"/></Grid.RowDefinitions>
       <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
         <TextBlock Text="{Binding AppliedPointsTitle}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
         <WrapPanel Grid.Row="1" Margin="0,0,0,8"><Button Content="+ Add Load Locations" Command="{Binding AddPoints}"/><Button Content="Remove selected" Command="{Binding RemoveAppliedPoints}" CommandParameter="{Binding SelectedItems, ElementName=AppliedPointsGrid}" MinHeight="30" Padding="10,4" FontSize="12"/></WrapPanel>
         <DataGrid x:Name="AppliedPointsGrid" Grid.Row="2" ItemsSource="{Binding State.AppliedPoints}" SelectedItem="{Binding SelectedAppliedPoint, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" SelectionChanged="AppliedPoints_SelectionChanged" CanUserDeleteRows="False">
          <DataGrid.Columns>
           <DataGridTextColumn Header="Order" Binding="{Binding Order}" IsReadOnly="True" Width=".55*" MinWidth="50" ElementStyle="{StaticResource NumericCell}"/>
           <DataGridTextColumn Header="Point Name" Binding="{Binding PointName}" IsReadOnly="True" Width="1.1*" MinWidth="90"/>
           <DataGridTextColumn Header="X [m]" Binding="{Binding X, StringFormat=F3}" IsReadOnly="True" Width=".8*" MinWidth="68" ElementStyle="{StaticResource NumericCell}"/>
           <DataGridTextColumn Header="Z [m]" Binding="{Binding Z, StringFormat=F3}" IsReadOnly="True" Width=".8*" MinWidth="68" ElementStyle="{StaticResource NumericCell}"/>
           <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1.05*" MinWidth="82"/>
          </DataGrid.Columns>
         </DataGrid>
        </Grid>
       </Border>
       <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
        <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="LOAD DEFINITION" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,0,8"/>
         <DockPanel Grid.Row="1" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="View Candidates" Click="ViewCandidates_Click" MinHeight="30" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Top"/><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Out-of-plane tributary width, B" Width="220" Margin="0,0,12,8"/><c:EngineeringInput Label="" Value="{Binding State.TributaryWidthB}" Unit="m" Minimum="0.000000001" Margin="0"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="NStories" Width="220" Margin="0,0,12,8"/><c:EngineeringInput Label="" Value="{Binding State.NumberOfStories}" Unit="stories" Minimum="1" Maximum="2147483647" Increment="1" WholeNumbersOnly="True" Margin="0"/></StackPanel></StackPanel></DockPanel>
         <DataGrid x:Name="LoadDefinitionsGrid" Grid.Row="2" ItemsSource="{Binding State.LoadDefinitions}" IsEnabled="{Binding IsIdle}" CanUserDeleteRows="False" SelectionMode="Single" FrozenColumnCount="0">
          <DataGrid.Resources>
           <Style x:Key="LoadValueEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="TextAlignment" Value="Right"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Raised}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger></Style.Triggers>
           </Style>
          </DataGrid.Resources>
          <DataGrid.Columns>
           <DataGridTextColumn Header="Load Name" Binding="{Binding LoadName, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" MinWidth="90"/>
           <DataGridTemplateColumn Width="1.05*" MinWidth="82"><DataGridTemplateColumn.Header><TextBlock Text="Apply Increment Step?" TextWrapping="Wrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ApplyIncrementStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTemplateColumn Header="qz [kPa]" Width=".75*" MinWidth="66"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding IsSingleValue}" Text="{Binding Qz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTemplateColumn Width=".9*" MinWidth="80"><DataGridTemplateColumn.Header><TextBlock Text="Min Range qz [kPa]" TextWrapping="Wrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding MinQz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTemplateColumn Width=".9*" MinWidth="80"><DataGridTemplateColumn.Header><TextBlock Text="Max Range qz [kPa]" TextWrapping="Wrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding MaxQz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTemplateColumn Width=".9*" MinWidth="80"><DataGridTemplateColumn.Header><TextBlock Text="Increment Step [kPa]" TextWrapping="Wrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding IncrementStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
           <DataGridTemplateColumn Width="40" MinWidth="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding DataContext.DeleteLoadDefinition, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete load definition" Width="30" Height="28" MinHeight="28" Padding="7" Margin="0"><Viewbox Width="12" Height="12"><Path Stroke="{StaticResource Error}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14 M14,2 L2,14"/></Viewbox></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          </DataGrid.Columns>
         </DataGrid>
         <Button Grid.Row="3" Content="+ Add Load" Command="{Binding AddLoadDefinition}" Click="AddLoad_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </Grid>
       </Border>
      </Grid>
     </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="150"><TextBlock Text="03  TRUSS HEIGHT" Foreground="{StaticResource Surface}" FontWeight="SemiBold"/><TextBlock Text="{Binding TrussStatus}" Foreground="#D8E8F8" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
      <Grid>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
       <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding HeightSummary}" FontFamily="Consolas" Margin="0,0,0,8"/><c:Structural2DViewer Grid.Row="1" Model="{Binding State.Preview}"/><TextBlock Grid.Row="2" Text="{Binding PreviewMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></Grid>
       <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
       <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsIdle}" Margin="16,0,0,0">
       <TextBlock Text="POINT GROUPS" Style="{StaticResource Subheading}"/>
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Top" Margin="8,0,0,0"/><StackPanel><TextBlock Text="Top truss points" FontWeight="SemiBold"/><TextBlock Text="{Binding TopSummary}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Middle" Margin="8,0,0,0"/><StackPanel><TextBlock Text="Middle truss points" FontWeight="SemiBold"/><TextBlock Text="{Binding MiddleSummary}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Bottom" Margin="8,0,0,0"/><StackPanel><TextBlock Text="Bottom truss points" FontWeight="SemiBold"/><TextBlock Text="{Binding BottomSummary}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <TextBlock Text="{Binding GroupWarning}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
       <Button Content="Capture baseline" Command="{Binding CaptureBaseline}" Margin="0,0,0,16"/>
       <TextBlock Text="HEIGHT RANGE" Style="{StaticResource Subheading}"/>
       <c:EngineeringInput Label="Minimum height" Value="{Binding State.Truss.MinimumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Maximum height" Value="{Binding State.Truss.MaximumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Increment step" Value="{Binding State.Truss.Increment}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Preview height" Value="{Binding State.Truss.CurrentHeight}" Unit="{Binding LengthUnit}"/>
       <Slider Minimum="{Binding State.Truss.MinimumHeight}" Maximum="{Binding State.Truss.MaximumHeight}" TickFrequency="{Binding State.Truss.Increment}" Value="{Binding State.Truss.CurrentHeight}" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,8,0,16" AutomationProperties.Name="Preview truss height"/>
       <Button Content="Reset preview" Command="{Binding ResetPreview}" Margin="0,0,0,8"/><Button Content="Apply geometry to SAP2000" Command="{Binding ApplyGeometry}" Style="{StaticResource Primary}" Margin="0,0,0,8" PreviewMouseDown="ValidateEditors"/>
      </StackPanel></ScrollViewer>
      </Grid>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="150"><TextBlock Text="04  CABLE FORCE" Foreground="{StaticResource Surface}" FontWeight="SemiBold"/><TextBlock Text="{Binding CableStatus}" Foreground="#D8E8F8" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16"><Button Content="+ Add cable / tendon" Command="{Binding AddCables}"/><Button Content="Remove selected" Command="{Binding RemoveCables}" CommandParameter="{Binding SelectedItems, ElementName=Cables}"/><TextBlock Text="{Binding ForceUnit, StringFormat=All force values [{0}]}" Margin="16,0"/></StackPanel>
      <DataGrid x:Name="Cables" Grid.Row="1" ItemsSource="{Binding State.Cables}" IsEnabled="{Binding IsIdle}"><DataGrid.Columns>
       <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" IsReadOnly="True" Width="1.2*" MinWidth="120"/><DataGridTextColumn Header="Force source" Binding="{Binding Source}" IsReadOnly="True" Width="1.8*" MinWidth="170"/>
       <DataGridTextColumn Header="Current" Binding="{Binding CurrentForce, StringFormat=F4, TargetNullValue=Unavailable}" IsReadOnly="True" Width=".9*" MinWidth="95" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".85*" MinWidth="90" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Maximum" Binding="{Binding MaximumForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".85*" MinWidth="90" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Step" Binding="{Binding Increment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".7*" MinWidth="80" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Target" Binding="{Binding TargetForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".85*" MinWidth="90" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1.5*" MinWidth="160"/>
     </DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="2" Text="Range edits do not modify SAP2000. Use the Iteration tab to validate the configuration." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="150"><TextBlock Text="05  ITERATION" Foreground="{StaticResource Surface}" FontWeight="SemiBold"/><TextBlock Text="Next phase" Foreground="#D8E8F8" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
     <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><TextBlock Text="{Binding IterationSummary}" TextWrapping="Wrap" FontFamily="Consolas" LineHeight="24" Margin="0,0,24,0"/></ScrollViewer><DataGrid Grid.Column="1" ItemsSource="{Binding Issues}" IsReadOnly="True" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="120"/><DataGridTextColumn Header="Review required" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Grid>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Validate inputs" Command="{Binding Validate}" Style="{StaticResource Primary}" PreviewMouseDown="ValidateEditors"/><Button Content="Run iteration — next phase" IsEnabled="False"/></StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
