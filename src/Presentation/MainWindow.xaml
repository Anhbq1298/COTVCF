<Window x:Class="COT_VCF.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls" Title="COT VCF tools" Width="1366" Height="768" MinWidth="1060" MinHeight="650" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="24,16"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="{Binding State.Connection}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,16,0"/><Button Content="Help" Click="ShowHelp" Margin="0"/></StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="COT VCF tools" FontSize="20" FontWeight="Bold"/><TextBlock Text="PARAMETRIC STRUCTURAL WORKFLOW" Margin="24,0,0,0" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,8"><StackPanel><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8"/><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State.Units}" FontFamily="Consolas" Margin="16,0,0,0"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></StackPanel></Border>
  <TabControl x:Name="WorkflowTabs" SelectedIndex="{Binding SelectedTab}" TabStripPlacement="Left" Background="{StaticResource Background}" BorderThickness="0" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
   <TabItem><TabItem.Header><StackPanel Width="160"><TextBlock Text="01  SAP MODEL" FontWeight="SemiBold"/><TextBlock Text="{Binding SapStatus}" Foreground="{StaticResource Muted}" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="01 — SAP model" Style="{StaticResource Heading}"/><TextBlock Text="Connect and inspect the active structural model." Style="{StaticResource Hint}"/></StackPanel>
     <Border Grid.Row="1" Padding="16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><Button Content="Connect to SAP2000" Command="{Binding Connect}" Style="{StaticResource Primary}" Margin="0,0,0,8"/><Button Content="Get geometry / Refresh" Command="{Binding Refresh}" Margin="0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding ModelName}" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="{Binding ModelPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelPath}" Margin="0,4,0,8"/><WrapPanel><TextBlock Text="SAP version: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding ModelVersion}" Margin="0,0,24,0"/><TextBlock Text="{Binding State.Units}" FontFamily="Consolas" Margin="0,0,24,0"/><TextBlock Text="{Binding LockState}"/></WrapPanel></StackPanel></Grid></Border>
     <c:Structural2DViewer Grid.Row="2" Model="{Binding State.Geometry}"/>
     <TextBlock Grid.Row="3" Text="{Binding GeometrySummary}" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="160"><TextBlock Text="02  POINT LOADING" FontWeight="SemiBold"/><TextBlock Text="{Binding LoadStatus}" Foreground="{StaticResource Muted}" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="02 — Point loading" Style="{StaticResource Heading}"/><TextBlock Text="Define global-axis forces. Apply replaces the selected point / pattern forces and preserves existing moments." Style="{StaticResource Hint}"/></StackPanel>
     <DockPanel Grid.Row="1" Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Apply to SAP2000" Command="{Binding ApplyLoads}" Style="{StaticResource Primary}" PreviewMouseDown="ValidateEditors"/><StackPanel Orientation="Horizontal"><Button Content="+ Add point" Command="{Binding AddPoints}"/><Button Content="Remove selected" Command="{Binding RemoveLoads}" CommandParameter="{Binding SelectedItems, ElementName=Loads}"/><TextBlock Text="{Binding ForceUnit, StringFormat=Force unit: {0}}" Margin="16,0"/></StackPanel></DockPanel>
     <DataGrid x:Name="Loads" Grid.Row="2" ItemsSource="{Binding State.PointLoads}" IsEnabled="{Binding IsIdle}">
      <DataGrid.Columns><DataGridTextColumn Header="Point name" Binding="{Binding PointName}" IsReadOnly="True" Width="*"/>
       <DataGridTemplateColumn Header="Load pattern" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding DataContext.State.LoadPatterns, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding LoadPattern, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn x:Name="FxColumn" Header="Fx" Binding="{Binding Fx, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
       <DataGridTextColumn x:Name="FyColumn" Header="Fy" Binding="{Binding Fy, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
       <DataGridTextColumn x:Name="FzColumn" Header="Fz" Binding="{Binding Fz, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" ElementStyle="{StaticResource NumericCell}" Width="110"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="160"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="3" Text="Edits remain pending until Apply. Select rows and press Delete to remove; Ctrl+C copies selected rows." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="160"><TextBlock Text="03  TRUSS HEIGHT" FontWeight="SemiBold"/><TextBlock Text="{Binding TrussStatus}" Foreground="{StaticResource Muted}" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="03 — Truss height" Style="{StaticResource Heading}"/><TextBlock Text="Top points stay fixed. Middle points move by −½ ΔH; bottom points by −ΔH, from the captured baseline." Style="{StaticResource Hint}"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding IsIdle}" Margin="0,0,8,0">
       <TextBlock Text="POINT GROUPS" Style="{StaticResource Subheading}"/>
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Top" Margin="8,0,0,0"/><StackPanel><TextBlock Text="Top truss points" FontWeight="SemiBold"/><TextBlock Text="{Binding TopSummary}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Middle" Margin="8,0,0,0"/><StackPanel><TextBlock Text="Middle truss points" FontWeight="SemiBold"/><TextBlock Text="{Binding MiddleSummary}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <DockPanel Margin="0,0,0,16"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Bottom" Margin="8,0,0,0"/><StackPanel><TextBlock Text="Bottom truss points" FontWeight="SemiBold"/><TextBlock Text="{Binding BottomSummary}" Foreground="{StaticResource Muted}"/></StackPanel></DockPanel>
       <TextBlock Text="{Binding GroupWarning}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
       <Button Content="Capture baseline" Command="{Binding CaptureBaseline}" Margin="0,0,0,16"/>
       <TextBlock Text="HEIGHT RANGE" Style="{StaticResource Subheading}"/>
       <c:EngineeringInput Label="Minimum height" Value="{Binding State.Truss.MinimumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Maximum height" Value="{Binding State.Truss.MaximumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Increment step" Value="{Binding State.Truss.Increment}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Preview height" Value="{Binding State.Truss.CurrentHeight}" Unit="{Binding LengthUnit}"/>
       <Slider Minimum="{Binding State.Truss.MinimumHeight}" Maximum="{Binding State.Truss.MaximumHeight}" TickFrequency="{Binding State.Truss.Increment}" Value="{Binding State.Truss.CurrentHeight}" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,8,0,16" AutomationProperties.Name="Preview truss height"/>
       <Button Content="Reset preview" Command="{Binding ResetPreview}" Margin="0,0,0,8"/><Button Content="Apply geometry to SAP2000" Command="{Binding ApplyGeometry}" Style="{StaticResource Primary}" Margin="0,0,0,8" PreviewMouseDown="ValidateEditors"/>
      </StackPanel></ScrollViewer>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding HeightSummary}" FontFamily="Consolas" Margin="0,0,0,8"/><c:Structural2DViewer Grid.Row="1" Model="{Binding State.Preview}"/><TextBlock Grid.Row="2" Text="{Binding PreviewMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" Margin="0,8,0,0"/></Grid>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="160"><TextBlock Text="04  CABLE FORCE" FontWeight="SemiBold"/><TextBlock Text="{Binding CableStatus}" Foreground="{StaticResource Muted}" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="04 — Cable force" Style="{StaticResource Heading}"/><TextBlock Text="Configure discrete trial ranges. Current values are cable shape tensions or tendon prestress assignments, not analysis results." Style="{StaticResource Hint}"/></StackPanel>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"><Button Content="+ Add cable / tendon" Command="{Binding AddCables}"/><Button Content="Remove selected" Command="{Binding RemoveCables}" CommandParameter="{Binding SelectedItems, ElementName=Cables}"/><TextBlock Text="{Binding ForceUnit, StringFormat=All force values [{0}]}" Margin="16,0"/></StackPanel>
     <DataGrid x:Name="Cables" Grid.Row="2" ItemsSource="{Binding State.Cables}" IsEnabled="{Binding IsIdle}"><DataGrid.Columns>
      <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" IsReadOnly="True" Width="120"/><DataGridTextColumn Header="Force source" Binding="{Binding Source}" IsReadOnly="True" Width="190"/>
      <DataGridTextColumn Header="Current" Binding="{Binding CurrentForce, StringFormat=F4, TargetNullValue=Unavailable}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Minimum" Binding="{Binding MinimumForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width="90" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Maximum" Binding="{Binding MaximumForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width="90" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Step" Binding="{Binding Increment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width="90" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Target" Binding="{Binding TargetForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width="90" ElementStyle="{StaticResource NumericCell}"/>
      <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="220"/>
     </DataGrid.Columns></DataGrid>
     <TextBlock Grid.Row="3" Text="Range edits do not modify SAP2000. Use the Iteration tab to validate the configuration." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
    </Grid>
   </TabItem>
   <TabItem><TabItem.Header><StackPanel Width="160"><TextBlock Text="05  ITERATION" FontWeight="SemiBold"/><TextBlock Text="Next phase" Foreground="{StaticResource Muted}" Margin="24,8,0,0" FontSize="11"/></StackPanel></TabItem.Header>
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="05 — Iteration" Style="{StaticResource Heading}"/><TextBlock Text="Review the upstream configuration. Automated analysis and optimization are planned for the next phase." Style="{StaticResource Hint}"/></StackPanel>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ScrollViewer><TextBlock Text="{Binding IterationSummary}" TextWrapping="Wrap" FontFamily="Consolas" LineHeight="24" Margin="0,0,24,0"/></ScrollViewer><DataGrid Grid.Column="1" ItemsSource="{Binding Issues}" IsReadOnly="True" CanUserDeleteRows="False"><DataGrid.Columns><DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="120"/><DataGridTextColumn Header="Review required" Binding="{Binding Message}" Width="*"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns></DataGrid></Grid>
     <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Validate inputs" Command="{Binding Validate}" Style="{StaticResource Primary}" PreviewMouseDown="ValidateEditors"/><Button Content="Run iteration — next phase" IsEnabled="False"/></StackPanel>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</Window>
