<Window x:Class="COT_VCF.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls" Title="COT VCF tools" Icon="{StaticResource AppLogo}" Width="1440" Height="810" MinWidth="1100" MinHeight="660" WindowStartupLocation="CenterScreen">
 <DockPanel>

  <!-- ============================ TOP BAR ============================ -->
  <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="&#9679;" Margin="0,0,5,0">
      <TextBlock.Style>
       <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Style.Triggers>
         <DataTrigger Binding="{Binding State.IsSapConnected}" Value="True"><Setter Property="Foreground" Value="{StaticResource Success}"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </TextBlock.Style>
     </TextBlock>
     <TextBlock Text="{Binding StatusLine}" Foreground="{StaticResource Muted}" FontSize="11" FontFamily="Consolas" Margin="0,0,12,0"/>
     <Button Content="Connect SAP" Command="{Binding Connect}" Style="{StaticResource Primary}"/>
     <Button Command="{Binding Refresh}" Style="{StaticResource IconButton}" ToolTip="Refresh connection and geometry">
      <Viewbox Width="15" Height="15"><Path Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Data="M14,5 A6,6 0 1 0 16,11 M16,11 L16,6 M16,11 L11,11"/></Viewbox>
     </Button>
     <Button Content="Help" Click="ShowHelp" Margin="0"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Image Source="{StaticResource AppLogo}" Width="20" Height="20" Margin="0,0,8,0"/>
     <TextBlock Text="COT VCF tools" FontSize="13" FontWeight="Bold"/>
     <TextBlock Text="PARAMETRIC STRUCTURAL WORKFLOW" Margin="12,1,0,0" Foreground="{StaticResource Muted}" FontSize="10"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- ========================== STATUS BAR ========================== -->
  <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="10,4">
   <StackPanel>
    <ProgressBar Height="2" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,4"/>
    <DockPanel>
     <TextBlock DockPanel.Dock="Right" Text="{Binding State.Units}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/>
     <TextBlock Text="{Binding Message}" FontSize="11" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
    </DockPanel>
   </StackPanel>
  </Border>

  <!-- ====================== LEFT WORKFLOW TABS ====================== -->
  <TabControl x:Name="WorkflowTabs" SelectedIndex="{Binding SelectedTab}" TabStripPlacement="Left" Background="{StaticResource Background}" BorderThickness="0" Padding="10" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

   <!-- 01 SAP MODEL -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="01  SAP MODEL" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
      <TextBlock Text="{Binding SapStatus}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
     </StackPanel>
    </TabItem.Header>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <c:Structural2DViewer Grid.Row="0" Model="{Binding State.Geometry}" ShowPointLabels="True"/>
     <TextBlock Grid.Row="1" Text="{Binding GeometrySummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,6,0,0"/>
    </Grid>
   </TabItem>

   <!-- 02 LOADING CRITERIA -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="02  LOADING" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
      <TextBlock Text="{Binding LoadStatus}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
     </StackPanel>
    </TabItem.Header>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="62*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="38*"/></Grid.ColumnDefinitions>
     <c:Structural2DViewer Grid.Column="0" Model="{Binding State.Geometry}" ShowPointLabels="True" AppliedPoints="{Binding State.AppliedPoints}" SelectedAppliedPoint="{Binding SelectedAppliedPoint, Mode=TwoWay}"/>
     <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
     <Grid Grid.Column="2" Margin="10,0,0,0">
      <Grid.RowDefinitions><RowDefinition Height="44*"/><RowDefinition Height="8"/><RowDefinition Height="56*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
       <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="{Binding AppliedPointsTitle}" Style="{StaticResource Subheading}"/>
        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
         <Button Content="+ Add" Command="{Binding AddPoints}" ToolTip="Add load locations from model geometry"/>
         <Button Content="&#8722; Remove" Command="{Binding RemoveAppliedPoints}" CommandParameter="{Binding SelectedItems, ElementName=AppliedPointsGrid}"/>
        </WrapPanel>
        <DataGrid x:Name="AppliedPointsGrid" Grid.Row="2" ItemsSource="{Binding State.AppliedPoints}" SelectedItem="{Binding SelectedAppliedPoint, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" SelectionChanged="AppliedPoints_SelectionChanged" CanUserDeleteRows="False">
         <DataGrid.Columns>
          <DataGridTextColumn Header="#" Binding="{Binding Order}" IsReadOnly="True" Width=".4*" MinWidth="34" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="Point" Binding="{Binding PointName}" IsReadOnly="True" Width="1.2*" MinWidth="80"/>
          <DataGridTextColumn Header="X [m]" Binding="{Binding X, StringFormat=F3}" IsReadOnly="True" Width=".8*" MinWidth="62" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="Z [m]" Binding="{Binding Z, StringFormat=F3}" IsReadOnly="True" Width=".8*" MinWidth="62" ElementStyle="{StaticResource NumericCell}"/>
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1*" MinWidth="76"/>
         </DataGrid.Columns>
        </DataGrid>
       </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Surface}">
       <Grid Margin="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="LOAD DEFINITION" Style="{StaticResource Subheading}"/>
        <Grid Grid.Row="1" Margin="0,0,0,8">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Grid.Column="0" Text="Trib. width B" VerticalAlignment="Top" Margin="0,5,6,0"/>
         <c:EngineeringInput Grid.Column="1" Width="118" Label="" AutomationProperties.Name="Out-of-plane tributary width B" Value="{Binding State.TributaryWidthB}" Unit="m" Minimum="0.000000001" Margin="0"/>
         <TextBlock Grid.Column="3" Text="NStories" VerticalAlignment="Top" Margin="0,5,6,0"/>
         <c:EngineeringInput Grid.Column="4" Width="96" Label="" AutomationProperties.Name="Number of stories" Value="{Binding State.NumberOfStories}" Unit="" Minimum="1" Maximum="2147483647" Increment="1" WholeNumbersOnly="True" Margin="0"/>
         <Button Grid.Column="6" Content="View Candidates" Click="ViewCandidates_Click" VerticalAlignment="Top" Margin="6,0,0,0"/>
        </Grid>
        <DataGrid x:Name="LoadDefinitionsGrid" Grid.Row="2" ItemsSource="{Binding State.LoadDefinitions}" IsEnabled="{Binding IsIdle}" CanUserDeleteRows="False" SelectionMode="Single" FrozenColumnCount="0">
         <DataGrid.Resources>
          <Style x:Key="LoadValueEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
           <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="6,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="TextAlignment" Value="Right"/>
           <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger></Style.Triggers>
          </Style>
         </DataGrid.Resources>
         <DataGrid.Columns>
          <DataGridTextColumn Header="Load Name" Binding="{Binding LoadName, UpdateSourceTrigger=PropertyChanged}" Width="1.4*" MinWidth="84"/>
          <DataGridTemplateColumn Width="46" MinWidth="46"><DataGridTemplateColumn.Header><TextBlock Text="Incr?" ToolTip="Apply increment step"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding ApplyIncrementStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="qz [kPa]" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding IsSingleValue}" Text="{Binding Qz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Min qz" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding MinQz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Max qz" Width=".8*" MinWidth="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding MaxQz, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Header="Step" Width=".7*" MinWidth="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource LoadValueEditor}" IsEnabled="{Binding ApplyIncrementStep}" Text="{Binding IncrementStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource NullableDouble}, ValidatesOnExceptions=True, ValidatesOnDataErrors=True}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTemplateColumn Width="34" MinWidth="34"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Command="{Binding DataContext.DeleteLoadDefinition, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" ToolTip="Delete load definition" Width="24" Height="22" MinHeight="22" Padding="5" Margin="0" Background="Transparent" BorderThickness="0"><Viewbox Width="11" Height="11"><Path Stroke="{StaticResource Error}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14 M14,2 L2,14"/></Viewbox></Button></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
         </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="3" Content="+ Add Load" Command="{Binding AddLoadDefinition}" Click="AddLoad_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
       </Grid>
      </Border>
     </Grid>
    </Grid>
   </TabItem>

   <!-- 03 TRUSS HEIGHT -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="03  TRUSS HEIGHT" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
      <TextBlock Text="{Binding TrussStatus}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
     </StackPanel>
    </TabItem.Header>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid Grid.Column="0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding HeightSummary}" FontFamily="Consolas" FontSize="11" Margin="0,0,0,6"/>
      <c:Structural2DViewer Grid.Row="1" Model="{Binding State.Preview}"/>
      <TextBlock Grid.Row="2" Text="{Binding PreviewMessage}" TextWrapping="Wrap" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,6,0,0"/>
     </Grid>
     <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
      <StackPanel IsEnabled="{Binding IsIdle}" Margin="10,0,0,0">
       <TextBlock Text="POINT GROUPS" Style="{StaticResource Subheading}"/>
       <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Top" Margin="6,0,0,0"/><StackPanel><TextBlock Text="Top chord" FontWeight="SemiBold"/><TextBlock Text="{Binding TopSummary}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel>
       <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Middle" Margin="6,0,0,0"/><StackPanel><TextBlock Text="Middle" FontWeight="SemiBold"/><TextBlock Text="{Binding MiddleSummary}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel>
       <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Select" Command="{Binding SelectGroup}" CommandParameter="Bottom" Margin="6,0,0,0"/><StackPanel><TextBlock Text="Bottom chord" FontWeight="SemiBold"/><TextBlock Text="{Binding BottomSummary}" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></DockPanel>
       <TextBlock Text="{Binding GroupWarning}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" FontSize="11" Margin="0,0,0,6"/>
       <Button Content="Capture Baseline" Command="{Binding CaptureBaseline}" HorizontalAlignment="Left" Margin="0,0,0,12"/>
       <TextBlock Text="HEIGHT RANGE" Style="{StaticResource Subheading}"/>
       <c:EngineeringInput Label="Minimum height" Value="{Binding State.Truss.MinimumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Maximum height" Value="{Binding State.Truss.MaximumHeight}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Increment step" Value="{Binding State.Truss.Increment}" Unit="{Binding LengthUnit}"/>
       <c:EngineeringInput Label="Preview height" Value="{Binding State.Truss.CurrentHeight}" Unit="{Binding LengthUnit}"/>
       <Slider Minimum="{Binding State.Truss.MinimumHeight}" Maximum="{Binding State.Truss.MaximumHeight}" TickFrequency="{Binding State.Truss.Increment}" Value="{Binding State.Truss.CurrentHeight}" IsSnapToTickEnabled="True" TickPlacement="BottomRight" Margin="0,4,0,12" AutomationProperties.Name="Preview truss height"/>
       <StackPanel Orientation="Horizontal">
        <Button Content="Reset" Command="{Binding ResetPreview}"/>
        <Button Content="Apply to SAP" Command="{Binding ApplyGeometry}" Style="{StaticResource Primary}" PreviewMouseDown="ValidateEditors"/>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </TabItem>

   <!-- 04 CABLE FORCE -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="04  CABLE FORCE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
      <TextBlock Text="{Binding CableStatus}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
     </StackPanel>
    </TabItem.Header>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="+ Add" Command="{Binding AddCables}" ToolTip="Add cable / tendon force sources"/>
      <Button Content="&#8722; Remove" Command="{Binding RemoveCables}" CommandParameter="{Binding SelectedItems, ElementName=Cables}"/>
      <TextBlock Text="{Binding ForceUnit, StringFormat=Force values in [{0}] · edits stay local until validated}" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,0,0,0"/>
     </StackPanel>
     <DataGrid x:Name="Cables" Grid.Row="1" ItemsSource="{Binding State.Cables}" IsEnabled="{Binding IsIdle}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Object" Binding="{Binding ObjectName}" IsReadOnly="True" Width="1.1*" MinWidth="96"/>
       <DataGridTextColumn Header="Force source" Binding="{Binding Source}" IsReadOnly="True" Width="2*" MinWidth="150"/>
       <DataGridTextColumn Header="Current" Binding="{Binding CurrentForce, StringFormat=F4, TargetNullValue=n/a}" IsReadOnly="True" Width=".9*" MinWidth="82" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Min" Binding="{Binding MinimumForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".85*" MinWidth="78" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Max" Binding="{Binding MaximumForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".85*" MinWidth="78" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Step" Binding="{Binding Increment, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".7*" MinWidth="66" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Target" Binding="{Binding TargetForce, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True, StringFormat=F4}" Width=".85*" MinWidth="78" ElementStyle="{StaticResource NumericCell}"/>
       <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="1.4*" MinWidth="130"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="Range edits do not modify SAP2000. Use the Iteration tab to validate the configuration." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    </Grid>
   </TabItem>

   <!-- 05 ITERATION -->
   <TabItem>
    <TabItem.Header>
     <StackPanel Width="124">
      <TextBlock Text="05  ITERATION" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
      <TextBlock Text="Next phase" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
     </StackPanel>
    </TabItem.Header>
    <Grid>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
      <ScrollViewer><TextBlock Text="{Binding IterationSummary}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" LineHeight="20" Margin="0,0,16,0"/></ScrollViewer>
      <DataGrid Grid.Column="1" ItemsSource="{Binding Issues}" IsReadOnly="True" CanUserDeleteRows="False">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="120"/>
        <DataGridTextColumn Header="Review required" Binding="{Binding Message}" Width="*">
         <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="ToolTip" Value="{Binding Message}"/></Style></DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>
     </Grid>
     <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
      <Button Content="Validate" Command="{Binding Validate}" Style="{StaticResource Primary}" PreviewMouseDown="ValidateEditors"/>
      <Button Content="Run &#8212; next phase" IsEnabled="False"/>
     </StackPanel>
    </Grid>
   </TabItem>

  </TabControl>
 </DockPanel>
</Window>
