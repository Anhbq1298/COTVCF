<UserControl x:Class="COT_VCF.Presentation.Controls.EngineeringInput" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="220" HorizontalAlignment="Left">
 <StackPanel Margin="0,0,0,8"><TextBlock Text="{Binding Label, ElementName=Root}" Margin="0,0,0,4"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBox x:Name="Editor" Height="27" MinHeight="27" Padding="8,2" FontFamily="Consolas" TextAlignment="Right" AutomationProperties.Name="{Binding Label, ElementName=Root}"/><TextBlock Grid.Column="1" Text="{Binding Unit, ElementName=Root}" Margin="8,0,0,0"/></Grid>
  <TextBlock Foreground="{StaticResource Error}" FontSize="11" TextWrapping="Wrap" Text="{Binding ElementName=Editor, Path=(Validation.Errors)[0].ErrorContent}"/>
 </StackPanel>
</UserControl>
