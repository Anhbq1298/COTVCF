<Window x:Class="COT_VCF.Presentation.OptimizationResultsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:COT_VCF.Presentation"
        Title="Optimization VCF Results" Icon="{x:Static p:AppIcon.Window}" Width="1320" Height="700" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Run → Optimization VCF → Run Optimization: every analysed case with the values of the varying inputs and its largest
      downward deflection (over every solved load case / combination). Sort by any column; the least deflection is named below. -->
 <DockPanel Margin="10">
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <Button x:Name="CancelRunButton" DockPanel.Dock="Right" Content="Cancel Run" MinWidth="96" Margin="8,0,0,0" Click="CancelRun_Click"
           IsEnabled="{Binding IsVcfOptimizationRunning}"/>
   <ProgressBar DockPanel.Dock="Right" Width="180" Height="10" Value="{Binding VcfOptimizationPercent, Mode=OneWay}" Margin="8,0,0,0" VerticalAlignment="Center"/>
   <TextBlock Text="{Binding VcfOptimizationProgress}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
  </DockPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding VcfOptimizationBest}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>
  <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
             Text="Max defl. and Uplift = largest downward and largest upward displacement of a bottom chord point (BTrPt…) in the result chosen under Deflection Check (Result column); Limit = span between the mega columns / ratio; Check OK when δ ≤ limit and uplift ≤ its limit. Total cost = Σ member cost per metre × length (gross area × material unit cost, as on Define → Materials; composite sections from their concrete, steel and reinforcement). Run → Analysis Options and Define → Load Cases apply. Each case is built in memory; the working model and SAP2000 are not changed."/>
  <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding VcfOptimizationRows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
            HeadersVisibility="Column" SelectionMode="Single" AutomationProperties.Name="Optimization results"/>
 </DockPanel>
</Window>
