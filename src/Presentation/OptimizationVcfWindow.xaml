<Window x:Class="COT_VCF.Presentation.OptimizationVcfWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:COT_VCF.Presentation" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls"
        Title="Optimization VCF" Icon="{x:Static p:AppIcon.Window}" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Run → Optimization VCF: the inputs of Edit → VCF Geometry as a search space — min / max / step per geometry parameter,
      the cable pretensions (one shared step, the fan cables by their length) and candidate sections per member role and
      cable — with a preview at the minimum, current or maximum corner (fewer / more fan cables when the bays change).
      OK keeps the settings; Run Optimization keeps them and analyses every combination. -->
 <Window.Resources>
  <Style x:Key="FormButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="84"/><Setter Property="Margin" Value="6,0"/></Style>
  <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Margin" Value="0,0,4,2"/></Style>
 </Window.Resources>
 <DockPanel Margin="10">
  <!-- form actions -->
  <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
   <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Reset Form to Current Model" MinWidth="220" Click="Reset_Click"/>
   <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Style="{StaticResource FormButton}" IsCancel="True"/>
   <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Style="{StaticResource FormButton}" IsDefault="True" Click="Ok_Click"/>
   <Button x:Name="RunButton" DockPanel.Dock="Right" Content="Run Optimization" Style="{StaticResource FormButton}" MinWidth="130" Click="Run_Click"
           ToolTipService.ShowOnDisabled="True" ToolTip="Analyse every combination with the internal FEM and list the max deflection of each case (the working model is not changed)"/>
  </DockPanel>

  <!-- deflection check: the result the deflection is read from, the limit span / ratio and the uplift limit of the span -->
  <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="8,6" Background="{StaticResource Raised}" BorderBrush="{StaticResource Border}" BorderThickness="1">
   <StackPanel Orientation="Horizontal">
    <TextBlock Text="DEFLECTION CHECK" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <TextBlock Text="max δ in" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <ComboBox x:Name="DeflectionResultCombo" Width="280" SelectionChanged="DeflectionCheck_Changed" AutomationProperties.Name="Deflection result"
              ToolTip="The load case / combination the deflection is read from (those set to run on Define → Load Cases / Load Combinations)"/>
    <TextBlock Text="≤ span /" VerticalAlignment="Center" Margin="10,0,6,0"/>
    <TextBox x:Name="SpanRatioBox" Width="60" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" TextChanged="DeflectionCheck_Changed"
             AutomationProperties.Name="Span ratio" ToolTip="Deflection limit = span between the mega columns (bays × bay width) / this ratio"/>
    <TextBlock Text="uplift ≤" VerticalAlignment="Center" Margin="14,0,6,0"/>
    <TextBox x:Name="UpliftLimitBox" Width="48" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" TextChanged="DeflectionCheck_Changed"
             AutomationProperties.Name="Uplift limit mm"
             ToolTip="Largest upward displacement a truss chord point (top / middle / bottom chord) may have in that result. 0 allows none: a pretension that lifts the span above its unloaded position fails."/>
    <TextBlock Text="mm" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource Muted}"/>
    <TextBlock x:Name="LimitText" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}"/>
   </StackPanel>
  </Border>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="500"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <TabControl x:Name="ParameterTabs" Background="{StaticResource Surface}" AutomationProperties.Name="Optimization VCF sheets">
    <TabControl.Resources>
     <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Height" Value="26"/><Setter Property="Width" Value="NaN"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="12,0"/></Style>
    </TabControl.Resources>
    <TabItem Header="Geometry">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
      <StackPanel>
       <Grid x:Name="GeometryGrid">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/><ColumnDefinition Width="64"/>
         <ColumnDefinition Width="22"/><ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
       </Grid>
       <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                  Text="Values run from Min in steps of Step up to Max (as on 01 Loading and 03 Pretension, an off-step Max is not added). Min = Max keeps the parameter fixed. The middle chord is not a variable: it stays at 0.5 × truss depth. Combinations that fail the geometry rules are skipped by the run."/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Cable Force">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
      <StackPanel>
       <!-- one shared step for every cable: at step j of n a cable is at Min + (Max − Min) × j / (n − 1) -->
       <DockPanel Margin="0,0,0,8" LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" Text="Pretension [kN] · all cables step together (starts from 03 Pretension)" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        <TextBox x:Name="CableStepsBox" DockPanel.Dock="Right" Width="48" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" TextChanged="CableForce_Changed"
                 AutomationProperties.Name="Cable force steps" ToolTip="Number of force steps, shared by every cable: step 1 is each cable's Min, the last step its Max"/>
        <TextBlock DockPanel.Dock="Right" Text="Steps" VerticalAlignment="Center" Margin="0,0,6,0"/>
       </DockPanel>

       <StackPanel x:Name="FanForcePanel">
        <TextBlock Text="FAN CABLES · TOP CORNER → BOTTOM CHORD" Style="{StaticResource Subheading}"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
         <TextBlock Text="Force by length" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <ComboBox x:Name="FanGradingCombo" Width="110" SelectionChanged="CableForce_Changed" AutomationProperties.Name="Fan cable force by length"
                   ToolTip="How a fan cable gets its force from its length — a longer cable takes more. Manual keeps a range per cable.">
          <ComboBoxItem Content="+ kN per m" ToolTip="T = T shortest + increase × (L − L shortest): every fan cable steps by the same force"/>
          <ComboBoxItem Content="× length" ToolTip="T = T shortest × L / L shortest"/>
          <ComboBoxItem Content="Manual" ToolTip="A range per fan cable; a cable added by more bays takes the force of the cable it copies × its length ratio"/>
         </ComboBox>
         <TextBox x:Name="FanGradientBox" Width="60" Margin="6,0,0,0" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" TextChanged="CableForce_Changed"
                  AutomationProperties.Name="Fan cable force increase per metre" ToolTip="Force added per metre a fan cable is longer than the shortest one"/>
         <TextBlock x:Name="FanGradientUnit" Text="kN per m" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <Grid x:Name="FanForceGrid">
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="62"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/><ColumnDefinition Width="56"/>
         </Grid.ColumnDefinitions>
        </Grid>
        <TextBlock x:Name="FanForceNote" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
        <TextBlock Text="OTHER CABLES" Style="{StaticResource Subheading}" Margin="0,10,0,6"/>
       </StackPanel>
       <Grid x:Name="CableForceGrid">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/><ColumnDefinition Width="46"/><ColumnDefinition Width="62"/><ColumnDefinition Width="74"/><ColumnDefinition Width="74"/><ColumnDefinition Width="56"/>
        </Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="CableForceNote" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Storey Force">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
      <StackPanel>
       <TextBlock x:Name="StoreyForceCaption" Text="Force per loaded point: Fz = −qz × trib. length × B × NStories (starts from 01 Loading)" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
       <Grid x:Name="StoreyForceGrid">
        <Grid.ColumnDefinitions>
         <ColumnDefinition Width="*"/><ColumnDefinition Width="84"/><ColumnDefinition Width="84"/><ColumnDefinition Width="70"/>
         <ColumnDefinition Width="30"/><ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="StoreyForceSummary" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
       <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                  Text="qz is per load definition and acts downward (≥ 0). The tributary length of each point follows the geometry of the combination."/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Sections">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
      <StackPanel>
       <TextBlock Text="FRAME SECTIONS · CANDIDATES" Style="{StaticResource Subheading}"/>
       <Grid x:Name="FrameGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock Text="CABLE SECTIONS · CANDIDATES" Style="{StaticResource Subheading}" Margin="0,10,0,6"/>
       <Grid x:Name="CableGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="SectionHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                  Text="Tick the sections to try per role or cable; none ticked keeps the section assigned in the model."/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>

   <!-- preview of one corner of the search space -->
   <DockPanel Grid.Column="2">
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Foreground="{StaticResource Error}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock x:Name="SpaceSummary" DockPanel.Dock="Bottom" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
     <!-- Minimum / Current / Maximum corner; named after the cables when the number of bays changes the fan (code-behind) -->
     <ComboBox x:Name="PreviewCorner" DockPanel.Dock="Right" Width="170" SelectionChanged="PreviewCorner_Changed" AutomationProperties.Name="Preview at"
               ToolTip="The corner of the ranges shown: the fewest bays (fewer fan cables), the model, or the most bays (more fan cables)"/>
     <TextBlock DockPanel.Dock="Right" Text="Preview at" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <TextBlock Text="PREVIEW · one corner of the ranges; the working model is not changed" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <TextBlock x:Name="PreviewCaption" DockPanel.Dock="Top" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
     <c:Structural2DViewer x:Name="Preview" ShowPointLabels="False" ShowDimensions="True" AutomationProperties.Name="Optimization VCF preview"/>
    </Border>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
