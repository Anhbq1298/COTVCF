<Window x:Class="COT_VCF.Presentation.VcfGeometryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:COT_VCF.Presentation" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls"
        Title="VCF Geometry" Icon="{x:Static p:AppIcon.Window}" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Edit → VCF Geometry: the system's parameters (as annotated: chords, vertical chord, mega column, cables, truss depth,
      clear height, spans) with a live preview. Apply / OK writes them to the working model; Close discards. -->
 <Window.Resources>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="0,0,0,10"/>
   <Setter Property="Padding" Value="8,6,8,6"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="Background" Value="{StaticResource Raised}"/>
  </Style>
  <Style x:Key="FormButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="84"/><Setter Property="Margin" Value="6,0"/></Style>
 </Window.Resources>
 <DockPanel Margin="10">
  <!-- form actions -->
  <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
   <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Reset Form to Current Model" MinWidth="220" Click="Reset_Click"/>
   <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply" Style="{StaticResource FormButton}" Click="Apply_Click"/>
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Style="{StaticResource FormButton}" IsCancel="True" Click="Close_Click"/>
   <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Style="{StaticResource FormButton}" IsDefault="True" Click="Ok_Click"/>
  </DockPanel>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- parameters -->
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <GroupBox Header="Geometry">
      <StackPanel>
       <Grid x:Name="GeometryGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="GeometrySummary" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </GroupBox>
     <GroupBox Header="Sections">
      <StackPanel>
       <TextBlock Text="FRAME SECTIONS" Style="{StaticResource Subheading}"/>
       <Grid x:Name="FrameGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock Text="CABLE SECTIONS" Style="{StaticResource Subheading}" Margin="0,10,0,6"/>
       <Grid x:Name="CableGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="SectionHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                  Text="Sections are the ones assigned in the model; a member keeps its own local axis and end releases."/>
      </StackPanel>
     </GroupBox>
    </StackPanel>
   </ScrollViewer>

   <!-- live preview -->
   <DockPanel Grid.Column="2">
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Foreground="{StaticResource Error}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock DockPanel.Dock="Top" Text="PREVIEW · updates as you edit; the working model changes on Apply / OK" Style="{StaticResource Subheading}"/>
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
     <c:Structural2DViewer x:Name="Preview" ShowPointLabels="False" ShowDimensions="True" AutomationProperties.Name="VCF geometry preview"/>
    </Border>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
