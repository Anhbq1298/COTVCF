<Window x:Class="COT_VCF.Presentation.VcfGeometryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:COT_VCF.Presentation" xmlns:c="clr-namespace:COT_VCF.Presentation.Controls"
        Title="VCF System" Icon="{x:Static p:AppIcon.Window}" Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Surface}">
 <!-- Edit → VCF Geometry: the system's parameters (as annotated: chords, vertical chord, mega column, cables, truss depth,
      clear height, spans) with a live preview. Apply / OK writes them to the working model; Close discards. -->
 <Window.Resources>
  <Style TargetType="GroupBox">
   <Setter Property="Margin" Value="0,0,0,10"/>
   <Setter Property="Padding" Value="8,6,8,6"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="Background" Value="{StaticResource Raised}"/>
  </Style>
  <Style x:Key="FormButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="84"/><Setter Property="Margin" Value="6,0"/></Style>
 </Window.Resources>
 <DockPanel Margin="10">
  <!-- form actions -->
  <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
   <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Reset Form to Current Model" MinWidth="220" Click="Reset_Click"/>
   <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply" Style="{StaticResource FormButton}" Click="Apply_Click"/>
   <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Style="{StaticResource FormButton}" IsCancel="True" Click="Close_Click"/>
   <Button x:Name="OkButton" DockPanel.Dock="Right" Content="OK" Style="{StaticResource FormButton}" IsDefault="True" Click="Ok_Click"/>
  </DockPanel>

  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SheetsColumn" Width="440" MinWidth="340"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>

   <!-- parameters: one sheet per subject, like the sheets of a workbook -->
   <TabControl x:Name="ParameterTabs" Background="{StaticResource Surface}" AutomationProperties.Name="VCF system sheets">
    <TabControl.Resources>
     <!-- sized to their text (the theme's tabs are a fixed 152 px) so the four sheets sit on one line -->
     <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}"><Setter Property="Height" Value="26"/><Setter Property="Width" Value="NaN"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="12,0"/></Style>
    </TabControl.Resources>
    <TabItem Header="Geometry">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
      <StackPanel>
       <Grid x:Name="GeometryGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="96"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="GeometrySummary" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Cable Force">
     <Border Padding="8">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="Target force per cable — the pretension the analysis meets in the Pretension load case. One value per cable (a range belongs to Run → Optimization VCF); a cable that follows another keeps its sync rule. Apply / OK writes it to the model."
                  Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
       <TextBlock DockPanel.Dock="Bottom" x:Name="CableForceSummary" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <DataGrid x:Name="CableForceGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                 AutomationProperties.Name="Cable force" SelectionMode="Single">
        <DataGrid.Columns>
         <DataGridTextColumn Header="Cable" Binding="{Binding Cable}" IsReadOnly="True" Width="Auto" MinWidth="80"/>
         <DataGridTextColumn Header="Pattern" Binding="{Binding Pattern}" IsReadOnly="True" Width="Auto"/>
         <DataGridTextColumn Header="Sync" Binding="{Binding Sync}" IsReadOnly="True" Width="Auto"/>
         <DataGridTemplateColumn Header="Pretension [kN]" Width="*" MinWidth="110">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <TextBox Text="{Binding Force, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" IsEnabled="{Binding Editable}"
                     MinHeight="0" Padding="6,0" BorderThickness="0" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" VerticalContentAlignment="Center"
                     ToolTip="{Binding Hint}" ToolTipService.ShowOnDisabled="True">
             <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
               <Setter Property="Background" Value="Transparent"/>
               <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{StaticResource Surface}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
               </Style.Triggers>
              </Style>
             </TextBox.Style>
            </TextBox>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </Border>
    </TabItem>
    <TabItem Header="Storey Force">
     <Border Padding="8">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" x:Name="StoreyForceCaption" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
       <!-- the loads of the model: one value each (a range belongs to Run → Optimization VCF) -->
       <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
        <TextBlock Text="Trib. width B" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox x:Name="StoreyWidthBox" Width="66" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" TextChanged="StoreyInput_Changed"
                 AutomationProperties.Name="Tributary width B" ToolTip="Out-of-plane tributary width B [m]"/>
        <TextBlock Text="m" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,12,0"/>
        <TextBlock Text="NStories" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <TextBox x:Name="StoreyCountBox" Width="46" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" TextChanged="StoreyInput_Changed"
                 AutomationProperties.Name="Number of storeys" ToolTip="Number of storeys carried (whole number, at least 1)"/>
        <Button x:Name="StoreyPointsButton" Content="Loaded Points…" Click="StoreyPoints_Click" Margin="12,0,0,0" ToolTipService.ShowOnDisabled="True"
                AutomationProperties.Name="Loaded points" ToolTip="Choose the points the storey loads act on"/>
       </WrapPanel>
       <DataGrid DockPanel.Dock="Top" x:Name="StoreyLoadGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                 MaxHeight="150" SelectionMode="Single" AutomationProperties.Name="Storey loads">
        <DataGrid.Columns>
         <DataGridTemplateColumn Header="Load Pattern" Width="*" MinWidth="120">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <ComboBox ItemsSource="{Binding DataContext.State.LoadPatterns, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                      SelectedItem="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Padding="5,0" Background="Transparent"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Header="qz [kPa]" Width="90">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <TextBox Text="{Binding Qz, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" MinHeight="0" Padding="6,0" BorderThickness="0"
                     Background="Transparent" FontFamily="{StaticResource MonoFont}" TextAlignment="Right" VerticalContentAlignment="Center" ToolTip="{Binding Hint}"/>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
         <DataGridTemplateColumn Width="34" MinWidth="34">
          <DataGridTemplateColumn.CellTemplate>
           <DataTemplate>
            <Button Click="RemoveStoreyLoad_Click" ToolTip="Remove this load" Width="24" Height="22" MinHeight="22" Padding="5" Margin="0" Background="Transparent" BorderThickness="0">
             <Viewbox Width="11" Height="11"><Path Stroke="{StaticResource Error}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14 M14,2 L2,14"/></Viewbox>
            </Button>
           </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
         </DataGridTemplateColumn>
        </DataGrid.Columns>
       </DataGrid>
       <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,4,0,6">
        <Button x:Name="AddStoreyLoadButton" DockPanel.Dock="Left" Content="+ Add Load" Click="AddStoreyLoad_Click" Margin="0" AutomationProperties.Name="Add storey load"/>
       </DockPanel>
       <TextBlock DockPanel.Dock="Bottom" x:Name="StoreyForceSummary" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
       <DataGrid x:Name="StoreyForceGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                 AutomationProperties.Name="Storey force" SelectionMode="Single"/>
      </DockPanel>
     </Border>
    </TabItem>
    <TabItem Header="Sections">
     <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
      <StackPanel>
       <TextBlock Text="FRAME SECTIONS" Style="{StaticResource Subheading}"/>
       <Grid x:Name="FrameGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock Text="CABLE SECTIONS" Style="{StaticResource Subheading}" Margin="0,10,0,6"/>
       <Grid x:Name="CableGrid">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       </Grid>
       <TextBlock x:Name="SectionHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                  Text="Sections are the ones assigned in the model; a member keeps its own local axis and end releases."/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>

   <!-- drag to widen or narrow the sheets -->
   <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                 Background="{StaticResource Border}" Cursor="SizeWE" ToolTip="Drag to resize" AutomationProperties.Name="Resize sheets"/>

   <!-- live preview -->
   <DockPanel Grid.Column="2">
    <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Foreground="{StaticResource Error}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
    <TextBlock DockPanel.Dock="Top" Text="PREVIEW · updates as you edit; the working model changes on Apply / OK" Style="{StaticResource Subheading}"/>
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
     <c:Structural2DViewer x:Name="Preview" ShowPointLabels="False" ShowDimensions="True" AutomationProperties.Name="VCF system preview"/>
    </Border>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
