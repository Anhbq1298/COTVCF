<Project Sdk="Microsoft.NET.Sdk">

  <!-- The native model of Mcotis: identities, names, objects, definitions, assignments, loads and their invariants.
       No WPF, no database and no SAP2000/CSI reference may ever be added here (Mcotis.Checks verifies it). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
