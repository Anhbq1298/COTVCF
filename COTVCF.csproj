<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Platform Configuration -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <SapInstallDir Condition="'$(SapInstallDir)' == ''">C:\Program Files\Computers and Structures\SAP2000 26</SapInstallDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    
    <!-- Code Features -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- Build Output Configuration -->
    
    <!-- Assembly Info -->
    <!-- AssemblyName stays "COT VCF tools": it is the .exe/.dll file name and the
         pack:// assembly token used by the test host and skill docs. The product
         name shown to users is set below and in the UI. -->
    <AssemblyName>COT VCF tools</AssemblyName>
    <RootNamespace>COT_VCF</RootNamespace>
    <Title>COT VCF Parametric Automation</Title>
    <Product>COT VCF Parametric Automation</Product>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <!-- The app's own logo (the truss glyph of Theme.xaml "AppLogo") for the exe, the taskbar and shortcuts. -->
    <ApplicationIcon>src\Presentation\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Debug Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- Release Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="CSiAPIv1"><HintPath>$(SapInstallDir)\CSiAPIv1.dll</HintPath><Private>true</Private></Reference>
    <Compile Remove="tests\**; .work\**" />
    <Page Remove="tests\**; .work\**" />
    <None Remove=".work\**" />
    <InternalsVisibleTo Include="COT_VCF.Checks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tab 06 only: derive consolidated .xlsx and HTML reports from the study's raw JSON package. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>
</Project>
