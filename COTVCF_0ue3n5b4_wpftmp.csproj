<Project>
  <PropertyGroup>
    <AssemblyName>Mcotis</AssemblyName>
    <IntermediateOutputPath>obj\Debug\</IntermediateOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>C:\Users\Mark\source\repos\Anhbq1298\COTVCF\obj\</MSBuildProjectExtensionsPath>
    <_TargetAssemblyProjectName>COTVCF</_TargetAssemblyProjectName>
    <RootNamespace>COT_VCF</RootNamespace>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <!-- Platform Configuration -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <SapInstallDir Condition="'$(SapInstallDir)' == '' and '$(Configuration)' == 'FreshBuild' and Exists('C:\Program Files\Computers and Structures\SAP2000 27\CSiAPIv1.dll')">C:\Program Files\Computers and Structures\SAP2000 27</SapInstallDir>
    <SapInstallDir Condition="'$(SapInstallDir)' == ''">C:\Program Files\Computers and Structures\SAP2000 26</SapInstallDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Code Features -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Build Output Configuration -->
    <!-- Assembly Info -->
    <!-- Brand: Mcotis (Meinhardt Cities of Tomorrow Integrated Structures). AssemblyName is the .exe/.dll file name and the
         pack:// assembly token used by the theme, the icon and the test host. -->
    <RootNamespace>COT_VCF</RootNamespace>
    <Title>Mcotis — Meinhardt Cities of Tomorrow Integrated Structures</Title>
    <Product>Mcotis</Product>
    <Description>Mcotis — Meinhardt Cities of Tomorrow Integrated Structures</Description>
    <Company>Meinhardt</Company>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <!-- The app's own logo (the truss glyph of Theme.xaml "AppLogo") for the exe, the taskbar and shortcuts. -->
    <ApplicationIcon>src\Presentation\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Debug Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <!-- Release Configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <!-- FreshBuild replaces bin with a complete app at its root. -->
  <PropertyGroup Condition="'$(Configuration)' == 'FreshBuild'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <Target Name="ClearFreshBuildOutput" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'FreshBuild' and '$(DesignTimeBuild)' != 'true'">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\bin" />
  </Target>
  <ItemGroup>
    <Compile Remove="tests\**; .work\**" />
    <None Remove=".work\**" />
    <InternalsVisibleTo Include="COT_VCF.Checks" />
  </ItemGroup>
  <ItemGroup>
    <!-- The default FEM model (07 FEM → Save Model of COT Framing_V1.2_100m): loaded at startup so FEM runs without SAP2000. -->
    <!-- The software logo: window icons (Theme.xaml AppLogo); AppIcon.ico is made from the same picture. -->
    <EmbeddedResource Include="src\Resources\DefaultFemModel.cotfem.json" LogicalName="COTVCF.DefaultFemModel.cotfem.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tab 06 only: derive consolidated .xlsx and HTML reports from the study's raw JSON package. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <!-- Portable FEM input/working/output databases. The app checkpoints to a single file before atomic Save. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.12" />
  </ItemGroup>
